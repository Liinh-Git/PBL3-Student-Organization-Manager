@OrgBackend_HostAddress = http://localhost:5058
@access_token = REPLACE_WITH_ACCESS_TOKEN

### Register
POST {{OrgBackend_HostAddress}}/api/auth/register
Content-Type: application/json

{
	"fullName": "Test User",
	"email": "test.user@example.com",
	"password": "P@ssword123"
}

### Login
POST {{OrgBackend_HostAddress}}/api/auth/login
Content-Type: application/json

{
	"email": "test.user@example.com",
	"password": "P@ssword123"
}

### Me (paste token from login response)
GET {{OrgBackend_HostAddress}}/api/auth/me
Authorization: Bearer {{access_token}}
Accept: application/json

###
