@inject NavigationManager Navigation
@inject IOrganizationRouteAccessGate OrganizationRouteAccessGate
@inject Org.Frontend.Services.Dashboard.IUserDashboardService DashboardService
@implements IDisposable

<div class="nav-scrollable">
    <div class="workspace-sidebar">
        <aside class="workspace-rail">
            <div class="rail-top">
                <button class="rail-icon user-icon @(IsUserWorkspaceActive ? "active" : string.Empty)"
                        type="button"
                        title="Workspace nguoi dung"
                        @onclick="ActivateUserWorkspace">
                    <img src="/images/mockimages/AvtUser/Avt1.jpg" alt="Workspace nguoi dung" />
                </button>
            </div>

            <div class="rail-separator"></div>

            <div class="rail-org-list">
                @if (_joinedOrganizations != null)
                {
                    @foreach (var org in _joinedOrganizations)
                    {
                        <button class="rail-icon org-icon @(IsOrganizationWorkspaceActive(org.OrganizationId.ToString()) ? "active" : string.Empty)"
                                type="button"
                                title="@org.Name"
                                @onclick="@(() => ActivateOrganizationWorkspace(org))">
                            <img src="@org.AvatarUrl" alt="@org.Name" />
                        </button>
                    }
                }
            </div>
        </aside>


        <section class="workspace-menu-pane">
            <header class="workspace-head">
                <h1>@ActiveWorkspaceHeading</h1>
            </header>

            <div class="workspace-nav-margin">
                <nav class="workspace-menu-list">
                    @foreach (var item in ActiveMenuItems)
                    {
                        <button type="button"
                                class="workspace-menu-item @(IsMenuItemActive(item.Key) ? "active" : string.Empty)"
                                @onclick="@(() => NavigateToMenu(item))">
                            <span class="menu-icon-box">
                                <MudIcon Icon="@item.Icon" Class="workspace-menu-icon" />
                            </span>
                            <span class="menu-label">@item.Label</span>
                        </button>
                    }
                </nav>
            </div>

            @if (_activeWorkspace == WorkspaceKind.Organization)
            {
                <div class="workspace-footer-card">
                    <div class="workspace-footer-card-inner">
                        <div class="workspace-footer-badge">@ActiveOrganizationShortName</div>
                        <div class="workspace-footer-meta">
                            <p>@ActiveWorkspaceTitle</p>
                            <span>Organization Workspace</span>
                        </div>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private enum WorkspaceKind
    {
        User,
        Organization
    }

    private sealed record WorkspaceMenuItem(string Key, string Label, string Href, string Icon);

    private static readonly IReadOnlyList<WorkspaceMenuItem> UserWorkspaceMenu =
    [
        new("user-dashboard", "Tổng quan", "/home", Icons.Material.Filled.SpaceDashboard),
        new("user-organizations", "Tổ chức của tôi", "/user/organizations", Icons.Material.Filled.Groups),
        new("user-events", "Sự kiện của tôi", "/user/events", Icons.Material.Filled.Event),
        new("user-settings", "Cài đặt", "/user/settings", Icons.Material.Filled.Settings)
    ];

    private static readonly IReadOnlyList<WorkspaceMenuItem> OrganizationWorkspaceMenu =
    [
        new("org-overview", "Tổng quan", "/org-overview", Icons.Material.Filled.SpaceDashboard),
        new("org-members", "Thành viên", "/org/members", Icons.Material.Filled.Group),
        new("org-departments", "Phòng ban", "/org/departments", Icons.Material.Filled.Apartment),
        new("org-events", "Sự kiện", "/org/events", Icons.Material.Filled.EventNote),
        new("org-resources", "Tài nguyên", "/org/resources", Icons.Material.Filled.Inventory2),
        new("org-finance", "Tài chính", "/org/finance", Icons.Material.Filled.AccountBalanceWallet),
        new("org-requests", "Yêu cầu", "/org/requests", Icons.Material.Filled.NotificationsActive),
        new("org-reports", "Báo cáo", "/org/reports", Icons.Material.Filled.QueryStats),
    ];

    private WorkspaceKind _activeWorkspace = WorkspaceKind.User;
    private Guid? _activeOrganizationId;
    private string _activeUserMenuKey = "user-dashboard";
    private string _activeOrganizationMenuKey = "org-overview";
    private IReadOnlyList<UserOrganizationViewModel>? _joinedOrganizations;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;

        var currentRoute = GetCurrentRoute(Navigation.Uri);
        SyncWorkspaceAndMenuWithRoute(currentRoute);
        
        await LoadJoinedOrganizationsAsync();
    }

    private async Task LoadJoinedOrganizationsAsync()
    {
        try 
        {
            var dashboard = await DashboardService.GetDashboardAsync();
            _joinedOrganizations = dashboard.Organizations;
            StateHasChanged();
        }
        catch 
        {
            _joinedOrganizations = [];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await OrganizationRouteAccessGate.SyncFromUriAsync(Navigation.Uri);
        var currentRoute = GetCurrentRoute(Navigation.Uri);
        SyncWorkspaceAndMenuWithRoute(currentRoute);
        await InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<WorkspaceMenuItem> ActiveMenuItems =>
        _activeWorkspace == WorkspaceKind.User ? UserWorkspaceMenu : OrganizationWorkspaceMenu;

    private bool IsUserWorkspaceActive => _activeWorkspace == WorkspaceKind.User;

    private string ActiveWorkspaceHeading =>
        _activeWorkspace == WorkspaceKind.User
            ? "WORKSPACE CÁ NHÂN"
            : ActiveWorkspaceTitle.ToUpperInvariant();

    private string ActiveWorkspaceTitle
    {
        get
        {
            if (_activeWorkspace == WorkspaceKind.User || _activeOrganizationId == null)
            {
                return "Không gian cá nhân";
            }

            var org = _joinedOrganizations?.FirstOrDefault(x => x.OrganizationId == _activeOrganizationId);
            return org?.Name ?? "Tổ chức";
        }
    }

    private string ActiveOrganizationShortName 
    {
        get 
        {
            if (_activeOrganizationId == null || _joinedOrganizations == null) return "ORG";
            var org = _joinedOrganizations.FirstOrDefault(x => x.OrganizationId == _activeOrganizationId);
            if (org == null) return "ORG";
            
            var words = org.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (words.Length >= 2) return (words[0][0].ToString() + words[1][0].ToString()).ToUpper();
            return org.Name[..Math.Min(2, org.Name.Length)].ToUpper();
        }
    }

    private bool IsOrganizationWorkspaceActive(string key) =>
        _activeWorkspace == WorkspaceKind.Organization && _activeOrganizationId?.ToString() == key;

    private bool IsMenuItemActive(string key) =>
        _activeWorkspace == WorkspaceKind.User
            ? _activeUserMenuKey == key
            : _activeOrganizationMenuKey == key;

    private void ActivateUserWorkspace()
    {
        _activeWorkspace = WorkspaceKind.User;
        _activeUserMenuKey = "user-dashboard";
        Navigation.NavigateTo("/home");
    }

    private void ActivateOrganizationWorkspace(UserOrganizationViewModel org)
    {
        _activeWorkspace = WorkspaceKind.Organization;
        _activeOrganizationId = org.OrganizationId;
        _activeOrganizationMenuKey = "org-overview";
        
        // Navigation tới overview của org đó
        Navigation.NavigateTo($"/org-overview?orgId={org.OrganizationId}");
    }

    private void NavigateToMenu(WorkspaceMenuItem item)
    {
        if (_activeWorkspace == WorkspaceKind.Organization
            && OrganizationRouteAccessGate.HasRestrictedPublicOrganization
            && item.Href.StartsWith("/org/", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(OrganizationRouteAccessGate.BuildRestrictedOverviewRoute());
            return;
        }

        string targetHref = item.Href;
        if (_activeWorkspace == WorkspaceKind.Organization && _activeOrganizationId.HasValue)
        {
            if (targetHref.StartsWith("/org"))
            {
                var sep = targetHref.Contains('?') ? "&" : "?";
                targetHref += $"{sep}orgId={_activeOrganizationId}";
            }
        }

        if (_activeWorkspace == WorkspaceKind.User) _activeUserMenuKey = item.Key;
        else _activeOrganizationMenuKey = item.Key;

        Navigation.NavigateTo(targetHref);
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await OrganizationRouteAccessGate.SyncFromUriAsync(e.Location);
            var route = GetCurrentRoute(e.Location);
            SyncWorkspaceAndMenuWithRoute(route);
            StateHasChanged();
        });
    }

    private string GetCurrentRoute(string uri)
    {
        var route = "/" + Navigation.ToBaseRelativePath(uri).Trim('/');
        if (string.IsNullOrWhiteSpace(route)) return "/";

        var queryIndex = route.IndexOf('?');
        if (queryIndex >= 0) route = route[..queryIndex];

        var hashIndex = route.IndexOf('#');
        if (hashIndex >= 0) route = route[..hashIndex];

        return string.IsNullOrWhiteSpace(route) ? "/" : route;
    }

    private void SyncWorkspaceAndMenuWithRoute(string route)
    {
        _activeWorkspace = OrganizationRouteAccessGate.ShouldUseOrganizationWorkspace(route)
            ? WorkspaceKind.Organization
            : WorkspaceKind.User;

        if (_activeWorkspace == WorkspaceKind.Organization) 
        {
            // Try to extract orgId from URI if possible to highlight the right rail icon
            if (Uri.TryCreate(Navigation.Uri, UriKind.Absolute, out var uri))
            {
                var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
                if (query.TryGetValue("orgId", out var rawId) && Guid.TryParse(rawId, out var parsedId))
                {
                    _activeOrganizationId = parsedId;
                }
            }
        }

        SyncActiveMenuWithRoute(route);
    }

    private void SyncActiveMenuWithRoute(string route)
    {
        if (string.IsNullOrWhiteSpace(route) || route == "/") return;

        var normalized = route.ToLowerInvariant();
        var userMatch = UserWorkspaceMenu.FirstOrDefault(item =>
            normalized.StartsWith(item.Href.ToLowerInvariant(), StringComparison.Ordinal));

        if (userMatch is not null) _activeUserMenuKey = userMatch.Key;

        var organizationMatch = OrganizationWorkspaceMenu.FirstOrDefault(item =>
            normalized.StartsWith(item.Href.ToLowerInvariant(), StringComparison.Ordinal));

        if (organizationMatch is not null) _activeOrganizationMenuKey = organizationMatch.Key;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}


