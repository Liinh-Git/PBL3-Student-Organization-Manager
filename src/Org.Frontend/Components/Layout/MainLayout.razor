@* ---- Layout chính của app: sidebar trái (NavMenu) + main area phải ---- *@
@inherits LayoutComponentBase
@inject FrontendAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IOrganizationRouteAccessGate OrganizationRouteAccessGate
@inject Org.Frontend.Services.Dashboard.IUserDashboardService DashboardService
@inject Org.Frontend.Services.Notifications.INotificationService NotificationService
@implements IDisposable
@using System.Security.Claims
@using Org.Frontend.Components.Notifications

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="@(_isOrganizationWorkspace ? "org-main" : "user-main")">
        @if (_isOrganizationWorkspace)
        {
            <header class="org-top-row">
                <div class="org-top-left">
                    <h1 class="org-workspace-title">@_activeOrganizationName</h1>
                </div>

                <div class="org-top-right">
                    <div class="org-icon-group" role="group" aria-label="Organization actions">
                        <NotificationBadge />
                        <button class="org-icon-button" type="button" aria-label="Settings">
                            <MudIcon Icon="@Icons.Material.Outlined.Settings" />
                        </button>
                    </div>

                    <MudMenu ActivationEvent="@MouseEvent.MouseOver" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <ActivatorContent>
                            <button type="button" class="org-profile clickable-profile">
                                <div class="org-profile-meta">
                                    <strong>@DisplayName</strong>
                                    <span>Quản trị viên</span>
                                </div>
                                <div class="org-profile-avatar">
                                    <img src="/images/avatars/admin.jpg" alt="@DisplayName" />
                                </div>
                            </button>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="NavigateToUserSettings" Icon="@Icons.Material.Outlined.Settings">Cài đặt</MudMenuItem>
                            <MudMenuItem OnClick="HandleSignOut" Icon="@Icons.Material.Outlined.Logout">Đăng xuất</MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                </div>
            </header>
        }
        else
        {
            <header class="user-top-row">
                @if (IsDiscoverPage)
                {
                    <div class="discover-top-middle" style="flex: 2; max-width: 600px;">
                        <Org.Frontend.Components.Pages.User.DiscoverSearchBar />
                    </div>
                }
                else
                {
                    <div class="user-top-spacer"></div>
                }

                <div class="user-top-actions">
                    <NotificationBadge />
                    <button class="user-icon-button" type="button" aria-label="Messages">
                        <MudIcon Icon="@Icons.Material.Outlined.Mail" />
                    </button>

                    <MudMenu ActivationEvent="@MouseEvent.MouseOver" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <ActivatorContent>
                            <button type="button" class="user-profile clickable-profile">
                                <div class="user-profile-meta">
                                    <strong>@DisplayName</strong>
                                    <span>@UserWorkspaceLabel</span>
                                </div>
                                <div class="user-profile-avatar">
                                    <img src="/images/avatars/admin.jpg" alt="@DisplayName" />
                                </div>
                            </button>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="NavigateToUserSettings" Icon="@Icons.Material.Outlined.Settings">Cài đặt</MudMenuItem>
                            <MudMenuItem OnClick="HandleSignOut" Icon="@Icons.Material.Outlined.Logout">Đăng xuất</MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                </div>
            </header>
        }

        <section class="app-main-surface @(_isOrganizationWorkspace ? "org-main-surface" : "user-main-surface")">
            <article class="content">
                @Body
            </article>
        </section>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isOrganizationWorkspace;
    private string _activeOrganizationName = "Đang tải...";
    private Org.Frontend.ViewModels.UserDashboardViewModel? _dashboard;
    private ClaimsPrincipal _user = new(new ClaimsIdentity());

    private string DisplayName =>
        _user.Identity?.Name
        ?? _user.FindFirst(ClaimTypes.Email)?.Value
        ?? "Người dùng";

    private string UserWorkspaceLabel =>
        _user.FindFirst(ClaimTypes.Email)?.Value
        ?? "User Workspace";

    private bool IsDiscoverPage => Navigation.Uri.EndsWith("/user/discover", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = authState.User;

        Navigation.LocationChanged += HandleLocationChanged;
        await UpdateWorkspaceFromUriAsync(Navigation.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await OrganizationRouteAccessGate.SyncFromUriAsync(Navigation.Uri);
        await UpdateWorkspaceFromUriAsync(Navigation.Uri);
        await InvokeAsync(StateHasChanged);
    }

    // Đã thêm lại hàm này để sửa lỗi CS0103
    private void NavigateToUserSettings()
        => Navigation.NavigateTo("/user/settings");

    private async Task HandleSignOut()
    {
        await AuthStateProvider.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await OrganizationRouteAccessGate.SyncFromUriAsync(e.Location);
            await UpdateWorkspaceFromUriAsync(e.Location);
            StateHasChanged();
        });
    }

    private async Task UpdateWorkspaceFromUriAsync(string uri)
    {
        var route = GetCurrentRoute(uri);
        _isOrganizationWorkspace = OrganizationRouteAccessGate.ShouldUseOrganizationWorkspace(route);

        if (_isOrganizationWorkspace)
        {
            // Trích xuất orgId từ URI để tìm tên tổ chức
            if (Uri.TryCreate(Navigation.ToAbsoluteUri(uri).ToString(), UriKind.Absolute, out var parsedUri))
            {
                var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(parsedUri.Query);
                if (query.TryGetValue("orgId", out var rawId) && Guid.TryParse(rawId, out var orgId))
                {
                    if (_dashboard == null)
                    {
                        try { _dashboard = await DashboardService.GetDashboardAsync(); }
                        catch { /* Bỏ qua nếu lỗi mạng */ }
                    }
                    
                    var org = _dashboard?.Organizations.FirstOrDefault(o => o.OrganizationId == orgId);
                    _activeOrganizationName = org?.Name ?? "Workspace Tổ chức";
                }
                else
                {
                    _activeOrganizationName = "Workspace Tổ chức";
                }
            }
        }
    }

    private string GetCurrentRoute(string uri)
    {
        var route = "/" + Navigation.ToBaseRelativePath(uri).Trim('/');
        if (string.IsNullOrWhiteSpace(route)) return "/";

        var queryIndex = route.IndexOf('?');
        if (queryIndex >= 0) route = route[..queryIndex];

        var hashIndex = route.IndexOf('#');
        if (hashIndex >= 0) route = route[..hashIndex];

        return string.IsNullOrWhiteSpace(route) ? "/" : route;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
