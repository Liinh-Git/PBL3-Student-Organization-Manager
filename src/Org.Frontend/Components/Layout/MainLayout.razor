@* ---- Layout chính sau đăng nhập: sidebar + topbar + vùng nội dung ---- *@
@inherits LayoutComponentBase
@inject FrontendAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="page">
    @* ---- Cột trái: sidebar điều hướng chính của hệ thống ---- *@
    <div class="sidebar">
        <NavMenu />
    </div>

    @* ---- Cột phải: topbar + vùng nội dung của trang hiện tại ---- *@
    <main>
        <div class="top-row px-4 auth">
            <AuthorizeView>
                <Authorized Context="authContext">
                    @* ---- Hiển thị tên user và nút đăng xuất khi đã đăng nhập ---- *@
                    <span class="top-row-user">@authContext.User.Identity?.Name</span>
                    <button class="btn btn-link top-row-action" @onclick="LogoutAsync">Đăng xuất</button>
                </Authorized>

                <NotAuthorized>
                    @* ---- Fallback hiển thị link đăng nhập/đăng ký nếu chưa auth ---- *@
                    <a href="/login">Login</a>
                    <a href="/register">Sign Up</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // ---- Đăng xuất từ topbar: xóa token/state và quay về login ----
    private async Task LogoutAsync()
    {
        await AuthStateProvider.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: false);
    }
}
