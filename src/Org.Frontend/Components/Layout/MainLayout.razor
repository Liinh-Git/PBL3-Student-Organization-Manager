@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject FrontendAuthStateProvider AuthStateProvider
@implements IDisposable

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (IsPublicRoute)
{
    @Body
}
else
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main class="@(_isOrganizationWorkspace ? "org-main" : "user-main")">
            <header class="@(_isOrganizationWorkspace ? "org-top-row" : "user-top-row")">
                <div class="@(_isOrganizationWorkspace ? "org-top-left" : "user-top-spacer")">
                    @if (_isOrganizationWorkspace)
                    {
                        <h1 class="org-workspace-title">Workspace tổ chức</h1>
                    }
                </div>

                <div class="@(_isOrganizationWorkspace ? "org-top-right" : "user-top-actions")">
                    @* Tạm thời bỏ NotificationBadge để tránh gọi API sớm *@

                    <div class="profile-menu">
                        <button type="button"
                                class="@(_isOrganizationWorkspace ? "org-profile clickable-profile" : "user-profile clickable-profile")"
                                @onclick="NavigateToUserSettings">

                            <div class="@(_isOrganizationWorkspace ? "org-profile-meta" : "user-profile-meta")">
                                <strong>@DisplayName</strong>
                                <span>@UserWorkspaceLabel</span>
                            </div>

                            <div class="@(_isOrganizationWorkspace ? "org-profile-avatar" : "user-profile-avatar")">
                                <img src="/images/mockimages/AvtUser/Avt1.jpg" alt="@DisplayName" />
                            </div>
                        </button>

                        <div class="profile-dropdown" role="menu" aria-label="Tài khoản">
                            <button type="button" class="profile-menu-item" @onclick="NavigateToUserSettings">
                                <MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" />
                                <span>Cài đặt</span>
                            </button>

                            <button type="button" class="profile-menu-item danger" @onclick="HandleSignOut">
                                <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" />
                                <span>Đăng xuất</span>
                            </button>
                        </div>
                    </div>
                </div>
            </header>

            <section class="app-main-surface @(_isOrganizationWorkspace ? "org-main-surface" : "user-main-surface")">
                <article class="content">
                    @Body
                </article>
            </section>
        </main>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private ClaimsPrincipal _user = new(new ClaimsIdentity());
    private bool _isOrganizationWorkspace;

    private static readonly string[] PublicRoutePrefixes =
    [
        "",
        "login",
        "register",
        "not-found",
        "error",
        "events"
    ];

    private bool IsPublicRoute => IsPublicRouteForUri(Navigation.Uri);

    private string DisplayName =>
        _user.Identity?.Name
        ?? _user.FindFirst(ClaimTypes.Email)?.Value
        ?? "Người dùng";

    private string UserWorkspaceLabel =>
        _user.FindFirst(ClaimTypes.Email)?.Value
        ?? "Workspace cá nhân";

    protected override void OnInitialized()
    {
        SyncRouteOnly(Navigation.Uri);
        Navigation.LocationChanged += HandleLocationChanged;
        AuthStateProvider.AuthenticationStateChanged += HandleAuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await RefreshUserDisplayOnlyAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            SyncRouteOnly(e.Location);
            await RefreshUserDisplayOnlyAsync();
            StateHasChanged();
        });
    }

    private void HandleAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                var state = await task;
                _user = state.User;
            }
            catch
            {
                _user = new ClaimsPrincipal(new ClaimsIdentity());
            }

            StateHasChanged();
        });
    }

    private async Task RefreshUserDisplayOnlyAsync()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            _user = state.User;
        }
        catch
        {
            _user = new ClaimsPrincipal(new ClaimsIdentity());
        }
    }

    private void SyncRouteOnly(string uri)
    {
        var route = GetCurrentRoute(uri);
        _isOrganizationWorkspace = route.StartsWith("/org", StringComparison.OrdinalIgnoreCase);
    }

    private void NavigateToUserSettings()
        => Navigation.NavigateTo("/user/settings");

    private async Task HandleSignOut()
    {
        await AuthStateProvider.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private string GetCurrentRoute(string uri)
    {
        var route = "/" + Navigation.ToBaseRelativePath(uri).Trim('/');

        var queryIndex = route.IndexOf('?');
        if (queryIndex >= 0)
            route = route[..queryIndex];

        var hashIndex = route.IndexOf('#');
        if (hashIndex >= 0)
            route = route[..hashIndex];

        return string.IsNullOrWhiteSpace(route) ? "/" : route;
    }

    private bool IsPublicRouteForUri(string uri)
    {
        var currentPath = Navigation
            .ToBaseRelativePath(uri)
            .Split('?', '#')[0]
            .Trim('/')
            .ToLowerInvariant();

        if (currentPath.StartsWith("org/", StringComparison.OrdinalIgnoreCase))
            return false;

        return PublicRoutePrefixes.Any(prefix =>
            string.Equals(currentPath, prefix, StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(prefix)
                && currentPath.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase)));
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
    }
}