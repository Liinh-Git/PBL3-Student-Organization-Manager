@* ---- Layout chính của app: sidebar trái (NavMenu) + main area phải ----
    Sidebar = NavMenu (rail + menu pane).
    Main area thay đổi CSS class (org-main / user-main) theo workspace đang active.
    LocationChanged được dùng để đồng bộ UI/workspace state của layout. *@
@inherits LayoutComponentBase
@inject FrontendAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IOrganizationRouteAccessGate OrganizationRouteAccessGate
@implements IDisposable
@using System.Security.Claims

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="@(_isOrganizationWorkspace ? "org-main" : "user-main")">
        @if (_isOrganizationWorkspace)
        {
            <header class="org-top-row">
                <div class="org-top-left">
                    <div class="org-search-wrap">
                        <MudIcon Icon="@Icons.Material.Filled.Search" Class="org-search-icon" />
                        <input class="org-search"
                               type="search"
                               placeholder="Tim kiem tai lieu, thanh vien..." />
                    </div>
                    <button class="org-pill-button org-search-button" type="button">Tim kiem</button>
                </div>

                <div class="org-top-right">
                    <button class="org-pill-button org-invite-button" type="button">Moi thanh vien</button>

                    <div class="org-icon-group" role="group" aria-label="Organization actions">
                        <button class="org-icon-button" type="button" aria-label="Notifications">
                            <MudIcon Icon="@Icons.Material.Outlined.Notifications" />
                        </button>
                        <button class="org-icon-button" type="button" aria-label="Settings">
                            <MudIcon Icon="@Icons.Material.Outlined.Settings" />
                        </button>
                    </div>

                    <button type="button" class="org-profile clickable-profile" @onclick="NavigateToUserSettings">
                        <div class="org-profile-meta">
                            <strong>@DisplayName</strong>
                            <span>Quan tri vien</span>
                        </div>
                        <div class="org-profile-avatar">
                            <img src="/images/avatars/admin.jpg" alt="@DisplayName" />
                        </div>
                    </button>
                </div>
            </header>
        }
        else
        {
            <header class="user-top-row">
                <div class="user-top-spacer"></div>

                <div class="user-top-actions">
                    <button class="user-icon-button" type="button" aria-label="Notifications">
                        <MudIcon Icon="@Icons.Material.Outlined.Notifications" />
                    </button>
                    <button class="user-icon-button" type="button" aria-label="Messages">
                        <MudIcon Icon="@Icons.Material.Outlined.Mail" />
                    </button>
                    <button class="user-logout-button" type="button" @onclick="HandleSignOut">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Class="user-logout-icon" />
                        <span>Dang xuat</span>
                    </button>

                    <button type="button" class="user-profile clickable-profile" @onclick="NavigateToUserSettings">
                        <div class="user-profile-meta">
                            <strong>@DisplayName</strong>
                            <span>@UserWorkspaceLabel</span>
                        </div>
                        <div class="user-profile-avatar">
                            <img src="/images/avatars/admin.jpg" alt="@DisplayName" />
                        </div>
                    </button>
                </div>
            </header>
        }

        <section class="app-main-surface @(_isOrganizationWorkspace ? "org-main-surface" : "user-main-surface")">
            <article class="content">
                @Body
            </article>
        </section>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isOrganizationWorkspace;
    private ClaimsPrincipal _user = new(new ClaimsIdentity());

    private string DisplayName =>
        _user.Identity?.Name
        ?? _user.FindFirst(ClaimTypes.Email)?.Value
        ?? "Nguoi dung";

    private string UserWorkspaceLabel =>
        _user.FindFirst(ClaimTypes.Email)?.Value
        ?? "User Workspace";

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        UpdateWorkspaceFromUri(Navigation.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await OrganizationRouteAccessGate.SyncFromUriAsync(Navigation.Uri);
        UpdateWorkspaceFromUri(Navigation.Uri);
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = authState.User;
    }

    private async Task HandleSignOut()
    {
        await AuthStateProvider.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void NavigateToUserSettings()
        => Navigation.NavigateTo("/user/settings");

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await OrganizationRouteAccessGate.SyncFromUriAsync(e.Location);
            UpdateWorkspaceFromUri(e.Location);
            StateHasChanged();
        });
    }

    private void UpdateWorkspaceFromUri(string uri)
    {
        var route = GetCurrentRoute(uri);
        _isOrganizationWorkspace = OrganizationRouteAccessGate.ShouldUseOrganizationWorkspace(route);
    }

    private string GetCurrentRoute(string uri)
    {
        var route = "/" + Navigation.ToBaseRelativePath(uri).Trim('/');

        if (string.IsNullOrWhiteSpace(route))
        {
            return "/";
        }

        var queryIndex = route.IndexOf('?');
        if (queryIndex >= 0)
        {
            route = route[..queryIndex];
        }

        var hashIndex = route.IndexOf('#');
        if (hashIndex >= 0)
        {
            route = route[..hashIndex];
        }

        return string.IsNullOrWhiteSpace(route) ? "/" : route;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}