@inherits LayoutComponentBase
@inject FrontendAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <header class="top-row">
            <div class="top-search-wrap">
                <input class="top-search" type="search" placeholder="Tim kiem tai lieu, thanh vien..." />
                <button class="top-search-button" type="button">Tim kiem</button>
            </div>

            <div class="top-actions">
                <button class="top-action-button" type="button" aria-label="Notifications">N</button>
                <button class="top-action-button" type="button" aria-label="Messages">M</button>
                <button class="top-logout-button" type="button" @onclick="HandleSignOut">Dang xuat</button>

                <div class="top-profile">
                    <div class="top-profile-meta">
                        <strong>Kora Admin</strong>
                        <span>Organization Lead</span>
                    </div>
                    <div class="top-profile-avatar">KA</div>
                </div>
            </div>
        </header>

        <section class="app-main-surface">
            <article class="content">
                @Body
            </article>
        </section>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private async Task HandleSignOut()
    {
        await AuthStateProvider.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}