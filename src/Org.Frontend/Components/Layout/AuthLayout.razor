@* ---- Layout cho trang login/register: bên trái hero, bên phải form ---- *@
@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="auth-shell">
    @* ---- Cột trái: khu vực giới thiệu thương hiệu và số liệu nổi bật ---- *@
    <aside class="auth-hero">
        <div class="auth-hero-header">AcademiaCurator</div>

        <div class="auth-hero-icon" aria-hidden="true">
            <span class="material-symbols-outlined">school</span>
        </div>

        <h1 class="auth-hero-title">@Title</h1>
        <p class="auth-hero-subtitle">
            @Subtitle
        </p>

        <div class="auth-hero-stats">
            <article>
                <strong>@Stat1Value</strong>
                <span>@Stat1Label</span>
            </article>
            <article>
                <strong>@Stat2Value</strong>
                <span>@Stat2Label</span>
            </article>
        </div>

        <p class="auth-hero-proof">@ProofText</p>
    </aside>

    @* ---- Cột phải: khu vực form đăng nhập/đăng ký và điều hướng auth ---- *@
    <section class="auth-stage">
        <header class="auth-stage-topnav">
            <a href="/login" class="@GetLinkClass("login")">Login</a>
            <a href="/register" class="@GetLinkClass("register")">Sign Up</a>
        </header>

        <main class="auth-stage-content">
            @Body
        </main>

        <footer class="auth-stage-footer">
            <span>© 2024 AcademiaCurator. All rights reserved.</span>
        </footer>
    </section>
</div>

@code {
    private string GetLinkClass(string segment)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var isActive = path.StartsWith(segment, StringComparison.OrdinalIgnoreCase);
        return isActive ? "auth-nav-link active" : "auth-nav-link";
    }

    private bool IsLoginPage => Navigation.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase);

    private string Title => IsLoginPage ? "Chào mừng trở lại" : "Tham gia cộng đồng của chúng tôi";

    private string Subtitle => IsLoginPage 
        ? "Giải pháp tối ưu cho tổ chức sinh viên hiện đại"
        : "Khám phá các câu lạc bộ, sự kiện và kết nối với những người có cùng sở thích trong môi trường học thuật hiện đại.";

    private string Stat1Value => IsLoginPage ? "150+" : "500+";
    private string Stat1Label => IsLoginPage ? "Tổ chức" : "Câu lạc bộ";
    private string Stat2Value => "10k+";
    private string Stat2Label => "Sinh viên";

    private string ProofText => IsLoginPage 
        ? "Quản lý cộng đồng hiệu quả hơn bao giờ hết."
        : "Tham gia cùng hàng nghìn sinh viên khác ngay hôm nay.";
}
