@* ---- Auth guard: tự động chuyển sang /login nếu chưa đăng nhập ---- *@
@inject NavigationManager Navigation
@inject FrontendAuthStateProvider AuthStateProvider

@code {
    // ---- Các route public không cần đăng nhập ----
    private static readonly string[] PublicRoutePrefixes = ["login", "register", "not-found", "error"];
    private bool _authInitialized;

    // ---- Luôn kiểm tra trạng thái auth sau mỗi render để không giữ UI đăng nhập "ảo" ----
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Bước 1: đảm bảo auth state đã được khởi tạo từ token (chỉ cần làm 1 lần)
        if (!_authInitialized)
        {
            await AuthStateProvider.InitializeAsync();
            _authInitialized = true;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            return;

        // Bước 2: bỏ qua redirect nếu đang ở các route public
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var currentPath = relativePath.Split('?', '#')[0].Trim('/');

        // Route gốc "/" được phép truy cập công khai để hiển thị giao diện chính.
        if (string.IsNullOrWhiteSpace(currentPath))
            return;

        // Keep public event detail route accessible (/events, /events/{id})
        // without accidentally whitelisting protected org workspace routes (/org/events).
        if (string.Equals(currentPath, "events", StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith("events/", StringComparison.OrdinalIgnoreCase))
            return;

        if (PublicRoutePrefixes.Any(prefix =>
            currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)))
            return;

        // Bước 3: dựng returnUrl để sau login quay lại đúng trang trước đó
        var currentUri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(currentUri.PathAndQuery)
            ? "/"
            : currentUri.PathAndQuery;

        // Bước 4: điều hướng sang login và kèm returnUrl
        var target = $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
        Navigation.NavigateTo(target, forceLoad: false);
    }
}
