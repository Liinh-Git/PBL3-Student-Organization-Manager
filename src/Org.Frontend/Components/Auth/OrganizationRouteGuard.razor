@inject NavigationManager Navigation
@inject IOrganizationRouteAccessGate OrganizationRouteAccessGate
@implements IDisposable

@code {
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await SyncAndRedirectIfNeededAsync(Navigation.Uri);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () => await SyncAndRedirectIfNeededAsync(e.Location));
    }

    private async Task SyncAndRedirectIfNeededAsync(string absoluteUri)
    {
        await OrganizationRouteAccessGate.SyncFromUriAsync(absoluteUri);

        var route = GetCurrentRoute(absoluteUri);
        if (!OrganizationRouteAccessGate.ShouldBlockInternalRoute(route))
        {
            return;
        }

        var target = OrganizationRouteAccessGate.BuildRestrictedOverviewRoute();
        if (!IsAlreadyAtTarget(absoluteUri, target))
        {
            Navigation.NavigateTo(target);
        }
    }

    private bool IsAlreadyAtTarget(string currentAbsoluteUri, string targetRelative)
    {
        var currentRoute = GetCurrentRoute(currentAbsoluteUri);
        var targetRoute = GetCurrentRoute(Navigation.ToAbsoluteUri(targetRelative).ToString());

        if (!string.Equals(currentRoute, targetRoute, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var currentQuery = new Uri(currentAbsoluteUri, UriKind.Absolute).Query;
        var targetQuery = Navigation.ToAbsoluteUri(targetRelative).Query;
        return string.Equals(currentQuery, targetQuery, StringComparison.Ordinal);
    }

    private string GetCurrentRoute(string uri)
    {
        var route = "/" + Navigation.ToBaseRelativePath(uri).Trim('/');

        if (string.IsNullOrWhiteSpace(route))
        {
            return "/";
        }

        var queryIndex = route.IndexOf('?');
        if (queryIndex >= 0)
        {
            route = route[..queryIndex];
        }

        var hashIndex = route.IndexOf('#');
        if (hashIndex >= 0)
        {
            route = route[..hashIndex];
        }

        return string.IsNullOrWhiteSpace(route) ? "/" : route;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}