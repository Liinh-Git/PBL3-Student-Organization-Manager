@* ---- Dialog gán vai trò cho thành viên (Bootstrap modal) — gọi từ MemberList ----
    IsOpen / OnConfirm / OnCancel: param điều khiển hiển thị và sự kiện callback. *@
@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Assign Role</h5>
                    <button type="button" class="btn-close" @onclick="Cancel"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Role</label>
                    <select class="form-select" @bind="SelectedRoleIdText">
                        <option value="">Choose role</option>
                        @foreach (var role in Roles)
                        {
                            <option value="@role.Id">@role.Name</option>
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                    <button class="btn btn-primary" @onclick="Confirm" disabled="@(!SelectedRoleId.HasValue)">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public Guid? SelectedRoleId { get; set; }

    [Parameter]
    public IReadOnlyList<RoleOption> Roles { get; set; } = [];

    [Parameter]
    public EventCallback<Guid> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string SelectedRoleIdText
    {
        get => SelectedRoleId?.ToString() ?? string.Empty;
        set => SelectedRoleId = Guid.TryParse(value, out var parsed) ? parsed : null;
    }

    private async Task Confirm()
    {
        if (SelectedRoleId.HasValue)
        {
            await OnConfirm.InvokeAsync(SelectedRoleId.Value);
        }
    }

    private Task Cancel()
        => OnCancel.InvokeAsync();

    public sealed class RoleOption
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}
