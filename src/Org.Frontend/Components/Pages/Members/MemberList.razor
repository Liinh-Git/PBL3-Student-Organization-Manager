@page "/org/members"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using Org.Frontend.Services.Organizations
@inject IMemberService MemberService
@inject IDepartmentService DepartmentService
@inject IOrganizationContext OrganizationContext
@inject IOrganizationRoleService OrganizationRoleService
@inject Org.Frontend.Services.Requests.IRequestService RequestService
@inject FrontendAuthStateProvider FrontendAuthStateProvider
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Thanh vien</PageTitle>

<section class="member-management-page">
    @{
        var filteredMembers = GetFilteredMembers();
        var pagedMembers = GetPagedMembers(filteredMembers);
        var filteredCount = filteredMembers.Count;
        var totalPages = GetTotalPages(filteredCount);
        var rangeStart = GetRangeStart(filteredCount);
        var rangeEnd = GetRangeEnd(filteredCount);
    }
    <div class="members-header">
        <div class="members-search-wrap">
            <input class="members-search-input"
                    type="search"
                    value="@SearchTerm"
                    @oninput="OnSearchInput"
                    placeholder="Tim kiem theo ten hoac email..." />
            <MudIcon Icon="@Icons.Material.Filled.Search" Class="members-search-icon" />
        </div>

        <div class="members-add-bar">
            @if (_canManageMembers)
            {
                <button class="members-add-btn" type="button" @onclick="ToggleCreateDialog">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" />
                    <span>Them thanh vien</span>
                </button>
            }
            @if (_canManageRoles)
            {
                <button class="members-add-btn" type="button" @onclick="ToggleRoleManagerDialog">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                    <span>Quan ly vai tro</span>
                </button>
            }
            <button class="members-add-btn" type="button" @onclick="ToggleRequestDialog">
                <MudIcon Icon="@Icons.Material.Filled.Send" />
                <span>Gui yeu cau</span>
            </button>
            <button class="members-add-btn" type="button" @onclick="LeaveOrganization">
                <MudIcon Icon="@Icons.Material.Filled.Logout" />
                <span>Roi to chuc</span>
            </button>
        </div>
    </div>

    @if (ShowCreateDialog && _canManageMembers)
    {
        <div class="members-create-dialog">
            <h3>Them thanh vien moi</h3>
            <div class="create-form-grid">
                <div class="create-field">
                    <label>Ten hien thi *</label>
                    <input type="text" @bind="CreateDisplayName" placeholder="VD: Nguyen Van A" class="create-input" />
                </div>
                <div class="create-field">
                    <label>Email *</label>
                    <input type="email" @bind="CreateEmail" placeholder="email@example.com" class="create-input" />
                </div>
                <div class="create-field">
                    <label>Ban chuyen mon</label>
                    <select @bind="CreateDepartmentValue" class="create-select">
                        <option value="">-- Khong chon --</option>
                        @foreach (var dept in Departments)
                        {
                            <option value="@dept.Id">@dept.DeptName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="create-actions">
                <button class="create-cancel-btn" type="button" @onclick="ToggleCreateDialog">Huy</button>
                <button class="create-submit-btn" type="button" @onclick="CreateMember">Them</button>
            </div>
        </div>
    }

    @if (_showRoleManagerDialog && _canManageRoles)
    {
        <div class="members-create-dialog">
            <h3>Quan ly vai tro</h3>
            <div class="create-form-grid">
                <div class="create-field">
                    <label>Ten vai tro *</label>
                    <input type="text" class="create-input" @bind="_editRoleName" />
                </div>
                <div class="create-field">
                    <label>Quyen</label>
                    <select class="create-select" @onchange="OnRolePermissionChanged">
                        <option value="">-- Them quyen --</option>
                        @foreach (var permission in _permissionOptions)
                        {
                            <option value="@permission.Code">@permission.Group - @permission.Label</option>
                        }
                    </select>
                </div>
            </div>
            <div class="role-permissions">
                @foreach (var permCode in _editRolePermissions)
                {
                    <span class="member-role-badge role-member">
                        @permCode
                        <button type="button" class="member-row-action" @onclick="() => RemoveRolePermission(permCode)">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                        </button>
                    </span>
                }
            </div>
            <div class="create-actions">
                <button class="create-cancel-btn" type="button" @onclick="ResetRoleEditor">Reset</button>
                <button class="create-submit-btn" type="button" @onclick="SaveRoleAsync">@(_editingRoleId.HasValue ? "Cap nhat" : "Tao role")</button>
                <button class="create-cancel-btn" type="button" @onclick="ToggleRoleManagerDialog">Dong</button>
            </div>

            <div class="members-table-wrap" style="margin-top:12px;">
                <table class="members-table">
                    <thead>
                        <tr>
                            <th>ROLE</th>
                            <th>PERMISSIONS</th>
                            <th>ASSIGNED</th>
                            <th class="th-actions">THAO TAC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in _roles)
                        {
                            <tr>
                                <td>@role.Name</td>
                                <td>@string.Join(", ", role.PermissionCodes)</td>
                                <td>@role.AssignedMemberCount</td>
                                <td class="td-actions">
                                    <button class="member-row-action action-view" type="button" @onclick="() => StartEditRole(role)">
                                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                                    </button>
                                    @if (!role.IsProtected)
                                    {
                                        <button class="member-row-action action-delete" type="button" @onclick="() => DeleteRoleAsync(role)">
                                            <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_showRequestDialog)
    {
        <div class="members-create-dialog">
            <h3>Gui yeu cau toi quan tri to chuc</h3>
            <div class="create-form-grid">
                <div class="create-field">
                    <label>Loai yeu cau</label>
                    <select class="create-select" @bind="_requestType">
                        <option value="GeneralOrgRequest">Yeu cau chung</option>
                        <option value="RoleChangeRequest">Yeu cau doi vai tro</option>
                        <option value="SupportRequest">Yeu cau ho tro</option>
                    </select>
                </div>
                <div class="create-field">
                    <label>Tieu de</label>
                    <input type="text" class="create-input" @bind="_requestTitle" />
                </div>
                <div class="create-field">
                    <label>Noi dung</label>
                    <textarea class="create-input" rows="3" @bind="_requestMessage"></textarea>
                </div>
            </div>
            <div class="create-actions">
                <button class="create-cancel-btn" type="button" @onclick="ToggleRequestDialog">Dong</button>
                <button class="create-submit-btn" type="button" @onclick="SubmitOrganizationRequestAsync">Gui</button>
            </div>
        </div>
    }

    <section class="members-table-shell">
        <div class="members-filter-bar">
            <div class="members-filter-heading">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" />
                <span>Bo loc danh sach</span>
            </div>

            <div class="members-filter-controls">
                <select class="members-filter-select"
                        value="@SelectedRoleFilter"
                        @onchange="OnRoleFilterChanged">
                    <option value="all">Vai tro: Tat ca</option>
                    <option value="admin">Quan tri vien</option>
                    <option value="moderator">Kiem duyet</option>
                    <option value="member">Thanh vien</option>
                </select>

                <select class="members-filter-select"
                        value="@SelectedDepartmentFilter"
                        @onchange="OnDepartmentFilterChanged">
                    <option value="all">Ban chuyen mon: Tat ca</option>
                    <option value="none">Chua phan ban</option>
                    @foreach (var dept in Departments)
                    {
                        <option value="@dept.Id">@dept.DeptName</option>
                    }
                </select>

                <button class="members-filter-reset" type="button" @onclick="ResetFilters">
                    <MudIcon Icon="@Icons.Material.Filled.RestartAlt" />
                    Dat lai bo loc
                </button>
            </div>
        </div>

        <div class="members-table-wrap">
            <table class="members-table">
                <thead>
                    <tr>
                        <th>HO VA TEN</th>
                        <th>VAI TRO</th>
                        <th>BAN CHUYEN MON</th>
                        <th>NGAY GIA NHAP</th>
                        <th class="th-actions">THAO TAC</th>
                    </tr>
                </thead>
                <tbody>
                    @if (pagedMembers.Count == 0)
                    {
                        <tr class="members-empty-row">
                            <td colspan="5">Khong co thanh vien phu hop voi bo loc hien tai.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var member in pagedMembers)
                        {
                            <tr>
                                <td>
                                    <div class="member-identity">
                                        <div class="member-avatar-chip">@GetAvatar(member.DisplayName)</div>
                                        <div class="member-identity-copy">
                                            <p>@member.DisplayName</p>
                                            <span>@GetMemberEmail(member)</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="member-role-cell">
                                        <span class="member-role-badge @GetRoleBadgeClass(member)">@GetRoleLabel(member)</span>
                                        @if (_canManageRoles)
                                        {
                                            <button type="button"
                                                    class="member-row-action action-view"
                                                    aria-label="Gan vai tro"
                                                    @onclick="() => OpenRoleDialog(member)">
                                                <MudIcon Icon="@(member.RoleId.HasValue ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Size="Size.Small" />
                                            </button>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="member-department">@GetDepartmentName(member.DepartmentId)</span>
                                </td>
                                <td>
                                    <span class="member-join-date">@member.JoinDate.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                </td>
                                <td class="td-actions">
                                    <div class="member-actions-group">
                                        <button class="member-row-action action-view"
                                                type="button"
                                                disabled="@(!CanOpenMemberProfile(member))"
                                                @onclick="() => OpenMemberProfile(member)"
                                                aria-label="Xem chi tiet">
                                            <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" />
                                        </button>

                                        @if (CanShowRemoveAction(member))
                                        {
                                            <button class="member-row-action action-delete"
                                                    type="button"
                                                    @onclick="() => DeleteMember(member)"
                                                    aria-label="Xoa thanh vien">
                                                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="members-pagination">
            <p>
                Hien thi <strong>@rangeStart-@rangeEnd</strong> trong <strong>@filteredCount</strong> thanh vien
            </p>
            <MudPagination Count="totalPages"
                           Selected="CurrentPage"
                           SelectedChanged="GoToPage"
                           Class="members-mud-pagination"
                           ShowFirstButton="true"
                           ShowLastButton="true" />
        </div>
    </section>

    <AssignRoleDialog IsOpen="ShowRoleDialog"
                      Roles="RoleOptions"
                      SelectedRoleId="PendingRoleId"
                      OnConfirm="ConfirmAssignRole"
                      OnCancel="CloseRoleDialog" />
</section>

@code {
    private List<MemberDto> Members { get; set; } = [];
    private List<DepartmentDto> Departments { get; set; } = [];
    private Guid? CurrentOrganizationId { get; set; }
    private bool ShowRoleDialog { get; set; }
    private Guid? SelectedMemberId { get; set; }
    private Guid? PendingRoleId { get; set; }
    private const int PageSize = 10;
    private int CurrentPage { get; set; } = 1;
    private string SearchTerm { get; set; } = string.Empty;
    private string SelectedRoleFilter { get; set; } = "all";
    private string SelectedDepartmentFilter { get; set; } = "all";
    private string CreateDisplayName { get; set; } = string.Empty;
    private string CreateEmail { get; set; } = string.Empty;
    private string CreateDepartmentValue { get; set; } = string.Empty;
    private bool ShowCreateDialog { get; set; }
    private bool _canManageMembers;
    private bool _canManageRoles;
    private Guid? _currentUserId;
    private string? _currentUserEmail;

    private List<OrganizationRoleViewModel> _roles = [];
    private List<AssignRoleDialog.RoleOption> RoleOptions { get; set; } = [];
    private IReadOnlyList<PermissionOptionViewModel> _permissionOptions = [];
    private bool _showRoleManagerDialog;
    private Guid? _editingRoleId;
    private string _editRoleName = string.Empty;
    private List<string> _editRolePermissions = [];
    private bool _showRequestDialog;
    private string _requestType = "GeneralOrgRequest";
    private string _requestTitle = string.Empty;
    private string _requestMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await FrontendAuthStateProvider.InitializeAsync();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            await ReloadSafely();
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            await InvokeAsync(async () =>
            {
                await ReloadSafely();
                StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private async Task Reload()
    {
        CurrentOrganizationId ??= await OrganizationContext.GetOrganizationIdAsync();
        _currentUserId = await ResolveCurrentUserIdAsync();
        _currentUserEmail = await ResolveCurrentUserEmailAsync();
        _canManageMembers = await MemberService.CanManageOrganizationMembersAsync(CurrentOrganizationId.Value);
        _canManageRoles = await OrganizationRoleService.CanManageRolesAsync(CurrentOrganizationId.Value);
        Departments = await DepartmentService.GetDepartments(CurrentOrganizationId.Value);
        Members = await MemberService.GetMembers(CurrentOrganizationId.Value);
        CurrentPage = 1;
        await LoadRolesAsync();
    }

    private async Task LoadRolesAsync()
    {
        if (!CurrentOrganizationId.HasValue)
        {
            return;
        }

        try
        {
            _roles = (await OrganizationRoleService.GetRolesAsync(CurrentOrganizationId.Value)).ToList();
            _permissionOptions = await OrganizationRoleService.GetAvailablePermissionsAsync(CurrentOrganizationId.Value);
            RoleOptions = _roles
                .Select(x => new AssignRoleDialog.RoleOption { Id = x.Id, Name = x.Name })
                .ToList();
        }
        catch (Exception ex)
        {
            _roles = [];
            RoleOptions = [];
            _permissionOptions = [];
            Snackbar.Add($"Khong the tai danh sach role: {ex.Message}", Severity.Warning);
        }
    }

    private async Task ReloadSafely()
    {
        try
        {
            await Reload();
        }
        catch (AuthApiException ex) when (ex.StatusCode == 401)
        {
            await HandleExpiredSessionAsync(ex.Message);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the tai du lieu members: {ex.Message}", Severity.Error);
        }
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        SearchTerm = args.Value?.ToString() ?? string.Empty;
        CurrentPage = 1;
    }

    private void OnRoleFilterChanged(ChangeEventArgs args)
    {
        SelectedRoleFilter = args.Value?.ToString() ?? "all";
        CurrentPage = 1;
    }

    private void OnDepartmentFilterChanged(ChangeEventArgs args)
    {
        SelectedDepartmentFilter = args.Value?.ToString() ?? "all";
        CurrentPage = 1;
    }

    private void ResetFilters()
    {
        SearchTerm = string.Empty;
        SelectedRoleFilter = "all";
        SelectedDepartmentFilter = "all";
        CurrentPage = 1;
    }

    private void GoToPage(int page) => CurrentPage = page;

    private List<MemberDto> GetFilteredMembers()
    {
        var normalizedTerm = SearchTerm.Trim();
        return Members
            .Where(member => MatchesSearch(member, normalizedTerm))
            .Where(MatchesRoleFilter)
            .Where(MatchesDepartmentFilter)
            .OrderBy(member => member.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private List<MemberDto> GetPagedMembers(IReadOnlyList<MemberDto> filteredMembers)
    {
        var totalPages = GetTotalPages(filteredMembers.Count);
        CurrentPage = Math.Clamp(CurrentPage, 1, totalPages);
        return filteredMembers.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private int GetTotalPages(int totalItems) => Math.Max(1, (int)Math.Ceiling(totalItems / (double)PageSize));
    private int GetRangeStart(int totalItems) => totalItems == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int GetRangeEnd(int totalItems) => totalItems == 0 ? 0 : Math.Min(totalItems, CurrentPage * PageSize);

    private static string GetRoleLabel(MemberDto member)
    {
        return GetRoleFilterKey(member) switch
        {
            "admin" => "QUAN TRI VIEN",
            "moderator" => "KIEM DUYET",
            _ => "THANH VIEN"
        };
    }

    private static string GetRoleBadgeClass(MemberDto member)
    {
        return GetRoleFilterKey(member) switch
        {
            "admin" => "role-admin",
            "moderator" => "role-moderator",
            _ => "role-member"
        };
    }

    private bool MatchesSearch(MemberDto member, string normalizedTerm)
    {
        if (string.IsNullOrWhiteSpace(normalizedTerm))
        {
            return true;
        }

        return member.DisplayName.Contains(normalizedTerm, StringComparison.OrdinalIgnoreCase)
            || GetMemberEmail(member).Contains(normalizedTerm, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesRoleFilter(MemberDto member)
        => SelectedRoleFilter == "all" || GetRoleFilterKey(member) == SelectedRoleFilter;

    private bool MatchesDepartmentFilter(MemberDto member)
    {
        if (SelectedDepartmentFilter == "all")
        {
            return true;
        }

        if (SelectedDepartmentFilter == "none")
        {
            return !member.DepartmentId.HasValue;
        }

        return Guid.TryParse(SelectedDepartmentFilter, out var departmentId) && member.DepartmentId == departmentId;
    }

    private static string GetRoleFilterKey(MemberDto member)
    {
        if (string.IsNullOrWhiteSpace(member.RoleName))
        {
            return "member";
        }

        var roleName = member.RoleName.Trim();
        if (string.Equals(roleName, "President", StringComparison.OrdinalIgnoreCase))
        {
            return "admin";
        }

        if (string.Equals(roleName, "VicePresident", StringComparison.OrdinalIgnoreCase)
            || string.Equals(roleName, "Manager", StringComparison.OrdinalIgnoreCase))
        {
            return "moderator";
        }

        return "member";
    }

    private static string GetMemberEmail(MemberDto member)
        => string.IsNullOrWhiteSpace(member.Email) ? "(chua co email)" : member.Email;

    private void OpenRoleDialog(MemberDto member)
    {
        SelectedMemberId = member.Id;
        PendingRoleId = member.RoleId;
        ShowRoleDialog = true;
    }

    private void CloseRoleDialog()
    {
        ShowRoleDialog = false;
        SelectedMemberId = null;
        PendingRoleId = null;
    }

    private async Task ConfirmAssignRole(Guid roleId)
    {
        if (!SelectedMemberId.HasValue || !CurrentOrganizationId.HasValue)
        {
            return;
        }

        try
        {
            await OrganizationRoleService.AssignRoleToMemberAsync(CurrentOrganizationId.Value, SelectedMemberId.Value, roleId);
            Snackbar.Add("Da gan vai tro thanh cong.", Severity.Success);
            CloseRoleDialog();
            await Reload();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the gan vai tro: {ex.Message}", Severity.Error);
        }
    }

    private void ToggleRoleManagerDialog()
    {
        _showRoleManagerDialog = !_showRoleManagerDialog;
        if (_showRoleManagerDialog)
        {
            ResetRoleEditor();
        }
    }

    private void ResetRoleEditor()
    {
        _editingRoleId = null;
        _editRoleName = string.Empty;
        _editRolePermissions = [];
    }

    private void StartEditRole(OrganizationRoleViewModel role)
    {
        _editingRoleId = role.Id;
        _editRoleName = role.Name;
        _editRolePermissions = role.PermissionCodes.ToList();
    }

    private void OnRolePermissionChanged(ChangeEventArgs args)
    {
        var code = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(code))
        {
            return;
        }

        if (_editRolePermissions.Contains(code, StringComparer.OrdinalIgnoreCase))
        {
            return;
        }

        _editRolePermissions.Add(code);
    }

    private void RemoveRolePermission(string code)
    {
        _editRolePermissions.RemoveAll(x => string.Equals(x, code, StringComparison.OrdinalIgnoreCase));
    }

    private async Task SaveRoleAsync()
    {
        if (!CurrentOrganizationId.HasValue)
        {
            return;
        }

        try
        {
            var request = new UpsertOrganizationRoleRequest
            {
                Name = _editRoleName,
                PermissionCodes = _editRolePermissions.ToList()
            };

            if (_editingRoleId.HasValue)
            {
                await OrganizationRoleService.UpdateRoleAsync(_editingRoleId.Value, request);
                Snackbar.Add("Da cap nhat role.", Severity.Success);
            }
            else
            {
                await OrganizationRoleService.CreateRoleAsync(CurrentOrganizationId.Value, request);
                Snackbar.Add("Da tao role moi.", Severity.Success);
            }

            await LoadRolesAsync();
            ResetRoleEditor();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the luu role: {ex.Message}", Severity.Error);
        }
    }

    private void ToggleRequestDialog()
    {
        _showRequestDialog = !_showRequestDialog;
        if (!_showRequestDialog)
        {
            _requestType = "GeneralOrgRequest";
            _requestTitle = string.Empty;
            _requestMessage = string.Empty;
        }
    }

    private async Task SubmitOrganizationRequestAsync()
    {
        if (!CurrentOrganizationId.HasValue)
        {
            Snackbar.Add("Khong tim thay to chuc hien tai.", Severity.Warning);
            return;
        }

        try
        {
            await RequestService.SubmitOrganizationRequestAsync(new Org.Frontend.ViewModels.CreateOrganizationRequestViewModel
            {
                OrgId = CurrentOrganizationId.Value,
                RequestType = _requestType,
                Title = _requestTitle,
                Message = _requestMessage
            });
            Snackbar.Add("Da gui yeu cau.", Severity.Success);
            ToggleRequestDialog();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the gui yeu cau: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteRoleAsync(OrganizationRoleViewModel role)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Xoa role '{role.Name}'?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await OrganizationRoleService.DeleteRoleAsync(role.Id);
            Snackbar.Add("Da xoa role.", Severity.Success);
            await LoadRolesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the xoa role: {ex.Message}", Severity.Error);
        }
    }

    private void ToggleCreateDialog()
    {
        ShowCreateDialog = !ShowCreateDialog;
        if (!ShowCreateDialog)
        {
            CreateDisplayName = string.Empty;
            CreateEmail = string.Empty;
            CreateDepartmentValue = string.Empty;
        }
    }

    private async Task CreateMember()
    {
        if (!_canManageMembers)
        {
            Snackbar.Add("Ban khong co quyen them thanh vien.", Severity.Warning);
            return;
        }

        if (!CurrentOrganizationId.HasValue)
        {
            Snackbar.Add("Khong tim thay to chuc hien tai.", Severity.Warning);
            return;
        }

        var displayName = CreateDisplayName.Trim();
        var email = CreateEmail.Trim();

        if (displayName.Length < 2)
        {
            Snackbar.Add("Ten thanh vien phai co it nhat 2 ky tu.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(email) || !email.Contains('@'))
        {
            Snackbar.Add("Email khong hop le.", Severity.Warning);
            return;
        }

        Guid? departmentId = null;
        if (Guid.TryParse(CreateDepartmentValue, out var parsedDepartmentId))
        {
            departmentId = parsedDepartmentId;
        }

        try
        {
            await MemberService.CreateMember(
                CurrentOrganizationId.Value,
                new Org.Shared.Features.Members.CreateMemberRequest(displayName, email, departmentId));

            CreateDisplayName = string.Empty;
            CreateEmail = string.Empty;
            CreateDepartmentValue = string.Empty;
            ShowCreateDialog = false;
            Snackbar.Add("Them thanh vien thanh cong.", Severity.Success);
            await Reload();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the them member: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteMember(MemberDto member)
    {
        if (!_canManageMembers || !CanShowRemoveAction(member))
        {
            Snackbar.Add("Ban khong co quyen xoa thanh vien nay.", Severity.Warning);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete member '{member.DisplayName}'?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await MemberService.DeleteMember(member.Id);
            if (SelectedMemberId == member.Id)
            {
                CloseRoleDialog();
            }

            Snackbar.Add("Da xoa thanh vien.", Severity.Success);
            await Reload();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the xoa member: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleExpiredSessionAsync(string? reason = null)
    {
        CurrentOrganizationId = null;
        Departments = [];
        Members = [];

        var msg = string.IsNullOrWhiteSpace(reason)
            ? "Phien dang nhap da het han. Vui long dang nhap lai."
            : reason;
        Snackbar.Add(msg, Severity.Warning);

        await FrontendAuthStateProvider.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private bool CanShowRemoveAction(MemberDto member)
    {
        if (!_canManageMembers)
        {
            return false;
        }

        if (IsCurrentUserMember(member))
        {
            return false;
        }

        var actor = ResolveCurrentActorMember();
        if (actor is null)
        {
            return false;
        }

        var actorRank = ResolveMemberRoleRank(actor.RoleName);
        var targetRank = ResolveMemberRoleRank(member.RoleName);

        if (targetRank <= 1 && actorRank >= targetRank)
        {
            return false;
        }

        if (actorRank >= targetRank && targetRank < 99)
        {
            return false;
        }

        return true;
    }

    private MemberDto? ResolveCurrentActorMember()
    {
        if (_currentUserId.HasValue)
        {
            var byUserId = Members.FirstOrDefault(x => x.UserId == _currentUserId.Value);
            if (byUserId is not null)
            {
                return byUserId;
            }
        }

        if (!string.IsNullOrWhiteSpace(_currentUserEmail))
        {
            return Members.FirstOrDefault(x =>
                string.Equals(x.Email, _currentUserEmail, StringComparison.OrdinalIgnoreCase));
        }

        return null;
    }

    private static int ResolveMemberRoleRank(string? roleName)
    {
        if (string.IsNullOrWhiteSpace(roleName))
        {
            return 99;
        }

        return roleName.Trim().ToUpperInvariant() switch
        {
            "PRESIDENT" => 0,
            "OWNER" => 0,
            "CHAIRMAN" => 0,
            "FOUNDER" => 0,
            "VICEPRESIDENT" => 1,
            "MANAGER" => 2,
            "ADMIN" => 2,
            "MODERATOR" => 3,
            "MEMBER" => 10,
            _ => 10
        };
    }

    private async Task LeaveOrganization()
    {
        if (!CurrentOrganizationId.HasValue)
        {
            Snackbar.Add("Khong tim thay to chuc hien tai.", Severity.Warning);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", "Ban muon roi khoi to chuc nay?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await MemberService.LeaveOrganizationAsync(CurrentOrganizationId.Value);
            Snackbar.Add("Ban da roi khoi to chuc.", Severity.Success);
            Navigation.NavigateTo("/user/organizations", forceLoad: true);
        }
        catch (NotSupportedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the roi to chuc: {ex.Message}", Severity.Error);
        }
    }

    private void OpenMemberProfile(MemberDto member)
    {
        if (!CanOpenMemberProfile(member))
        {
            Snackbar.Add("Thong tin user profile chua san sang tu live member API.", Severity.Info);
            return;
        }

        Navigation.NavigateTo($"/user/profile/{member.UserId:D}");
    }

    private async Task<Guid?> ResolveCurrentUserIdAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdText = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(userIdText, out var userId) ? userId : null;
    }

    private async Task<string?> ResolveCurrentUserEmailAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var email = authState.User.FindFirst(ClaimTypes.Email)?.Value;
        return string.IsNullOrWhiteSpace(email) ? null : email.Trim();
    }

    private bool IsCurrentUserMember(MemberDto member)
    {
        if (_currentUserId.HasValue && member.UserId == _currentUserId.Value)
        {
            return true;
        }

        return !string.IsNullOrWhiteSpace(_currentUserEmail)
            && !string.IsNullOrWhiteSpace(member.Email)
            && string.Equals(member.Email, _currentUserEmail, StringComparison.OrdinalIgnoreCase);
    }

    private static bool CanOpenMemberProfile(MemberDto member)
        => member.UserId != Guid.Empty;

    private string GetDepartmentName(Guid? departmentId)
    {
        if (!departmentId.HasValue)
        {
            return "Chua co phong ban";
        }

        return Departments.FirstOrDefault(x => x.Id == departmentId.Value)?.DeptName ?? "Khong xac dinh";
    }

    private static string GetAvatar(string displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return "NA";
        }

        var parts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
        {
            return parts[0][0].ToString().ToUpperInvariant();
        }

        return string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }
}
