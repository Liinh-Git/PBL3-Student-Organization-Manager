@using Org.Frontend.ViewModels

<div class="modal-overlay" @onclick="OnClose">
    <div class="modal-content" @onclick:stopPropagation="true">
        <div class="modal-header">
            <h2>Chi tiết đơn đăng ký</h2>
            <button class="close-btn" @onclick="OnClose">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="modal-body">
            @* ---- Thông tin người nộp ---- *@
            <div class="applicant-section">
                    <img src="@(Detail.AvatarUrl ?? "/images/mockimages/AvtUser/Avt1.jpg")" alt="@Detail.UserName" />
                <div class="applicant-meta">
                    <h3>@Detail.UserName</h3>
                    <p>@Detail.Email</p>
                    <p class="time-label">Nop don: @Detail.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>

            @if (string.Equals(Detail.RequestType, "JOIN", StringComparison.OrdinalIgnoreCase))
            {
                @* ---- Chi tiết đơn xin tham gia ---- *@
                <div class="detail-fields">
                    <div class="field-row two-col">
                        <div class="field-group">
                            <label>Ban mong muon</label>
                            <p class="field-value">@(Detail.DesiredDepartment ?? "Chua chon")</p>
                        </div>
                        <div class="field-group">
                            <label>Vi tri cu the</label>
                            <p class="field-value">@(Detail.DesiredPosition ?? "Chua ghi")</p>
                        </div>
                    </div>

                    <div class="field-group">
                        <label>Kinh nghiem hien co</label>
                        <p class="field-value multiline">@(Detail.Experience ?? "Khong co thong tin.")</p>
                    </div>

                    <div class="field-group">
                        <label>Ky nang noi bat / Diem manh</label>
                        <p class="field-value multiline">@(Detail.Strengths ?? "Khong co thong tin.")</p>
                    </div>

                    <div class="field-group">
                        <label>Ly do muon tham gia CLB</label>
                        <p class="field-value multiline">@(Detail.Reason ?? "Khong co thong tin.")</p>
                    </div>
                </div>
            }
            else
            {
                @* ---- Yêu cầu khác ---- *@
                <div class="detail-fields">
                    <div class="field-group">
                        <label>Tieu de</label>
                        <p class="field-value">@(Detail.Title ?? "Khong co tieu de")</p>
                    </div>
                    <div class="field-group">
                        <label>Noi dung</label>
                        <p class="field-value multiline">@(Detail.Message ?? "Khong co noi dung.")</p>
                    </div>
                </div>
            }
        </div>

        <div class="modal-footer">
            <button class="btn-cancel" @onclick="OnClose">Dong</button>
            <button class="btn-reject" @onclick="OnReject">Tu choi</button>
            <button class="btn-approve" @onclick="OnApprove">Chap nhan</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public RequestDetailViewModel Detail { get; set; } = default!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnApprove { get; set; }

    [Parameter]
    public EventCallback OnReject { get; set; }
}
