@page "/org-overview"
@inject IDialogService DialogService
@inject IUserDashboardService DashboardService
@inject Org.Frontend.Services.Organizations.IOrganizationService OrganizationService
@inject Org.Frontend.Services.Events.IEventService EventService
@inject NavigationManager Navigation
@using Org.Frontend.Services.Dashboard
@using Org.Frontend.Services.Organizations
@using Org.Frontend.ViewModels

<PageTitle>@(_detail?.Name ?? "Tổng quan tổ chức")</PageTitle>

<div class="org-overview-page">
    @if (_detail == null)
    {
        <div class="loading-state">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <p>Đang tải thông tin tổ chức...</p>
        </div>
    }
    else
    {
        <div class="org-container">
            
            @* ---- HERO SECTION ---- *@
            <section class="hero-section">
                <div class="hero-cover">
                    <img src="@(_detail.CoverUrl)" alt="Cover" />
                    <button class="btn-edit-cover"><MudIcon Icon="@Icons.Material.Outlined.Edit" /> Edit Cover</button>
                </div>
                <div class="hero-brand-row">
                    <div class="brand-identity">
                        <div class="brand-logo">
                            <img src="@(_detail.AvatarUrl)" alt="Logo" />
                        </div>
                        <div class="brand-title">
                            <h1>@_detail.Name</h1>
                            <p>Tổ chức sinh viên - Kiến tạo những giá trị bền vững và phát triển kỹ năng cộng đồng.</p>
                        </div>
                    </div>
                    <div class="brand-actions">
                        <button class="btn-quick-edit">Quick Edit</button>
                        <button class="btn-share"><MudIcon Icon="@Icons.Material.Filled.Share" /></button>
                    </div>
                </div>
            </section>

            @* ---- STATS ROW ---- *@
            <section class="stats-row">
                <div class="stat-card white-card">
                    <span class="stat-kicker">LOCATION</span>
                    <div class="stat-content">
                        <div class="stat-icon-wrap"><MudIcon Icon="@Icons.Material.Filled.LocationOn" /></div>
                        <div class="stat-text">
                            <strong>@(_detail.Location ?? "Vietnam")</strong>
                        </div>
                    </div>
                </div>

                <div class="stat-card white-card">
                    <span class="stat-kicker">TOTAL MEMBERS</span>
                    <div class="stat-content">
                        <div class="stat-icon-wrap"><MudIcon Icon="@Icons.Material.Filled.Person" /></div>
                        <div class="stat-text">
                            <strong>@(_detail.TotalMembers.ToString("N0"))</strong>
                            <span>Members</span>
                        </div>
                    </div>
                </div>

                <div class="stat-card dark-card">
                    <span class="stat-kicker">NGÀY THÀNH LẬP</span>
                    <div class="stat-dark-val">@_detail.FoundedDate.ToString("dd/MM/yyyy")</div>
                    <span class="stat-dark-sub">Thông tin tổ chức đã được xác thực</span>
                </div>
            </section>

            @* ---- MAIN CONTENT GRID ---- *@
            <div class="content-grid">
                
                @* LEFT COLUMN *@
                <div class="left-column">
                    
                    @* General Information *@
                    <div class="section-block">
                        <div class="section-title-wrap">
                            <h2>General Information</h2>
                        </div>
                        <div class="general-info-card">
                            <p>@_detail.Description</p>
                            <p>Sứ mệnh cốt lõi của chúng tôi xoay quanh ba trụ cột: Giáo dục Bền vững, Gắn kết Cộng đồng và Vận động Chính sách. Chúng tôi thường xuyên tổ chức các buổi workshop, chiến dịch tình nguyện và hợp tác để tạo ra tác động rõ rệt.</p>
                        </div>
                    </div>

                    @* Activity Timeline *@
                    <div class="section-block">
                        <div class="section-title-wrap">
                            <h2>Activity Timeline</h2>
                        </div>
                        <div class="timeline-zigzag">
                            <div class="timeline-line"></div>
                            @for (int i = 0; i < _detail.Timeline.Take(4).Count(); i++)
                            {
                                var item = _detail.Timeline[i];
                                bool isLeft = i % 2 != 0;
                                <div class="timeline-row @(isLeft ? "left-side" : "right-side")">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-card">
                                        <span class="t-month">@item.Month</span>
                                        <h4>@item.Title</h4>
                                        <p>@item.Description</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @* Ongoing Campaigns (Đã cập nhật Pager và 3 item/hàng) *@
                    <div class="section-block">
                        <div class="section-title-wrap space-between">
                            <h2>Ongoing Campaigns</h2>
                            @if (_ongoingEvents.Any())
                            {
                                <div class="pager">
                                    <button class="pager-btn" @onclick="PreviousOngoingPage" disabled="@(!CanGoPreviousOngoing)">
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" />
                                    </button>
                                    <span class="pager-text">@OngoingPageDisplay/@OngoingPageCount</span>
                                    <button class="pager-btn" @onclick="NextOngoingPage" disabled="@(!CanGoNextOngoing)">
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
                                    </button>
                                </div>
                            }
                        </div>
                        <div class="ongoing-grid">
                            @if (!_ongoingEvents.Any())
                            {
                                <p style="color:#64748b; padding-left: 10px;">Hiện tại chưa có chiến dịch/sự kiện nào đang diễn ra.</p>
                            }
                            @foreach (var ev in OngoingPageItems)
                            {
                                <div class="event-modern-card">
                                    <div class="event-cover">
                                        <span class="event-date-badge">@ev.StartDate.ToString("MMM yyyy").ToUpper()</span>
                                        <img src="@(ev.ImageUrl ?? "/images/banners/org-banner.jpg")" alt="Event cover" />
                                    </div>
                                    <div class="event-body">
                                        <h4>@ev.Name</h4>
                                        <p>@ev.Description</p>
                                        <div class="event-footer">
                                            <div class="member-bubbles">
                                                <div class="bubble"></div><div class="bubble"></div><div class="bubble"></div>
                                                <span class="bubble-count">+@ev.ParticipantCount</span>
                                            </div>
                                            <button class="btn-details" @onclick="() => NavigateToEvent(ev.Id)">Xem chi tiết &rarr;</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                </div>

                @* RIGHT COLUMN *@
                <div class="right-column">
                    <div class="section-block">
                        <div class="section-title-wrap space-between">
                            <h2>Leadership</h2>
                            <a href="/org/members" class="view-all">View All</a>
                        </div>
                        <div class="leadership-card">
                            @foreach (var admin in _detail.Admins.Take(4))
                            {
                                <div class="leader-row">
                                    <img src="@admin.Avatar" alt="Avatar" />
                                    <div class="leader-info">
                                        <strong>@admin.Name</strong>
                                        <span>@admin.Role</span>
                                    </div>
                                    <button class="btn-msg"><MudIcon Icon="@Icons.Material.Filled.Mail" /></button>
                                </div>
                            }
                        </div>
                    </div>

                    @if (!_isMember)
                    {
                        <div class="join-banner">
                            <h3>Tham gia cùng chúng tôi</h3>
                            <p>Đăng ký thành viên để nhận thông báo về những hoạt động mới nhất của tổ chức.</p>
                            <button class="btn-join-org" @onclick="OpenJoinDialogAsync">Tham gia CLB</button>
                        </div>
                    }
                </div>

            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "orgId")]
    public Guid? OrganizationId { get; set; }

    private OrganizationDetailViewModel? _detail;
    private List<EventViewModel> _ongoingEvents = [];
    private bool _isMember = false;

    // ---- Pagination logic cho Ongoing Campaigns ----
    private const int OngoingPageSize = 3;
    private int _ongoingPageIndex = 0;

    private int OngoingPageCount => GetPageCount(_ongoingEvents.Count, OngoingPageSize);
    private int OngoingPageDisplay => Math.Min(_ongoingPageIndex + 1, OngoingPageCount);
    private bool CanGoPreviousOngoing => _ongoingPageIndex > 0;
    private bool CanGoNextOngoing => _ongoingPageIndex < OngoingPageCount - 1;

    private IReadOnlyList<EventViewModel> OngoingPageItems => _ongoingEvents
        .Skip(_ongoingPageIndex * OngoingPageSize)
        .Take(OngoingPageSize)
        .ToList();

    private static readonly IReadOnlyList<string> PreferredDepartments =
    [
        "Ban truyền thông", "Ban sự kiện", "Ban kỹ thuật", "Ban nhân sự", "Ban tài chính"
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (!OrganizationId.HasValue) return;

        try
        {
            _detail = await OrganizationService.GetOrganizationDetailAsync(OrganizationId.Value);
            var allEvents = await EventService.GetEventsAsync(OrganizationId.Value);
            var today = DateOnly.FromDateTime(DateTime.Today);
            
            _ongoingEvents = allEvents.Where(e => e.StartDate <= today && e.EndDate >= today).ToList();
            
            // Demo data nếu không có sự kiện nào
            if (!_ongoingEvents.Any())
            {
                _ongoingEvents = allEvents.Where(e => e.StartDate > today).OrderBy(e => e.StartDate).Take(5).ToList();
            }

            var dashboard = await DashboardService.GetDashboardAsync();
            _isMember = dashboard.Organizations.Any(x => x.OrganizationId == OrganizationId.Value);
            
            _ongoingPageIndex = 0; // Reset page index
        }
        catch { }
    }

    private void PreviousOngoingPage() { if (CanGoPreviousOngoing) _ongoingPageIndex--; }
    private void NextOngoingPage() { if (CanGoNextOngoing) _ongoingPageIndex++; }

    private static int GetPageCount(int totalItems, int pageSize)
    {
        if (totalItems <= 0) return 1;
        return (int)Math.Ceiling(totalItems / (double)pageSize);
    }

    private void NavigateToEvent(Guid eventId)
    {
        Navigation.NavigateTo($"/events/{eventId}");
    }

    private async Task OpenJoinDialogAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(JoinOrganizationDialog.OrganizationName)] = _detail?.Name ?? "Tổ chức",
            [nameof(JoinOrganizationDialog.PreferredDepartments)] = PreferredDepartments,
            [nameof(JoinOrganizationDialog.Prefill)] = new JoinOrganizationDialog.JoinOrganizationRequest
            {
                PreferredDepartment = PreferredDepartments[0],
                DesiredPosition = "Thành viên",
                Experience = "Có mong muốn học hỏi và phát triển bản thân.",
                Strengths = "Nhiệt tình, trách nhiệm.",
                Reason = $"Tôi muốn đóng góp sức trẻ cho {_detail?.Name}."
            }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<JoinOrganizationDialog>("Đăng ký tham gia", parameters, options);
    }
}