@page "/org-overview"
@inject Org.Frontend.Services.Organizations.IOrganizationService OrganizationService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@using Org.Frontend.Services.Organizations
@using Org.Frontend.Components.Pages.Organizations

<PageTitle>@(_overview?.Name ?? "Organization Overview")</PageTitle>

<div class="org-overview-page">
    @if (_isLoading)
    {
        <section class="page-state">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <p>Dang tai thong tin to chuc...</p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="page-state error">
            <h2>Khong tai duoc thong tin to chuc</h2>
            <p>@_errorMessage</p>
            <button type="button" class="ghost-btn" @onclick="ReloadAsync">Thu lai</button>
        </section>
    }
    else if (_overview is not null)
    {
        <div class="overview-shell">
            <section class="hero">
                <img class="hero-cover" src="@ResolveCover(_overview)" alt="@_overview.Name" />
                <div class="hero-top-actions">
                    <button type="button" class="ghost-btn" @onclick="HandleBack">Quay lai</button>
                    @if (_overview.ViewerPermission.CanAccessWorkspace)
                    {
                        <button type="button" class="ghost-btn" @onclick="EnterWorkspace">Vao workspace</button>
                    }
                    @if (_overview.ViewerPermission.CanEditOverview)
                    {
                        <button type="button" class="primary-btn" @onclick="ToggleEditMode">
                            @(_isEditMode ? "Dong sua" : "Chinh sua")
                        </button>
                    }
                </div>
                <div class="hero-content">
                    <img class="hero-avatar" src="@ResolveAvatar(_overview)" alt="@_overview.Name" />
                    <div class="hero-text">
                        <h1>@_overview.Name</h1>
                        <p>@(string.IsNullOrWhiteSpace(_overview.ShortDescription) ? "Organization overview" : _overview.ShortDescription)</p>
                        <span class="mode-chip @GetViewerModeClass(_overview.ViewerPermission.ViewerMode)">
                            @GetViewerModeLabel(_overview.ViewerPermission)
                        </span>
                    </div>
                </div>
            </section>

            <section class="stats-grid">
                <article class="stat-card"><span>Thanh vien</span><strong>@_overview.MemberCount</strong></article>
                <article class="stat-card"><span>Su kien</span><strong>@_overview.EventCount</strong></article>
                <article class="stat-card"><span>Su kien sap toi</span><strong>@_overview.UpcomingEventCount</strong></article>
                <article class="stat-card"><span>Task dang mo</span><strong>@_overview.ActiveTaskCount</strong></article>
                <article class="stat-card"><span>Milestones</span><strong>@_overview.MilestoneCount</strong></article>
            </section>

            <div class="main-grid">
                <div class="main-column">
                    <section class="block">
                        <div class="block-head">
                            <h2>Thong tin chung</h2>
                            @if (_isSaving)
                            {
                                <span class="saving">Dang luu...</span>
                            }
                        </div>

                        @if (_isEditMode && _overview.ViewerPermission.CanEditOverview)
                        {
                            <EditForm Model="_editModel" OnValidSubmit="SaveOverviewAsync" class="edit-form">
                                <label>Ten to chuc</label>
                                <InputText @bind-Value="_editModel.Name" />

                                <label>Mo ta ngan</label>
                                <InputText @bind-Value="_editModel.ShortDescription" />

                                <label>Mo ta day du</label>
                                <InputTextArea @bind-Value="_editModel.Description" />

                                <label>Mission</label>
                                <InputTextArea @bind-Value="_editModel.Mission" />

                                <label>Vision</label>
                                <InputTextArea @bind-Value="_editModel.Vision" />

                                <label>Dia diem</label>
                                <InputText @bind-Value="_editModel.Location" />

                                <label>Email lien he</label>
                                <InputText @bind-Value="_editModel.ContactEmail" />

                                <label>So dien thoai</label>
                                <InputText @bind-Value="_editModel.ContactPhone" />

                                <label>Website</label>
                                <InputText @bind-Value="_editModel.WebsiteUrl" />

                                <label>Facebook</label>
                                <InputText @bind-Value="_editModel.FacebookUrl" />

                                <label>Avatar URL (wwwroot)</label>
                                <InputText @bind-Value="_editModel.AvatarUrl" />

                                <label>Cover URL (wwwroot)</label>
                                <InputText @bind-Value="_editModel.CoverUrl" />

                                <label>Tags (comma separated)</label>
                                <InputText @bind-Value="_tagEditor" />

                                <div class="edit-actions">
                                    <button type="button" class="ghost-btn" @onclick="CancelEdit" disabled="@_isSaving">Huy</button>
                                    <button type="submit" class="primary-btn" disabled="@_isSaving">Luu thay doi</button>
                                </div>
                            </EditForm>
                        }
                        else
                        {
                            <p>@(string.IsNullOrWhiteSpace(_overview.Description) ? "Chua co mo ta." : _overview.Description)</p>
                            @if (!string.IsNullOrWhiteSpace(_overview.Mission))
                            {
                                <h3>Mission</h3>
                                <p>@_overview.Mission</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(_overview.Vision))
                            {
                                <h3>Vision</h3>
                                <p>@_overview.Vision</p>
                            }
                        }
                    </section>

                    <section class="block">
                        <h2>Lich su hoat dong</h2>
                        @if (_overview.Timeline.Count == 0)
                        {
                            <p class="hint">Chua co du lieu timeline.</p>
                        }
                        else
                        {
                            <div class="timeline-scroll">
                                @foreach (var item in _overview.Timeline)
                                {
                                    <article class="timeline-card">
                                        <span>@item.PeriodLabel</span>
                                        <h4>@item.Title</h4>
                                        <p>@item.Description</p>
                                    </article>
                                }
                            </div>
                        }
                    </section>

                    <section class="block">
                        <h2>Su kien noi bat</h2>
                        @if (_overview.HighlightEvents.Count == 0)
                        {
                            <p class="hint">Khong co su kien sap toi.</p>
                        }
                        else
                        {
                            <div class="event-scroll">
                                @foreach (var item in _overview.HighlightEvents)
                                {
                                    <button type="button" class="event-card" @onclick="() => OpenEvent(item.EventId)">
                                        <img src="@(item.ImageUrl ?? "/images/mockimages/Org1/Card1.jpg")" alt="@item.Name" />
                                        <div>
                                            <strong>@item.Name</strong>
                                            <span>@item.StartDate.ToString("dd/MM/yyyy")</span>
                                            <small>@(string.IsNullOrWhiteSpace(item.Location) ? "No location" : item.Location)</small>
                                        </div>
                                    </button>
                                }
                            </div>
                        }
                    </section>
                </div>

                <aside class="side-column">
                    <section class="block">
                        <h2>Lanh dao</h2>
                        @if (_overview.Leadership.Count == 0)
                        {
                            <p class="hint">Chua co du lieu lanh dao.</p>
                        }
                        else
                        {
                            @foreach (var leader in _overview.Leadership)
                            {
                                <div class="person-row">
                                    <img src="@(leader.Avatar ?? "/images/mockimages/AvtUser/Avt1.jpg")" alt="@leader.Name" />
                                    <div>
                                        <strong>@leader.Name</strong>
                                        <span>@leader.Role</span>
                                    </div>
                                    <button type="button" class="icon-btn" @onclick="() => MessageUser(leader.UserId)">
                                        <MudIcon Icon="@Icons.Material.Filled.Chat" />
                                    </button>
                                </div>
                            }
                        }
                    </section>

                    <section class="block">
                        <h2>Phong ban</h2>
                        @if (_overview.Departments.Count == 0)
                        {
                            <p class="hint">Chua co phong ban.</p>
                        }
                        else
                        {
                            @foreach (var dept in _overview.Departments)
                            {
                                <div class="dept-row">
                                    <span>@dept.Name</span>
                                    <strong>@dept.MemberCount</strong>
                                </div>
                            }
                        }
                    </section>

                    <section class="block">
                        <h2>Lien he</h2>
                        <div class="contact-line"><span>Email</span><strong>@(_overview.ContactEmail ?? "N/A")</strong></div>
                        <div class="contact-line"><span>Phone</span><strong>@(_overview.ContactPhone ?? "N/A")</strong></div>
                        <div class="contact-line"><span>Website</span><strong>@(_overview.WebsiteUrl ?? "N/A")</strong></div>
                        <div class="contact-line"><span>Facebook</span><strong>@(_overview.FacebookUrl ?? "N/A")</strong></div>
                    </section>

                    @if (_overview.Tags.Count > 0)
                    {
                        <section class="block">
                            <h2>Tags</h2>
                            <div class="tag-wrap">
                                @foreach (var tag in _overview.Tags)
                                {
                                    <span class="tag">@tag</span>
                                }
                            </div>
                        </section>
                    }

                    @if (!_overview.ViewerPermission.IsMember)
                    {
                        <section class="join-banner">
                            <h3>Ban chua la thanh vien</h3>
                            <p>Gui yeu cau tham gia de truy cap workspace noi bo.</p>
                            <button type="button" class="primary-btn" @onclick="OpenJoinDialogAsync">Gui yeu cau tham gia</button>
                        </section>
                    }
                </aside>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "orgId")]
    public Guid? OrganizationId { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "edit")]
    public int? Edit { get; set; }

    private OrganizationOverviewViewModel? _overview;
    private UpdateOrganizationOverviewRequest _editModel = new();
    private bool _isLoading;
    private bool _isSaving;
    private bool _isEditMode;
    private string? _errorMessage;
    private string _tagEditor = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (!OrganizationId.HasValue)
        {
            _errorMessage = "Missing organization id.";
            _overview = null;
            return;
        }

        _isLoading = true;
        _errorMessage = null;
        _isEditMode = false;
        try
        {
            _overview = await OrganizationService.GetOrganizationOverviewAsync(OrganizationId.Value);
            SeedEditModel();
            if (Edit == 1 && _overview.ViewerPermission.CanEditOverview)
                _isEditMode = true;
        }
        catch (Exception ex)
        {
            _overview = null;
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SeedEditModel()
    {
        if (_overview is null)
            return;

        _editModel = new UpdateOrganizationOverviewRequest
        {
            Name = _overview.Name,
            ShortDescription = _overview.ShortDescription,
            Description = _overview.Description,
            Mission = _overview.Mission,
            Vision = _overview.Vision,
            Tags = _overview.Tags.ToList(),
            Location = _overview.Location,
            ContactEmail = _overview.ContactEmail,
            ContactPhone = _overview.ContactPhone,
            WebsiteUrl = _overview.WebsiteUrl,
            FacebookUrl = _overview.FacebookUrl,
            AvatarUrl = _overview.AvatarUrl,
            CoverUrl = _overview.CoverUrl
        };
        _tagEditor = string.Join(", ", _overview.Tags);
    }

    private void ToggleEditMode()
    {
        _isEditMode = !_isEditMode;
        if (_isEditMode)
            SeedEditModel();
    }

    private void CancelEdit()
    {
        _isEditMode = false;
        SeedEditModel();
    }

    private async Task SaveOverviewAsync()
    {
        if (_overview is null || !OrganizationId.HasValue)
            return;

        _isSaving = true;
        _errorMessage = null;

        try
        {
            _editModel.Tags = _tagEditor
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            _overview = await OrganizationService.UpdateOrganizationOverviewAsync(OrganizationId.Value, _editModel);
            _isEditMode = false;
            SeedEditModel();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void HandleBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith("/", StringComparison.Ordinal))
        {
            Navigation.NavigateTo(ReturnUrl);
            return;
        }

        Navigation.NavigateTo("/home");
    }

    private void EnterWorkspace()
    {
        if (!OrganizationId.HasValue)
            return;
        Navigation.NavigateTo($"/org/members?orgId={OrganizationId.Value:D}");
    }

    private void OpenEvent(Guid eventId)
    {
        if (_overview?.ViewerPermission.IsMember == true && OrganizationId.HasValue)
        {
            Navigation.NavigateTo($"/org/events/{eventId:D}?orgId={OrganizationId.Value:D}");
            return;
        }

        Navigation.NavigateTo($"/events/{eventId:D}");
    }

    private void MessageUser(Guid userId)
        => Navigation.NavigateTo($"/user/messages/user/{userId:D}");

    private async Task OpenJoinDialogAsync()
    {
        if (_overview is null)
            return;

        var preferredDepartments = _overview.Departments
            .Select(x => x.Name)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (preferredDepartments.Count == 0)
            preferredDepartments.Add("Thanh vien");

        var parameters = new DialogParameters
        {
            [nameof(JoinOrganizationDialog.OrganizationName)] = _overview.Name,
            [nameof(JoinOrganizationDialog.PreferredDepartments)] = preferredDepartments,
            [nameof(JoinOrganizationDialog.Prefill)] = new JoinOrganizationDialog.JoinOrganizationRequest
            {
                PreferredDepartment = preferredDepartments[0],
                DesiredPosition = "Thanh vien",
                Experience = "San sang dong gop va phat trien cung to chuc.",
                Strengths = "Ky luat, tinh than hop tac.",
                Reason = $"Toi muon dong gop cho {_overview.Name}."
            }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<JoinOrganizationDialog>("Dang ky tham gia", parameters, options);
    }

    private static string ResolveCover(OrganizationOverviewViewModel model)
        => string.IsNullOrWhiteSpace(model.CoverUrl) ? "/images/mockimages/Org1/Bia.jpg" : model.CoverUrl;

    private static string ResolveAvatar(OrganizationOverviewViewModel model)
        => string.IsNullOrWhiteSpace(model.AvatarUrl) ? "/images/mockimages/Org1/Avt.jpg" : model.AvatarUrl;

    private static string GetViewerModeClass(string mode)
        => mode switch
        {
            "INTERNAL_WRITE" => "mode-write",
            "INTERNAL_READ" => "mode-read",
            _ => "mode-external"
        };

    private static string GetViewerModeLabel(OrganizationViewerPermissionViewModel permission)
        => permission.ViewerMode switch
        {
            "INTERNAL_WRITE" => $"Noi bo - Co quyen chinh sua ({permission.MemberRole})",
            "INTERNAL_READ" => $"Noi bo - Chi xem ({permission.MemberRole})",
            _ => "Ben ngoai - Chi xem"
        };
}
