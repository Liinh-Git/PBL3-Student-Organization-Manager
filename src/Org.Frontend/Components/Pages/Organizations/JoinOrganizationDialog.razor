@using System.ComponentModel.DataAnnotations

<MudDialog DefaultFocus="DefaultFocus.FirstChild">
    <DialogContent>
        <section class="join-dialog-wrap">
            <header class="join-dialog-head">
                <h3>Đơn xin tham gia</h3>
                <p>Ứng tuyển: <span>@OrganizationName</span></p>
            </header>

            <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />

                <div class="form-body">
                    <div class="join-grid">
                        <div class="input-group">
                            <label>Ban mong muốn *</label>
                            <select @bind="_model.PreferredDepartment">
                                @foreach (var department in PreferredDepartments)
                                {
                                    <option value="@department">@department</option>
                                }
                            </select>
                        </div>

                        <div class="input-group">
                            <label>Vị trí cụ thể *</label>
                            <input @bind="_model.DesiredPosition" placeholder="VD: Cộng tác viên, Lập trình Web..." />
                        </div>
                    </div>

                    <div class="input-group full-row">
                        <label>Kinh nghiệm hiện có</label>
                        <textarea rows="2" @bind="_model.Experience" placeholder="VD: Đã tham gia hoạt động CLB tại trường và có kinh nghiệm phối hợp đội nhóm..."></textarea>
                    </div>

                    <div class="input-group full-row">
                        <label>Kỹ năng nổi bật / Điểm mạnh</label>
                        <textarea rows="2" @bind="_model.Strengths" placeholder="VD: Giao tiếp, tổ chức công việc, làm việc nhóm và xử lý vấn đề..."></textarea>
                    </div>

                    <div class="input-group full-row">
                        <label>Lý do muốn tham gia CLB *</label>
                        <textarea rows="3" @bind="_model.Reason" placeholder="VD: Tôi muốn đóng góp cho @OrganizationName và phát triển bản thân qua các dự án..."></textarea>
                    </div>
                </div>
            </EditForm>
        </section>
    </DialogContent>

    <DialogActions>
        <div class="dialog-footer">
            <MudButton OnClick="Cancel" Class="btn-cancel" DisableElevation="true">Hủy bỏ</MudButton>
            <MudButton OnClick="SubmitAsync" Class="btn-submit" DisableElevation="true">Gửi yêu cầu</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string OrganizationName { get; set; } = "Câu lạc bộ";
    [Parameter] public IReadOnlyList<string> PreferredDepartments { get; set; } =
    [
        "Ban truyền thông (Media)",
        "Ban sự kiện (Event)",
        "Ban kỹ thuật / IT",
        "Ban nhân sự",
        "Ban tài chính"
    ];
    [Parameter] public JoinOrganizationRequest? Prefill { get; set; }

    private JoinOrganizationRequest _model = new();

    protected override void OnInitialized()
    {
        // Khởi tạo model với các chuỗi rỗng để HTML hiển thị placeholder
        _model = Prefill is null
            ? BuildDefault()
            : new JoinOrganizationRequest
            {
                PreferredDepartment = Prefill.PreferredDepartment,
                DesiredPosition = Prefill.DesiredPosition ?? "",
                Experience = Prefill.Experience ?? "",
                Strengths = Prefill.Strengths ?? "",
                Reason = Prefill.Reason ?? ""
            };
    }

    private JoinOrganizationRequest BuildDefault()
    {
        var preferredDepartment = PreferredDepartments.Count == 0
            ? string.Empty
            : PreferredDepartments[0];
        
        // Trả về chuỗi rỗng thay vì nhét text vào đây
        return new JoinOrganizationRequest
        {
            PreferredDepartment = preferredDepartment,
            DesiredPosition = "",
            Experience = "",
            Strengths = "",
            Reason = ""
        };
    }

    private Task SubmitAsync()
    {
        MudDialog.Close(DialogResult.Ok(_model));
        return Task.CompletedTask;
    }

    private void Cancel() => MudDialog.Cancel();

    public sealed class JoinOrganizationRequest
    {
        [Required]
        public string PreferredDepartment { get; set; } = string.Empty;

        [Required]
        public string DesiredPosition { get; set; } = string.Empty;

        [Required]
        public string Experience { get; set; } = string.Empty;

        [Required]
        public string Strengths { get; set; } = string.Empty;

        [Required]
        public string Reason { get; set; } = string.Empty;
    }
}