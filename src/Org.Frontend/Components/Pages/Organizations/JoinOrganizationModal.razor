@inject Org.Frontend.Services.Departments.IDepartmentService DepartmentService
@inject Org.Frontend.Services.Requests.IRequestService RequestService
@using Org.Frontend.ViewModels

<div class="modal-overlay" @onclick="OnClose">
    <div class="modal-content" @onclick:stopPropagation="true">
        <div class="modal-header">
            <div>
                <h2>Dang ky tham gia</h2>
                <p class="modal-subtitle">Don xin tham gia</p>
                <p class="org-name-label">Ung tuyen: @OrganizationName</p>
            </div>
            <button class="close-btn" @onclick="OnClose">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="modal-body">
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="error-banner">@_errorMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(_successMessage))
            {
                <div class="success-banner">@_successMessage</div>
            }
            else
            {
                <div class="form-fields">
                    <div class="field-row two-col">
                        <div class="field-group">
                            <label>Ban mong muon *</label>
                            <select @bind="_form.DesiredDepartmentName" class="form-select">
                                <option value="">-- Chon ban --</option>
                                @foreach (var dept in _departments)
                                {
                                    <option value="@dept">@dept</option>
                                }
                            </select>
                        </div>
                        <div class="field-group">
                            <label>Vi tri cu the *</label>
                            <input type="text" @bind="_form.DesiredPosition" class="form-input" placeholder="VD: Cong tac vien" />
                        </div>
                    </div>

                    <div class="field-group">
                        <label>Kinh nghiem hien co</label>
                        <textarea @bind="_form.Experience" class="form-textarea" rows="3"
                                  placeholder="Mo ta kinh nghiem lien quan..."></textarea>
                    </div>

                    <div class="field-group">
                        <label>Ky nang noi bat / Diem manh</label>
                        <textarea @bind="_form.Strengths" class="form-textarea" rows="3"
                                  placeholder="Liet ke ky nang va diem manh..."></textarea>
                    </div>

                    <div class="field-group">
                        <label>Ly do muon tham gia CLB *</label>
                        <textarea @bind="_form.Reason" class="form-textarea" rows="4"
                                  placeholder="Chia se ly do ban muon tham gia..."></textarea>
                    </div>
                </div>
            }
        </div>

        <div class="modal-footer">
            <button class="btn-cancel" @onclick="OnClose">Huy bo</button>
            @if (string.IsNullOrWhiteSpace(_successMessage))
            {
                <button class="btn-submit" @onclick="HandleSubmit" disabled="@_isSubmitting">
                    @(_isSubmitting ? "Dang gui..." : "Gui yeu cau")
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Guid OrganizationId { get; set; }

    [Parameter]
    public string OrganizationName { get; set; } = "To chuc";

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnSubmitted { get; set; }

    private JoinRequestFormViewModel _form = new();
    private List<string> _departments = [];
    private bool _isSubmitting;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        _form.OrgId = OrganizationId;

        try
        {
            var depts = await DepartmentService.GetDepartments(OrganizationId);
            _departments = depts.Select(d => d.DeptName).Where(n => !string.IsNullOrWhiteSpace(n)).ToList();
        }
        catch
        {
            _departments = ["Media and PR", "Operations", "Technical"];
        }
    }

    private async Task HandleSubmit()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_form.Reason))
        {
            _errorMessage = "Vui long nhap ly do muon tham gia CLB.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.DesiredDepartmentName))
        {
            _errorMessage = "Vui long chon ban mong muon.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.DesiredPosition))
        {
            _errorMessage = "Vui long nhap vi tri cu the.";
            return;
        }

        _isSubmitting = true;
        try
        {
            await RequestService.SubmitJoinRequestAsync(_form);
            _successMessage = "Don dang ky da duoc gui thanh cong! Vui long cho duyet.";
            await OnSubmitted.InvokeAsync();
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch
        {
            _errorMessage = "Co loi xay ra. Vui long thu lai.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
