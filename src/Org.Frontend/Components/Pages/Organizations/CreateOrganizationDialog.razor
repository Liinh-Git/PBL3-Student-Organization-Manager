@using MudBlazor
@using Org.Frontend.Services.Organizations
@inject ISnackbar Snackbar

<MudDialog DisableSidePadding="true" Class="custom-dialog-border">
    <TitleContent>
        <div class="px-6 pt-4 pb-2">
            <MudText Typo="Typo.h5" Class="fw-bold mb-1" Style="color: #1e293b;">Tạo tổ chức mới</MudText>
            <MudText Typo="Typo.body2" Style="color: #64748b;">Khai báo thông tin cơ bản để thành lập một câu lạc bộ hoặc tổ chức mới.</MudText>
        </div>
    </TitleContent>
    
    <DialogContent>
        <div class="px-6">
            <MudForm @ref="_form">
                
                <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1" Style="color: #334155;">Tên tổ chức</MudText>
                <MudTextField T="string" Required="true" RequiredError="Vui lòng nhập tên tổ chức!"
                              @bind-Value="_model.Name" 
                              Placeholder="Ví dụ: CLB Âm nhạc Kora, Ban Truyền thông..."
                              Variant="Variant.Outlined" 
                              Margin="Margin.Dense" 
                              Class="mb-4" />
                
                <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1" Style="color: #334155;">Mô tả hoạt động</MudText>
                <MudTextField T="string" Required="true" RequiredError="Vui lòng nhập mô tả!"
                              Lines="3" 
                              @bind-Value="_model.Description" 
                              Placeholder="Giới thiệu ngắn gọn về mục đích, sứ mệnh và hoạt động của tổ chức..."
                              Variant="Variant.Outlined" 
                              Margin="Margin.Dense" 
                              Class="mb-4" />
                
                <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1" Style="color: #334155;">Địa điểm (Không bắt buộc)</MudText>
                <MudTextField T="string" 
                              @bind-Value="_model.Location"
                              Placeholder="Ví dụ: Tòa nhà A1, Đại học Bách Khoa..."
                              Variant="Variant.Outlined" 
                              Margin="Margin.Dense" 
                              Class="mb-4" />
                              
            </MudForm>
        </div>
    </DialogContent>
    
    <DialogActions>
        <div class="px-6 pb-4 pt-2 w-100 d-flex justify-end gap-3">
            <MudButton OnClick="Cancel" 
                       Variant="Variant.Filled" 
                       Style="background-color: #64748b; color: white; border-radius: 6px; text-transform: none; padding: 8px 20px; font-weight: 500;">
                Hủy bỏ
            </MudButton>
            <MudButton OnClick="Submit"
                       Variant="Variant.Filled" 
                       Style="background-color: #f97316; color: white; border-radius: 6px; text-transform: none; padding: 8px 28px; font-weight: 600;">
                Tạo ngay
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

<style>
    /* Ẩn label mặc định của MudBlazor */
    .mud-input-label {
        display: none !important;
    }
    
    /* Bo góc Dialog */
    .custom-dialog-border {
        border-radius: 12px !important;
    }
    
    /* Màu viền input */
    .mud-input-outlined-border {
        border-color: #cbd5e1 !important;
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    
    private CreateOrganizationViewModel _model = new();
    private MudForm _form = default!;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        // Ép Form kiểm tra tính hợp lệ
        await _form.Validate();

        if (_form.IsValid)
        {
            MudDialog.Close(DialogResult.Ok(_model));
        }
        else
        {
            // Nếu chưa nhập đủ, hiện thông báo lỗi ngay lập tức
            Snackbar.Add("Vui lòng điền đầy đủ các thông tin bắt buộc (*)", Severity.Error);
        }
    }
}