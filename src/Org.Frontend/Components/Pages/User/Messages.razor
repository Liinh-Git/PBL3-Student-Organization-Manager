@page "/user/messages"
@page "/user/messages/{ConversationId:guid}"
@page "/user/messages/user/{UserId:guid}"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web
@using Org.Frontend.Services.Messages
@rendermode InteractiveServer
@inject IMessageService MessageService
@inject MessageStateBridge MessageStateBridge
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Tin nhắn - Kora</PageTitle>

<div class="message-layout">
    @if (_isLoading)
    {
        <div class="empty-state">
            <div class="empty-state-content">
                <div class="empty-icon-wrapper">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
                <h3>Đang tải tin nhắn</h3>
                <p>Vui lòng chờ trong giây lát...</p>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="empty-state">
            <div class="empty-state-content">
                <div class="empty-icon-wrapper">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" />
                </div>
                <h3>Không thể tải cuộc trò chuyện</h3>
                <p>@_errorMessage</p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4 rounded-pill px-6" @onclick="ReloadAsync">Thử lại</MudButton>
            </div>
        </div>
    }
    else if (!_activeConversationId.HasValue)
    {
        <div class="empty-state">
            <div class="empty-state-content">
                <div class="empty-icon-wrapper">
                    <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Large" />
                </div>
                <h3>Tin nhắn của bạn</h3>
                <p>Chọn một cuộc trò chuyện từ danh sách bên trái để bắt đầu kết nối với bạn bè.</p>
            </div>
        </div>
    }
    else
    {
        <div class="chat-container">
            <header class="chat-header">
                <div class="chat-user-info">
                    <div class="avatar-wrapper">
                        <img src="@GetConversationAvatar()" alt="@GetConversationTitle()" />
                        <span class="status-indicator online"></span>
                    </div>
                    <div class="user-meta">
                        <h4>@GetConversationTitle()</h4>
                        <span class="user-status">@GetConversationSubtitle()</span>
                    </div>
                </div>
                <div class="chat-actions">
                    <button class="chat-action-btn" type="button"><MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" /></button>
                    <button class="chat-action-btn" type="button"><MudIcon Icon="@Icons.Material.Filled.VideoCall" Size="Size.Small" /></button>
                    <button class="chat-action-btn" type="button"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" /></button>
                </div>
            </header>

            <div class="chat-history">
                @if (_messages.Count == 0)
                {
                    <div class="chat-empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline" />
                        <p>Chưa có tin nhắn nào trong cuộc trò chuyện này.</p>
                    </div>
                }
                else
                {
                    @foreach (var msg in _messages)
                    {
                        var isMe = IsCurrentUser(msg);
                        <div class="message-row @(isMe ? "me" : "them")">
                            @if (!isMe)
                            {
                                <img src="@GetAvatar(msg.SenderAvatarUrl)" class="msg-avatar" alt="@msg.SenderName" />
                            }
                            <div class="message-bubble-wrapper">
                                <div class="message-bubble">
                                    @msg.Content
                                </div>
                                <span class="message-time">@FormatTime(msg.SentAt)</span>
                            </div>
                        </div>
                    }
                }
            </div>

            <footer class="chat-input-footer">
                <div class="input-actions-left">
                    <button class="input-action-btn" type="button"><MudIcon Icon="@Icons.Material.Filled.AddCircle" /></button>
                    <button class="input-action-btn" type="button"><MudIcon Icon="@Icons.Material.Filled.Image" /></button>
                </div>
                <div class="input-wrapper">
                    <input type="text"
                           placeholder="Nhập tin nhắn..."
                           @bind="_currentMessage"
                           @bind:event="oninput"
                           @onkeydown="HandleKeyDown"
                           disabled="@_isSending" />
                    <button class="emoji-btn" type="button"><MudIcon Icon="@Icons.Material.Filled.SentimentSatisfiedAlt" /></button>
                </div>
                <button class="send-btn @(CanSendMessage ? string.Empty : "disabled")"
                        type="button"
                        disabled="@(!CanSendMessage)"
                        @onclick="SendMessageAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Send" />
                </button>
            </footer>
        </div>
    }
</div>

@code {
    [Parameter] public Guid? ConversationId { get; set; }
    [Parameter] public Guid? UserId { get; set; }

    private Guid? _activeConversationId;
    private Guid? _currentUserId;
    private string _currentUserName = "Bạn";
    private string _currentMessage = string.Empty;
    private bool _isLoading;
    private bool _isSending;
    private string? _errorMessage;
    private List<MessageItem> _messages = [];
    private ConversationListItem? _activeConversation;

    private bool CanSendMessage => _activeConversationId.HasValue && !_isSending && !string.IsNullOrWhiteSpace(_currentMessage);

    protected override async Task OnParametersSetAsync()
    {
        await EnsureCurrentUserAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            if (UserId.HasValue)
            {
                var result = await MessageService.GetOrCreateDirectConversationAsync(UserId.Value);
                _activeConversationId = result.ConversationId;
                Navigation.NavigateTo($"/user/messages/{result.ConversationId:D}", replace: true);
            }
            else
            {
                _activeConversationId = ConversationId;
            }

            if (!_activeConversationId.HasValue)
            {
                _activeConversation = null;
                _messages = [];
                return;
            }

            var conversations = await MessageService.GetConversationsAsync();
            _activeConversation = conversations.FirstOrDefault(x => x.ConversationId == _activeConversationId.Value)
                ?? throw new InvalidOperationException("Bạn không có quyền truy cập cuộc trò chuyện này.");

            _messages = (await MessageService.GetMessagesAsync(_activeConversationId.Value)).ToList();
        }
        catch (Exception ex)
        {
            _activeConversation = null;
            _messages = [];
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SendMessageAsync()
    {
        if (!CanSendMessage || !_activeConversationId.HasValue || !_currentUserId.HasValue)
            return;

        _errorMessage = null;
        var rawContent = _currentMessage;
        var trimmedContent = rawContent.Trim();
        if (trimmedContent.Length == 0)
            return;

        _isSending = true;
        _currentMessage = string.Empty;

        var optimisticMessage = new MessageItem(
            Guid.NewGuid(),
            _activeConversationId.Value,
            _currentUserId.Value,
            _currentUserName,
            null,
            trimmedContent,
            DateTime.UtcNow,
            "TEXT",
            "SENT",
            DateTime.UtcNow,
            [_currentUserId.Value]);

        _messages.Add(optimisticMessage);

        try
        {
            var sentMessage = await MessageService.SendMessageAsync(_activeConversationId.Value, trimmedContent);
            var index = _messages.FindIndex(x => x.Id == optimisticMessage.Id);
            if (index >= 0)
                _messages[index] = sentMessage;

            if (_activeConversation is not null)
            {
                _activeConversation = _activeConversation with
                {
                    LastMessagePreview = sentMessage.Content,
                    LastMessageAt = sentMessage.SentAt
                };
            }

            MessageStateBridge.NotifyChanged();
        }
        catch (Exception ex)
        {
            _messages.RemoveAll(x => x.Id == optimisticMessage.Id);
            _currentMessage = rawContent;
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSending = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SendMessageAsync();
    }

    private async Task EnsureCurrentUserAsync()
    {
        if (_currentUserId.HasValue)
            return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _currentUserName = user.FindFirst(ClaimTypes.Name)?.Value ?? "Bạn";

        var rawUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(rawUserId, out var parsed))
            _currentUserId = parsed;
    }

    private bool IsCurrentUser(MessageItem item)
        => _currentUserId.HasValue && item.SenderId == _currentUserId.Value;

    private string GetConversationTitle()
        => _activeConversation?.Title ?? "Cuộc trò chuyện";

    private string GetConversationSubtitle()
        => string.IsNullOrWhiteSpace(_activeConversation?.Subtitle) ? "Đang hoạt động" : _activeConversation!.Subtitle!;

    private string GetConversationAvatar()
        => GetAvatar(_activeConversation?.AvatarUrl);

    private static string GetAvatar(string? avatarUrl)
        => string.IsNullOrWhiteSpace(avatarUrl) ? "/images/avatars/user.png" : avatarUrl;

    private static string FormatTime(DateTime sentAt)
        => sentAt.ToLocalTime().ToString("HH:mm");
}
