@page "/user/messages"
@page "/user/messages/{ConversationId:guid}"
@page "/user/messages/user/{UserId:guid}"
@inject NavigationManager Navigation

<PageTitle>Tin nhan</PageTitle>

<div class="message-layout">
    <div class="empty-state">
        <div class="empty-state-content">
            <h3>Tin nhan chua ho tro live API</h3>
            <p>Tinh nang message duoc tam khoa trong demo live.</p>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4 rounded-pill px-6" @onclick="BackToOrganizations">
                Ve to chuc cua toi
            </MudButton>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid? ConversationId { get; set; }
    [Parameter] public Guid? UserId { get; set; }

    private void BackToOrganizations()
        => Navigation.NavigateTo("/user/organizations");
}
