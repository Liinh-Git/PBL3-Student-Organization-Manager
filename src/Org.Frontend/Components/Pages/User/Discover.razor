@page "/user/discover"
@inject NavigationManager Navigation

<PageTitle>Discover</PageTitle>

<div class="discover-shell app-page">
    <section class="app-error">
        <h3>Discover chua ho tro live API</h3>
        <p>Tinh nang nay dang duoc tam khoa trong demo live.</p>
        <button type="button" class="app-button app-button--primary" @onclick="BackToOrganizations">Ve to chuc cua toi</button>
    </section>
</div>

@code {
    private void BackToOrganizations()
        => Navigation.NavigateTo("/user/organizations");
}
