@page "/user/discover"
@using Org.Frontend.Services.Discover
@inject IDiscoverService DiscoverService
@inject NavigationManager Navigation

<PageTitle>Discover</PageTitle>

<div class="discover-shell app-page">
    <div class="discover-layout">
        <main class="discover-main">
            <section class="search-panel app-card">
                <div>
                    <p class="app-kicker">Khám phá</p>
                    <h1 class="app-page-title">Tìm tổ chức, sự kiện và bạn bè</h1>
                    <p class="app-page-subtitle">Một ô tìm kiếm cho toàn bộ cộng đồng trong hệ thống.</p>
                </div>
                <DiscoverSearchBar Value="@_query" ValueChanged="HandleSearchChangedAsync" />
            </section>

            @if (_isLoading)
            {
                <section class="app-loading">
                    <h3>Đang tải Discover...</h3>
                    <p>Vui lòng đợi trong giây lát.</p>
                </section>
            }
            else if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <section class="app-error">
                    <h3>Không tải được dữ liệu Discover</h3>
                    <p>@_errorMessage</p>
                    <button type="button" class="app-button app-button--primary" @onclick="ReloadAsync">Thử lại</button>
                </section>
            }
            else
            {
                <section class="result-section app-section">
                    <div class="app-section-header">
                        <div>
                            <h2 class="app-section-title">Tổ chức</h2>
                            <p class="app-section-subtitle">Các cộng đồng phù hợp với tìm kiếm hiện tại.</p>
                        </div>
                        <span class="app-badge app-badge--info">@CurrentOrganizations.Count</span>
                    </div>
                    @if (CurrentOrganizations.Count == 0)
                    {
                        <div class="app-empty">Không có tổ chức phù hợp.</div>
                    }
                    else
                    {
                        <div class="card-grid organizations">
                            @foreach (var item in CurrentOrganizations)
                            {
                                <article class="entity-card org-card app-card app-card--interactive" @onclick="() => OpenOrganization(item.OrganizationId)">
                                    <img class="app-avatar" src="@ResolveImage(item.AvatarUrl, "/images/mockimages/Org1/Avt.jpg")" alt="@item.Name" />
                                    <div>
                                        <span class="app-chip">Tổ chức</span>
                                        <h3>@item.Name</h3>
                                        <p>@BuildOrgSub(item)</p>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>

                <section class="result-section app-section">
                    <div class="app-section-header">
                        <div>
                            <h2 class="app-section-title">Sự kiện</h2>
                            <p class="app-section-subtitle">Sự kiện nổi bật từ các tổ chức trong hệ thống.</p>
                        </div>
                        <span class="app-badge app-badge--warning">@CurrentEvents.Count</span>
                    </div>
                    @if (CurrentEvents.Count == 0)
                    {
                        <div class="app-empty">Không có sự kiện phù hợp.</div>
                    }
                    else
                    {
                        <div class="card-grid events">
                            @foreach (var item in CurrentEvents)
                            {
                                <article class="entity-card event-card app-card app-card--interactive" @onclick="() => OpenEvent(item.EventId)">
                                    <img src="@ResolveImage(item.ImageUrl, "/images/mockimages/Org1/Card1.jpg")" alt="@item.Title" />
                                    <div>
                                        <span class="app-chip">Sự kiện</span>
                                        <h3>@item.Title</h3>
                                        <p>@item.OrganizationName</p>
                                        <span class="entity-meta">@BuildEventTime(item)</span>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>

                <section class="result-section app-section">
                    <div class="app-section-header">
                        <div>
                            <h2 class="app-section-title">Người dùng</h2>
                            <p class="app-section-subtitle">Kết nối với những thành viên khác.</p>
                        </div>
                        <span class="app-badge app-badge--success">@CurrentUsers.Count</span>
                    </div>
                    @if (CurrentUsers.Count == 0)
                    {
                        <div class="app-empty">Không có người dùng phù hợp.</div>
                    }
                    else
                    {
                        <div class="user-list">
                            @foreach (var item in CurrentUsers)
                            {
                                <article class="user-card app-card">
                                    <div class="user-main">
                                        <img class="app-avatar app-avatar--round" src="@ResolveImage(item.AvatarUrl, "/images/avatars/user.png")" alt="@item.FullName" />
                                        <div>
                                            <h3>@item.FullName</h3>
                                            <p>@BuildUserSubtitle(item.Subtitle)</p>
                                        </div>
                                    </div>
                                    <div class="user-actions app-action-row">
                                        @if (IsFriend(item))
                                        {
                                            <button type="button" class="app-button app-button--secondary" @onclick="() => OpenMessage(item.UserId)">Nhắn tin</button>
                                        }
                                        else if (IsOutgoingPending(item))
                                        {
                                            <button type="button" class="app-button app-button--ghost" disabled>Đã gửi lời mời</button>
                                        }
                                        else if (IsIncomingPending(item))
                                        {
                                            <button type="button" class="app-button app-button--ghost" disabled>Đang chờ phản hồi</button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="app-button app-button--secondary"
                                                    disabled="@_processingUserIds.Contains(item.UserId)"
                                                    @onclick="() => SendFriendRequestAsync(item.UserId)">
                                                Kết nối
                                            </button>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>
            }
        </main>

        <aside class="discover-sidebar">
            <section class="side-card app-card">
                <div class="app-section-header">
                    <div>
                        <h2 class="app-section-title">Bạn bè</h2>
                        <p class="app-section-subtitle">Danh sách liên hệ gần đây.</p>
                    </div>
                    <span class="app-badge">@_friends.Count</span>
                </div>
                @if (_isLoading)
                {
                    <div class="app-empty">Đang tải...</div>
                }
                else if (_friends.Count == 0)
                {
                    <div class="app-empty">Bạn chưa có bạn bè.</div>
                }
                else
                {
                    @foreach (var friend in _friends.Take(8))
                    {
                        <div class="friend-item">
                            <div class="friend-main">
                                <img class="app-avatar app-avatar--round" src="@ResolveImage(friend.AvatarUrl, "/images/avatars/user.png")" alt="@friend.FullName" />
                                <div>
                                    <strong>@friend.FullName</strong>
                                    <span>@BuildUserSubtitle(friend.Subtitle)</span>
                                </div>
                            </div>
                            <div class="friend-actions app-action-row">
                                <button type="button" class="app-button app-button--ghost" disabled title="Chưa có trang profile">Hồ sơ</button>
                                <button type="button" class="app-button app-button--secondary" @onclick="() => OpenMessage(friend.UserId)">Nhắn tin</button>
                            </div>
                        </div>
                    }
                }
            </section>

            <section class="side-card app-card">
                <div class="app-section-header">
                    <div>
                        <h2 class="app-section-title">Lời mời kết bạn</h2>
                        <p class="app-section-subtitle">Các yêu cầu đang chờ bạn xử lý.</p>
                    </div>
                    <span class="app-badge app-badge--warning">@_requests.Count</span>
                </div>
                @if (_isLoading)
                {
                    <div class="app-empty">Đang tải...</div>
                }
                else if (_requests.Count == 0)
                {
                    <div class="app-empty">Không có lời mời nào.</div>
                }
                else
                {
                    @foreach (var request in _requests)
                    {
                        var isProcessing = _processingRequestIds.Contains(request.RequestId);
                        <article class="request-item">
                            <div class="friend-main">
                                <img class="app-avatar app-avatar--round" src="@ResolveImage(request.RequesterAvatarUrl, "/images/avatars/user.png")" alt="@request.RequesterName" />
                                <div>
                                    <strong>@request.RequesterName</strong>
                                    <span>@BuildRequestContext(request)</span>
                                </div>
                            </div>
                            <div class="request-actions app-action-row">
                                <button type="button" class="app-button app-button--primary" disabled="@isProcessing" @onclick="() => AcceptRequestAsync(request.RequestId)">Chấp nhận</button>
                                <button type="button" class="app-button app-button--ghost" disabled="@isProcessing" @onclick="() => DeclineRequestAsync(request.RequestId)">Từ chối</button>
                            </div>
                        </article>
                    }
                }
            </section>
        </aside>
    </div>
</div>

@code {
    private DiscoverFeedViewModel? _feed;
    private DiscoverSearchResultViewModel? _search;
    private List<DiscoverFriendItem> _friends = [];
    private List<DiscoverFriendRequestItem> _requests = [];
    private HashSet<Guid> _processingUserIds = [];
    private HashSet<Guid> _processingRequestIds = [];
    private bool _isLoading = true;
    private string _query = string.Empty;
    private string? _errorMessage;

    private IReadOnlyList<DiscoverOrganizationItem> CurrentOrganizations =>
        HasSearch ? (_search?.Organizations ?? []) : (_feed?.Organizations ?? []);

    private IReadOnlyList<DiscoverEventItem> CurrentEvents =>
        HasSearch ? (_search?.Events ?? []) : (_feed?.Events ?? []);

    private IReadOnlyList<DiscoverUserItem> CurrentUsers =>
        HasSearch ? (_search?.Users ?? []) : (_feed?.Users ?? []);

    private bool HasSearch => !string.IsNullOrWhiteSpace(_query);

    protected override async Task OnInitializedAsync()
        => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var feedTask = DiscoverService.GetDiscoverFeedAsync();
            var friendsTask = DiscoverService.GetFriendsAsync();
            var requestsTask = DiscoverService.GetFriendRequestsAsync();
            await Task.WhenAll(feedTask, friendsTask, requestsTask);

            _feed = feedTask.Result;
            _friends = friendsTask.Result.ToList();
            _requests = requestsTask.Result.ToList();

            if (HasSearch)
            {
                _search = await DiscoverService.SearchDiscoverAsync(_query);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _feed = null;
            _search = null;
            _friends = [];
            _requests = [];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSearchChangedAsync(string value)
    {
        _query = value;
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(value))
        {
            _search = null;
            return;
        }

        try
        {
            _search = await DiscoverService.SearchDiscoverAsync(value);
        }
        catch (Exception ex)
        {
            _search = null;
            _errorMessage = ex.Message;
        }
    }

    private async Task SendFriendRequestAsync(Guid userId)
    {
        if (_processingUserIds.Contains(userId))
            return;

        _processingUserIds.Add(userId);
        try
        {
            await DiscoverService.SendFriendRequestAsync(userId);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _processingUserIds.Remove(userId);
        }
    }

    private async Task AcceptRequestAsync(Guid requestId)
    {
        if (_processingRequestIds.Contains(requestId))
            return;

        _processingRequestIds.Add(requestId);
        try
        {
            await DiscoverService.AcceptFriendRequestAsync(requestId);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _processingRequestIds.Remove(requestId);
        }
    }

    private async Task DeclineRequestAsync(Guid requestId)
    {
        if (_processingRequestIds.Contains(requestId))
            return;

        _processingRequestIds.Add(requestId);
        try
        {
            await DiscoverService.DeclineFriendRequestAsync(requestId);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _processingRequestIds.Remove(requestId);
        }
    }

    private void OpenOrganization(Guid organizationId)
        => Navigation.NavigateTo($"/org-overview?orgId={organizationId:D}&returnUrl=%2Fuser%2Fdiscover");

    private void OpenEvent(Guid eventId)
        => Navigation.NavigateTo($"/events/{eventId:D}");

    private void OpenMessage(Guid userId)
        => Navigation.NavigateTo($"/user/messages/user/{userId:D}");

    private static string ResolveImage(string? url, string fallback)
        => string.IsNullOrWhiteSpace(url) ? fallback : url;

    private static string BuildOrgSub(DiscoverOrganizationItem item)
    {
        var location = string.IsNullOrWhiteSpace(item.Location) ? "Đang cập nhật địa điểm" : item.Location;
        return $"{location} - {item.MemberCount} thành viên";
    }

    private static string BuildEventTime(DiscoverEventItem item)
    {
        var start = item.StartDate.ToString("dd/MM/yyyy");
        var end = item.EndDate.ToString("dd/MM/yyyy");
        var dateLabel = start == end ? start : $"{start} - {end}";
        return string.IsNullOrWhiteSpace(item.Location) ? dateLabel : $"{dateLabel} - {item.Location}";
    }

    private static string BuildUserSubtitle(string? subtitle)
        => string.IsNullOrWhiteSpace(subtitle) ? "Chưa có thông tin bổ sung." : subtitle;

    private static bool IsFriend(DiscoverUserItem item)
        => string.Equals(item.RelationshipState, "FRIEND", StringComparison.OrdinalIgnoreCase);

    private static bool IsOutgoingPending(DiscoverUserItem item)
        => string.Equals(item.RelationshipState, "OUTGOING_PENDING", StringComparison.OrdinalIgnoreCase);

    private static bool IsIncomingPending(DiscoverUserItem item)
        => string.Equals(item.RelationshipState, "INCOMING_PENDING", StringComparison.OrdinalIgnoreCase);

    private static string BuildRequestContext(DiscoverFriendRequestItem item)
    {
        if (!string.IsNullOrWhiteSpace(item.Context))
            return item.Context;
        return $"Gửi lúc {item.CreatedAtUtc.ToLocalTime():dd/MM/yyyy HH:mm}";
    }
}
