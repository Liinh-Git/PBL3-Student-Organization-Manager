@page "/user/settings"
@page "/settings"
@using Org.Frontend.Services.UserSettings
@inject IUserSettingsService UserSettingsService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Cài đặt người dùng</PageTitle>

<div class="modern-settings-wrapper">
    @if (_isLoading)
    {
        <section class="settings-state">
            <h1>Đang tải trang cài đặt</h1>
            <p>Hệ thống đang đồng bộ thông tin tài khoản của bạn.</p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="settings-state error">
            <h1>Không tải được dữ liệu cài đặt</h1>
            <p>@_errorMessage</p>
            <button type="button" class="modern-btn-outline" @onclick="ReloadAsync">Thử lại</button>
        </section>
    }
    else if (_settings is not null)
    {
        <div class="settings-container">
            
            <div class="pill-tabs-container">
                <button class="pill-tab @(_activeSection == SectionProfile ? "active" : "")" @onclick='() => SelectSection(SectionProfile)'>
                    <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" Class="pill-icon" /> Hồ sơ cá nhân
                </button>
                <button class="pill-tab @(_activeSection == SectionSecurity ? "active" : "")" @onclick='() => SelectSection(SectionSecurity)'>
                    <MudIcon Icon="@Icons.Material.Outlined.Shield" Size="Size.Small" Class="pill-icon" /> Đăng nhập & Bảo mật
                </button>
                <button class="pill-tab @(_activeSection == SectionNotifications ? "active" : "")" @onclick='() => SelectSection(SectionNotifications)'>
                    <MudIcon Icon="@Icons.Material.Outlined.Notifications" Size="Size.Small" Class="pill-icon" /> Thông báo
                </button>
                <button class="pill-tab @(_activeSection == SectionAccount ? "active" : "")" @onclick='() => SelectSection(SectionAccount)'>
                    <MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" Class="pill-icon" /> Nâng cao
                </button>
            </div>

            <main class="settings-content-box animate-fade-in">
                
                @if (_activeSection == SectionProfile)
                {
                    <div class="tab-pane">
                        <div class="profile-layout">
                            <div class="avatar-section">
                                <div class="avatar-wrap">
                                    <img src="@ResolveAvatar(_settings.Profile.AvatarUrl)" alt="Avatar" />
                                    <button type="button" class="avatar-button" @onclick="CycleAvatar" aria-label="Đổi avatar">
                                        <MudIcon Icon="@Icons.Material.Outlined.PhotoCamera" Size="Size.Small" />
                                    </button>
                                </div>
                                <div class="avatar-info">
                                    <h3>@_settings.Profile.FullName</h3>
                                    <p>ID: @_settings.Profile.ProfileCode</p>
                                </div>
                            </div>

                            <div class="form-section">
                                <div class="form-grid">
                                    <label class="modern-field">
                                        <span>Họ và tên</span>
                                        <input type="text" class="modern-input" @bind="_settings.Profile.FullName" />
                                    </label>

                                    <label class="modern-field">
                                        <span>Email</span>
                                        <input type="email" class="modern-input readonly" value="@_settings.Profile.Email" readonly />
                                    </label>

                                    <label class="modern-field">
                                        <span>Số điện thoại</span>
                                        <input type="text" class="modern-input" @bind="_settings.Profile.PhoneNumber" />
                                    </label>

                                    <label class="modern-field">
                                        <span>Ngày sinh</span>
                                        <input type="date" class="modern-input" value="@FormatDateForInput(_settings.Profile.DateOfBirth)" @onchange="HandleDateOfBirthChange" />
                                    </label>

                                    <div class="modern-field full-width">
                                        <span>Giới tính</span>
                                        <div class="gender-group">
                                            <button type="button" class="gender-btn @GetGenderClass("Nam")" @onclick='() => SelectGender("Nam")'>Nam</button>
                                            <button type="button" class="gender-btn @GetGenderClass("Nu")" @onclick='() => SelectGender("Nu")'>Nữ</button>
                                            <button type="button" class="gender-btn @GetGenderClass("Khac")" @onclick='() => SelectGender("Khac")'>Khác</button>
                                        </div>
                                    </div>

                                    <label class="modern-field full-width">
                                        <span>Địa chỉ</span>
                                        <input type="text" class="modern-input" @bind="_settings.Profile.Address" />
                                    </label>

                                    <label class="modern-field full-width">
                                        <span>Mô tả ngắn</span>
                                        <textarea rows="3" class="modern-input" @bind="_settings.Profile.Bio"></textarea>
                                    </label>

                                    <label class="modern-field full-width">
                                        <span>Che do hien thi ho so</span>
                                        <select class="modern-input" @bind="_settings.Profile.ProfileVisibility">
                                            <option value="Public">Cong khai</option>
                                            <option value="OrganizationOnly">Chi nguoi cung to chuc</option>
                                            <option value="Private">Rieng tu</option>
                                        </select>
                                    </label>
                                </div>

                                <div class="form-actions">
                                    <button type="button" class="modern-btn-primary" @onclick="SaveProfileAsync" disabled="@_isSavingProfile">
                                        @(_isSavingProfile ? "Đang lưu..." : "Lưu thay đổi")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (_activeSection == SectionSecurity)
                {
                    <div class="tab-pane">
                        <div class="security-block">
                            <div class="block-title">
                                <div class="icon-wrap orange"><MudIcon Icon="@Icons.Material.Outlined.Key" Size="Size.Small" /></div>
                                <h3>Thay đổi mật khẩu</h3>
                            </div>
                            
                            <div class="form-grid">
                                <label class="modern-field full-width">
                                    <span>Mật khẩu hiện tại</span>
                                    <input type="password" class="modern-input" @bind="_passwordForm.CurrentPassword" placeholder="••••••••••••" />
                                </label>

                                <label class="modern-field">
                                    <span>Mật khẩu mới</span>
                                    <input type="password" class="modern-input" @bind="_passwordForm.NewPassword" placeholder="Nhập mật khẩu mới" />
                                </label>

                                <label class="modern-field">
                                    <span>Xác nhận mật khẩu</span>
                                    <input type="password" class="modern-input" @bind="_passwordForm.ConfirmPassword" placeholder="Nhập lại mật khẩu" />
                                </label>
                            </div>

                            <div class="form-actions mt-4">
                                <button type="button" class="modern-btn-secondary" @onclick="SavePasswordAsync" disabled="@_isSavingPassword">
                                    @(_isSavingPassword ? "Đang cập nhật..." : "Cập nhật mật khẩu")
                                </button>
                            </div>
                        </div>

                        <hr class="divider" />

                        <div class="security-block">
                            <div class="block-title flex-between">
                                <div class="flex-align">
                                    <div class="icon-wrap blue"><MudIcon Icon="@Icons.Material.Outlined.Devices" Size="Size.Small" /></div>
                                    <h3>Thiết bị của bạn</h3>
                                </div>
                                <button type="button" class="text-btn danger" @onclick="RevokeOtherSessionsAsync" disabled="@_isRevokingSessions">
                                    <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" />
                                    @(_isRevokingSessions ? "Đang thu hồi..." : "Đăng xuất tất cả phiên khác")
                                </button>
                            </div>

                            <div class="device-list">
                                @foreach (var device in _settings.Devices)
                                {
                                    <div class="device-card @(device.IsCurrentSession ? "current" : "")">
                                        <MudIcon Icon="@(device.IsCurrentSession ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Smartphone)" Class="device-icon" />
                                        <div class="device-info">
                                            <strong>@device.DeviceName</strong>
                                            <p>@(device.IsCurrentSession ? "Đang hoạt động (Phiên này)" : device.LastActiveLabel)</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (_activeSection == SectionNotifications)
                {
                    <div class="tab-pane">
                        <div class="notification-list">
                            <div class="notify-item">
                                <div>
                                    <h4>Email Notifications</h4>
                                    <p>Cập nhật quan trọng qua hộp thư điện tử</p>
                                </div>
                                <label class="modern-switch">
                                    <input type="checkbox" checked="@_settings.Notifications.EmailNotificationsEnabled" @onchange="OnEmailNotificationsChanged" />
                                    <span class="slider"></span>
                                </label>
                            </div>

                            <div class="notify-item">
                                <div>
                                    <h4>App Push</h4>
                                    <p>Thông báo tức thời trên ứng dụng di động</p>
                                </div>
                                <label class="modern-switch">
                                    <input type="checkbox" checked="@_settings.Notifications.AppPushEnabled" @onchange="OnAppPushChanged" />
                                    <span class="slider"></span>
                                </label>
                            </div>

                            <div class="notify-item">
                                <div>
                                    <h4>SMS Alerts</h4>
                                    <p>Tin nhắn văn bản cho các cảnh báo bảo mật</p>
                                </div>
                                <label class="modern-switch">
                                    <input type="checkbox" checked="@_settings.Notifications.SmsAlertsEnabled" @onchange="OnSmsAlertsChanged" />
                                    <span class="slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="form-actions mt-6 pt-6 border-t">
                            <button type="button" class="text-btn neutral w-full justify-center" @onclick="ResetNotificationsAsync" disabled="@_isSavingNotifications">
                                @(_isSavingNotifications ? "Đang xử lý..." : "Thiết lập lại tất cả")
                            </button>
                        </div>
                    </div>
                }

                @if (_activeSection == SectionAccount)
                {
                    <div class="tab-pane">
                        <div class="danger-zone">
                            <div class="danger-icon">
                                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" />
                            </div>
                            <div class="danger-content">
                                <h3>Xóa tài khoản vĩnh viễn</h3>
                                <p>Hành động này không thể hoàn tác. Một khi bạn xóa tài khoản, toàn bộ dữ liệu cá nhân, lịch sử hoạt động và các dự án liên quan sẽ bị xóa vĩnh viễn khỏi hệ thống máy chủ Kora.</p>
                                <span class="hint-text">@DeleteHintText</span>
                                
                                <button type="button" class="modern-btn-danger mt-4" @onclick="HandleDeleteAccountAsync" disabled="@_isDeletingAccount">
                                    @(_isDeletingAccount ? "Đang xử lý..." : DeleteButtonText)
                                </button>
                            </div>
                        </div>
                    </div>
                }

            </main>
        </div>
    }
</div>

@code {
    // Các phần code C# giữ nguyên hoàn toàn như cũ
    private const string SectionProfile = "profile";
    private const string SectionSecurity = "security";
    private const string SectionNotifications = "notifications";
    private const string SectionAccount = "account";
    
    private const string DefaultAvatarUrl = "/images/mockimages/AvtUser/Avt1.jpg";
    private static readonly string[] AvatarPool =
    [
        "/images/mockimages/AvtUser/Avt1.jpg",
        "/images/mockimages/AvtUser/Avt2.jpg",
        "/images/mockimages/AvtUser/Avt3.jpg",
        "/images/mockimages/AvtUser/Avt4.jpg",
        "/images/mockimages/AvtUser/Avt5.jpg",
        "/images/mockimages/AvtUser/Avt6.jpg",
        "/images/mockimages/AvtUser/Avt7.jpg",
        "/images/mockimages/AvtUser/Avt8.jpg",
        "/images/mockimages/AvtUser/Avt9.jpg",
        "/images/mockimages/AvtUser/Avt10.jpg",
        "/images/mockimages/AvtUser/Avt11.jpg",
        "/images/mockimages/AvtUser/Avt12.jpg",
        "/images/mockimages/AvtUser/Avt13.jpg",
        "/images/mockimages/AvtUser/Avt14.jpg",
        "/images/mockimages/AvtUser/Avt15.jpg",
        "/images/mockimages/AvtUser/Avt16.jpg",
        "/images/mockimages/AvtUser/Avt17.jpg"
    ];

    private UserSettingsPageViewModel? _settings;
    private PasswordChangeFormViewModel _passwordForm = new();
    private bool _isLoading = true;
    private bool _isSavingProfile;
    private bool _isSavingPassword;
    private bool _isSavingNotifications;
    private bool _isRevokingSessions;
    private bool _isDeletingAccount;
    private bool _deleteConfirmationArmed;
    private bool _notificationUnsupportedShown;
    
    private string _activeSection = SectionProfile;
    private string? _errorMessage;

    private string DeleteButtonText => _deleteConfirmationArmed ? "Xác nhận xóa tài khoản" : "Xóa tài khoản";
    private string DeleteHintText => _deleteConfirmationArmed
        ? "Nhấn lại một lần nữa để xác nhận thao tác."
        : "Bạn có thể tạm ngưng tài khoản bất cứ lúc nào.";

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _settings = await UserSettingsService.GetSettingsAsync();
            _activeSection = SectionProfile;
            _passwordForm = new PasswordChangeFormViewModel();
            _deleteConfirmationArmed = false;
            _notificationUnsupportedShown = false;
        }
        catch
        {
            _settings = null;
            _errorMessage = "Hệ thống tạm thời không tải được dữ liệu cài đặt. Vui lòng thử lại.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectSection(string section)
    {
        _activeSection = section;
    }

    private void NavigateDashboard()
    {
        Navigation.NavigateTo("/user/organizations");
    }

    private void SelectGender(string gender)
    {
        if (_settings is null) return;
        _settings.Profile.Gender = gender;
    }

    private void HandleDateOfBirthChange(ChangeEventArgs args)
    {
        if (_settings is null) return;
        var raw = args.Value?.ToString();
        _settings.Profile.DateOfBirth = ParseDateOnly(raw);
    }

    private async Task SaveProfileAsync()
    {
        if (_settings is null || _isSavingProfile) return;
        _isSavingProfile = true;
        try
        {
            var result = await UserSettingsService.SaveProfileAsync(_settings.Profile.Clone());
            Notify(result, Severity.Success);
        }
        finally
        {
            _isSavingProfile = false;
        }
    }

    private async Task SavePasswordAsync()
    {
        if (_isSavingPassword) return;
        _isSavingPassword = true;
        try
        {
            var request = new PasswordChangeFormViewModel
            {
                CurrentPassword = _passwordForm.CurrentPassword,
                NewPassword = _passwordForm.NewPassword,
                ConfirmPassword = _passwordForm.ConfirmPassword
            };

            var result = await UserSettingsService.ChangePasswordAsync(request);
            Notify(result, Severity.Success);
            if (result.Succeeded)
            {
                _passwordForm = new PasswordChangeFormViewModel();
            }
        }
        finally
        {
            _isSavingPassword = false;
        }
    }

    private async Task OnEmailNotificationsChanged(ChangeEventArgs args)
    {
        if (_settings is null) return;
        _settings.Notifications.EmailNotificationsEnabled = ParseBoolean(args.Value);
        await PersistNotificationsAsync();
    }

    private async Task OnAppPushChanged(ChangeEventArgs args)
    {
        if (_settings is null) return;
        _settings.Notifications.AppPushEnabled = ParseBoolean(args.Value);
        await PersistNotificationsAsync();
    }

    private async Task OnSmsAlertsChanged(ChangeEventArgs args)
    {
        if (_settings is null) return;
        _settings.Notifications.SmsAlertsEnabled = ParseBoolean(args.Value);
        await PersistNotificationsAsync();
    }

    private async Task ResetNotificationsAsync()
    {
        if (_settings is null) return;
        _settings.Notifications = new NotificationPreferencesViewModel
        {
            EmailNotificationsEnabled = true,
            AppPushEnabled = true,
            SmsAlertsEnabled = false
        };
        await PersistNotificationsAsync(forceNotify: true);
    }

    private async Task PersistNotificationsAsync(bool forceNotify = false)
    {
        if (_settings is null || _isSavingNotifications) return;
        _isSavingNotifications = true;
        try
        {
            var result = await UserSettingsService.SaveNotificationsAsync(_settings.Notifications.Clone());
            if (result.IsUnsupported)
            {
                if (!_notificationUnsupportedShown || forceNotify)
                {
                    Notify(result, Severity.Info);
                    _notificationUnsupportedShown = true;
                }
                return;
            }
            Notify(result, Severity.Success);
        }
        finally
        {
            _isSavingNotifications = false;
        }
    }

    private async Task RevokeOtherSessionsAsync()
    {
        if (_settings is null || _isRevokingSessions) return;
        _isRevokingSessions = true;
        try
        {
            var result = await UserSettingsService.RevokeOtherSessionsAsync();
            Notify(result, Severity.Success);

            if (result.Succeeded)
            {
                _settings.Devices = _settings.Devices.Where(x => x.IsCurrentSession).ToList();
            }
        }
        finally
        {
            _isRevokingSessions = false;
        }
    }

    private async Task HandleDeleteAccountAsync()
    {
        if (_isDeletingAccount) return;
        if (!_deleteConfirmationArmed)
        {
            _deleteConfirmationArmed = true;
            Snackbar.Add("Nhấn lại một lần nữa để xác nhận xóa tài khoản.", Severity.Warning);
            return;
        }

        _isDeletingAccount = true;
        try
        {
            var result = await UserSettingsService.DeleteAccountAsync();
            Notify(result, Severity.Warning);
            if (result.Succeeded)
            {
                _deleteConfirmationArmed = false;
            }
        }
        finally
        {
            _isDeletingAccount = false;
        }
    }

    private void CycleAvatar()
    {
        if (_settings is null) return;
        var current = ResolveAvatar(_settings.Profile.AvatarUrl);
        var currentIndex = Array.FindIndex(AvatarPool, x => string.Equals(x, current, StringComparison.OrdinalIgnoreCase));
        var nextIndex = currentIndex < 0 ? 0 : (currentIndex + 1) % AvatarPool.Length;
        _settings.Profile.AvatarUrl = AvatarPool[nextIndex];
    }

    private static bool ParseBoolean(object? raw)
    {
        return raw switch
        {
            bool direct => direct,
            string text when bool.TryParse(text, out var parsed) => parsed,
            _ => false
        };
    }

    private static DateOnly? ParseDateOnly(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        return DateOnly.TryParse(raw, out var value) ? value : null;
    }

    private static string FormatDateForInput(DateOnly? value)
        => value?.ToString("yyyy-MM-dd") ?? string.Empty;

    private static string ResolveAvatar(string? avatarUrl)
        => string.IsNullOrWhiteSpace(avatarUrl) ? DefaultAvatarUrl : avatarUrl;

    private string GetGenderClass(string gender)
    {
        var current = _settings?.Profile.Gender?.Trim() ?? string.Empty;
        return string.Equals(current, gender, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    private void Notify(UserSettingsOperationResult result, Severity successSeverity)
    {
        if (result.Succeeded)
        {
            Snackbar.Add(result.Message, successSeverity);
            return;
        }
        if (result.IsUnsupported)
        {
            Snackbar.Add(result.Message, Severity.Info);
            return;
        }
        Snackbar.Add(result.Message, Severity.Error);
    }
}
