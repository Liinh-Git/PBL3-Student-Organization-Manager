@page "/user/events"
@rendermode InteractiveServer
@using Org.Frontend.Services.Events
@using Org.Frontend.Services.Auth
@using Org.Frontend.ViewModels
@inject IEventService EventService
@inject FrontendAuthStateProvider FrontendAuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Sự kiện của tôi - Kora</PageTitle>

<div class="user-events-dashboard">
    @if (_isLoading)
    {
        <div class="d-flex justify-center pa-12">
            <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="events-empty-state">
            <p class="empty-note">@_errorMessage</p>
            <button class="btn-dark" @onclick="LoadAsync">Thử lại</button>
        </div>
    }
    else
    {
        <div class="events-tabs">
            <button class="tab-btn @(_activeStatus == EventStatusFilter.All ? "active" : "")" @onclick='() => _activeStatus = EventStatusFilter.All'>
                Tất cả (@(OrganizerEvents.Count + AttendeeEvents.Count))
            </button>
            <button class="tab-btn @(_activeStatus == EventStatusFilter.Ongoing ? "active" : "")" @onclick='() => _activeStatus = EventStatusFilter.Ongoing'>
                Đang diễn ra (@CountByStatus("ONGOING"))
            </button>
            <button class="tab-btn @(_activeStatus == EventStatusFilter.Upcoming ? "active" : "")" @onclick='() => _activeStatus = EventStatusFilter.Upcoming'>
                Sắp tới (@CountByStatus("UPCOMING"))
            </button>
            <button class="tab-btn @(_activeStatus == EventStatusFilter.Ended ? "active" : "")" @onclick='() => _activeStatus = EventStatusFilter.Ended'>
                Đã kết thúc (@CountByStatus("COMPLETED"))
            </button>
        </div>

        <section class="events-group">
            <div class="group-header">
                <h3>Sự kiện tôi tổ chức</h3>
                <div class="group-divider"></div>
            </div>

            <div class="events-list">
                @if (OrganizerEvents.Count == 0)
                {
                    <div class="events-empty-state w-100 pa-8 text-center text-muted">
                        <p class="empty-note">Bạn chưa có sự kiện tổ chức trong danh mục này.</p>
                    </div>
                }
                else
                {
                    @foreach (var evt in OrganizerEvents)
                    {
                        <div class="event-card">
                            <div class="event-image-wrap">
                                <img src="@ResolveImage(evt.ImageUrl)" alt="Event" class="event-image" />
                            </div>
                            <div class="event-details">
                                <div class="event-category">
                                    <span class="cat-badge staff-badge">Ban tổ chức</span>
                                    <span class="cat-label">@evt.OrganizationName</span>
                                </div>
                                <h4 class="event-title">@evt.Name</h4>
                                <div class="event-meta-info">
                                    <span class="meta-text"><span class="material-symbols-outlined">schedule</span> @evt.StartDate.ToString("dd/MM/yyyy")</span>
                                    <span class="meta-text"><span class="material-symbols-outlined">location_on</span> @ResolveLocation(evt.Location)</span>
                                </div>
                            </div>
                            <div class="event-actions">
                                <button class="btn-dark" @onclick='() => OpenPublicDetail(evt.EventId)'>Xem public</button>
                                @if (evt.CanEnterWorkspace)
                                {
                                    <button class="btn-primary-orange" @onclick='() => OpenWorkspace(evt)'>Vào workspace</button>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </section>

        <section class="events-group">
            <div class="group-header">
                <h3>Sự kiện tôi tham gia</h3>
                <div class="group-divider"></div>
            </div>

            <div class="events-list">
                @if (AttendeeEvents.Count == 0)
                {
                    <div class="events-empty-state w-100 pa-8 text-center text-muted">
                        <p class="empty-note">Bạn chưa có sự kiện tham gia trong danh mục này.</p>
                    </div>
                }
                else
                {
                    @foreach (var evt in AttendeeEvents)
                    {
                        <div class="event-card">
                            <div class="event-image-wrap">
                                <img src="@ResolveImage(evt.ImageUrl)" alt="Event" class="event-image" />
                            </div>
                            <div class="event-details">
                                <div class="event-category">
                                    <span class="cat-badge attendee-badge">Người tham dự</span>
                                    <span class="cat-label">@evt.OrganizationName</span>
                                </div>
                                <h4 class="event-title">@evt.Name</h4>
                                <div class="event-meta-info">
                                    <span class="meta-text"><span class="material-symbols-outlined">schedule</span> @evt.StartDate.ToString("dd/MM/yyyy")</span>
                                    <span class="meta-text"><span class="material-symbols-outlined">location_on</span> @ResolveLocation(evt.Location)</span>
                                </div>
                            </div>
                            <div class="event-actions">
                                <button class="btn-dark" @onclick='() => OpenPublicDetail(evt.EventId)'>Xem chi tiết</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>
    }
</div>

@code {
    private MyEventsViewModel _myEvents = new();
    private bool _isLoading = true;
    private string? _errorMessage;
    private bool _hasBootstrapped;
    private EventStatusFilter _activeStatus = EventStatusFilter.All;

    private enum EventStatusFilter
    {
        All,
        Upcoming,
        Ongoing,
        Ended
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hasBootstrapped)
            return;

        _hasBootstrapped = true;
        await FrontendAuthStateProvider.InitializeAsync();
        var authState = await FrontendAuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
            return;

        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _myEvents = await EventService.GetMyEventsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private List<MyEventItemViewModel> OrganizerEvents => ApplyStatusFilter(_myEvents.OrganizerEvents);
    private List<MyEventItemViewModel> AttendeeEvents => ApplyStatusFilter(_myEvents.AttendeeEvents);

    private List<MyEventItemViewModel> ApplyStatusFilter(List<MyEventItemViewModel> items)
    {
        return items
            .Where(x => _activeStatus switch
            {
                EventStatusFilter.Upcoming => string.Equals(x.StatusLabel, "UPCOMING", StringComparison.OrdinalIgnoreCase),
                EventStatusFilter.Ongoing => string.Equals(x.StatusLabel, "ONGOING", StringComparison.OrdinalIgnoreCase),
                EventStatusFilter.Ended => string.Equals(x.StatusLabel, "COMPLETED", StringComparison.OrdinalIgnoreCase),
                _ => true
            })
            .ToList();
    }

    private int CountByStatus(string status)
    {
        return _myEvents.OrganizerEvents
            .Concat(_myEvents.AttendeeEvents)
            .Count(x => string.Equals(x.StatusLabel, status, StringComparison.OrdinalIgnoreCase));
    }

    private static string ResolveImage(string? imageUrl)
        => string.IsNullOrWhiteSpace(imageUrl) ? "/images/mockimages/Org1/Card2.jpg" : imageUrl;

    private static string ResolveLocation(string? location)
        => string.IsNullOrWhiteSpace(location) ? "Địa điểm sẽ cập nhật" : location;

    private void OpenPublicDetail(Guid eventId)
        => NavigationManager.NavigateTo($"/events/{eventId:D}");

    private void OpenWorkspace(MyEventItemViewModel evt)
        => NavigationManager.NavigateTo($"/org/events/{evt.EventId:D}?orgId={evt.OrganizationId:D}");
}
