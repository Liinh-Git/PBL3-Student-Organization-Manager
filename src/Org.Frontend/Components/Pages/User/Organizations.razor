@page "/user/organizations"
@rendermode InteractiveServer
@inject Org.Frontend.Services.Organizations.IOrganizationService OrganizationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@using Org.Frontend.Services.Organizations
@using Org.Frontend.Components.Pages.Organizations

<PageTitle>Tổ chức của tôi</PageTitle>

<div class="my-orgs-page app-page">
    @if (_isLoading)
    {
        <section class="app-loading orgs-state">
            <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" />
            <p>Đang tải danh sách tổ chức...</p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="app-error orgs-state">
            <h2>Không tải được dữ liệu</h2>
            <p>@_errorMessage</p>
            <button type="button" class="app-button app-button--ghost" @onclick="LoadAsync">Thử lại</button>
        </section>
    }
    else if (_myOrganizations is not null)
    {
        <header class="app-page-header my-orgs-header">
            <div>
                <p class="app-kicker">Workspace cá nhân</p>
                <h1 class="app-page-title">Tổ chức của tôi</h1>
                <p class="app-page-subtitle">Theo dõi tổ chức bạn phụ trách và các cộng đồng bạn đang tham gia.</p>
            </div>
        </header>

        <section class="section app-section">
            <div class="app-section-header">
                <div>
                    <h2 class="app-section-title">Tổ chức đang phụ trách</h2>
                    <p class="app-section-subtitle">Các tổ chức bạn có vai trò quản lý hoặc điều phối.</p>
                </div>
                @if (LeadingPageCount > 1)
                {
                    <div class="pager">
                        <button type="button" class="app-button app-icon-button" @onclick="PrevLeading" disabled="@(!CanPrevLeading)">
                            <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" />
                        </button>
                        <span>@LeadingPageDisplay/@LeadingPageCount</span>
                        <button type="button" class="app-button app-icon-button" @onclick="NextLeading" disabled="@(!CanNextLeading)">
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
                        </button>
                    </div>
                }
            </div>

            <div class="card-grid">
                <button type="button" class="org-card create-card app-card app-card--interactive" @onclick="OnCreateOrganizationClick">
                    <MudIcon Icon="@Icons.Material.Filled.Add" />
                    <strong>Tạo tổ chức mới</strong>
                    <p>Khởi tạo một tổ chức mới trong workspace của bạn.</p>
                </button>

                @if (LeadingPageItems.Count == 0)
                {
                    <article class="org-card empty-card app-empty">
                        <strong>Chưa có tổ chức đang phụ trách</strong>
                        <p>Bạn vẫn có thể tạo tổ chức mới từ card bên trái.</p>
                    </article>
                }
                else
                {
                    @foreach (var item in LeadingPageItems)
                    {
                        <article class="org-card app-card">
                            <div class="card-top">
                                <img class="app-avatar" src="@ResolveAvatar(item)" alt="@item.Name" />
                                <span class="app-badge app-badge--success">@item.MembershipRole</span>
                            </div>
                            <h3>@item.Name</h3>
                            <p>@BuildDescription(item.ShortDescription)</p>
                            <div class="stats app-meta-list">
                                <span>@item.MemberCount thành viên</span>
                                <span>@item.UpcomingEventCount sự kiện sắp tới</span>
                                <span>@item.ActiveTaskCount task đang mở</span>
                            </div>
                            @if (item.Tags.Count > 0)
                            {
                                <div class="tags">
                                    @foreach (var tag in item.Tags.Take(3))
                                    {
                                        <span class="app-chip">@tag</span>
                                    }
                                </div>
                            }
                            <div class="actions app-action-row">
                                <button type="button" class="app-button app-button--ghost" @onclick="() => ViewDetails(item.OrganizationId)">Xem chi tiết</button>
                                <button type="button" class="app-button app-button--ghost" @onclick="() => EnterWorkspace(item.OrganizationId)" disabled="@(!item.CanAccessWorkspace)">Vào workspace</button>
                                <button type="button" class="app-button app-button--primary" @onclick="() => ManageOrganization(item.OrganizationId)" disabled="@(!item.CanManage)">Quản lý</button>
                            </div>
                        </article>
                    }
                }
            </div>
        </section>

        <section class="section app-section">
            <div class="app-section-header">
                <div>
                    <h2 class="app-section-title">Tổ chức đang tham gia</h2>
                    <p class="app-section-subtitle">Các tổ chức bạn tham gia với vai trò thành viên.</p>
                </div>
                @if (ParticipatingPageCount > 1)
                {
                    <div class="pager">
                        <button type="button" class="app-button app-icon-button" @onclick="PrevParticipating" disabled="@(!CanPrevParticipating)">
                            <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" />
                        </button>
                        <span>@ParticipatingPageDisplay/@ParticipatingPageCount</span>
                        <button type="button" class="app-button app-icon-button" @onclick="NextParticipating" disabled="@(!CanNextParticipating)">
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
                        </button>
                    </div>
                }
            </div>

            <div class="card-grid">
                @if (ParticipatingPageItems.Count == 0)
                {
                    <article class="org-card empty-card app-empty">
                        <strong>Bạn chưa tham gia thêm tổ chức nào</strong>
                        <p>Truy cập Discover để tìm tổ chức phù hợp.</p>
                    </article>
                }
                else
                {
                    @foreach (var item in ParticipatingPageItems)
                    {
                        <article class="org-card app-card">
                            <div class="card-top">
                                <img class="app-avatar" src="@ResolveAvatar(item)" alt="@item.Name" />
                                <span class="app-badge">@item.MembershipRole</span>
                            </div>
                            <h3>@item.Name</h3>
                            <p>@BuildDescription(item.ShortDescription)</p>
                            <div class="stats app-meta-list">
                                <span>@item.MemberCount thành viên</span>
                                <span>@item.UpcomingEventCount sự kiện sắp tới</span>
                                <span>@item.ActiveTaskCount task đang mở</span>
                            </div>
                            @if (item.Tags.Count > 0)
                            {
                                <div class="tags">
                                    @foreach (var tag in item.Tags.Take(3))
                                    {
                                        <span class="app-chip">@tag</span>
                                    }
                                </div>
                            }
                            <div class="actions app-action-row">
                                <button type="button" class="app-button app-button--ghost" @onclick="() => ViewDetails(item.OrganizationId)">Xem chi tiết</button>
                                <button type="button" class="app-button app-button--ghost" @onclick="() => EnterWorkspace(item.OrganizationId)" disabled="@(!item.CanAccessWorkspace)">Vào workspace</button>
                                <button type="button" class="app-button app-button--primary" @onclick="() => ManageOrganization(item.OrganizationId)" disabled="@(!item.CanManage)">Quản lý</button>
                            </div>
                        </article>
                    }
                }
            </div>
        </section>
    }
</div>

@code {
    private const int CardsPerPage = 3;

    private MyOrganizationsViewModel? _myOrganizations;
    private bool _isLoading;
    private string? _errorMessage;
    private int _leadingPageIndex;
    private int _participatingPageIndex;

    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _myOrganizations = await OrganizationService.GetMyOrganizationsAsync();
            _leadingPageIndex = 0;
            _participatingPageIndex = 0;
        }
        catch (Exception ex)
        {
            _myOrganizations = null;
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IReadOnlyList<MyOrganizationCardViewModel> LeadingOrganizations
        => _myOrganizations?.LeadingOrganizations ?? [];

    private IReadOnlyList<MyOrganizationCardViewModel> ParticipatingOrganizations
        => _myOrganizations?.ParticipatingOrganizations ?? [];

    private int LeadingPageCount => ComputePageCount(LeadingOrganizations.Count);
    private int ParticipatingPageCount => ComputePageCount(ParticipatingOrganizations.Count);
    private int LeadingPageDisplay => Math.Min(_leadingPageIndex + 1, LeadingPageCount);
    private int ParticipatingPageDisplay => Math.Min(_participatingPageIndex + 1, ParticipatingPageCount);

    private bool CanPrevLeading => _leadingPageIndex > 0;
    private bool CanNextLeading => _leadingPageIndex < LeadingPageCount - 1;
    private bool CanPrevParticipating => _participatingPageIndex > 0;
    private bool CanNextParticipating => _participatingPageIndex < ParticipatingPageCount - 1;

    private IReadOnlyList<MyOrganizationCardViewModel> LeadingPageItems => LeadingOrganizations
        .Skip(_leadingPageIndex * CardsPerPage)
        .Take(CardsPerPage)
        .ToList();

    private IReadOnlyList<MyOrganizationCardViewModel> ParticipatingPageItems => ParticipatingOrganizations
        .Skip(_participatingPageIndex * CardsPerPage)
        .Take(CardsPerPage)
        .ToList();

    private void PrevLeading()
    {
        if (CanPrevLeading)
            _leadingPageIndex--;
    }

    private void NextLeading()
    {
        if (CanNextLeading)
            _leadingPageIndex++;
    }

    private void PrevParticipating()
    {
        if (CanPrevParticipating)
            _participatingPageIndex--;
    }

    private void NextParticipating()
    {
        if (CanNextParticipating)
            _participatingPageIndex++;
    }

    private static int ComputePageCount(int count)
    {
        if (count <= 0)
            return 1;
        return (int)Math.Ceiling(count / (double)CardsPerPage);
    }

    private void ViewDetails(Guid organizationId)
        => NavigationManager.NavigateTo($"/org-overview?orgId={organizationId:D}&returnUrl=%2Fuser%2Forganizations");

    private void EnterWorkspace(Guid organizationId)
        => NavigationManager.NavigateTo($"/org/members?orgId={organizationId:D}");

    private void ManageOrganization(Guid organizationId)
        => NavigationManager.NavigateTo($"/org-overview?orgId={organizationId:D}&returnUrl=%2Fuser%2Forganizations&edit=1");

    private async Task OnCreateOrganizationClick()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateOrganizationDialog>("Tạo tổ chức", options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not CreateOrganizationViewModel model)
            return;

        try
        {
            var newOrg = await OrganizationService.CreateOrganizationAsync(model);
            Snackbar.Add($"Đã tạo tổ chức {newOrg.Name} thành công.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi khi tạo tổ chức: {ex.Message}", Severity.Error);
        }
    }

    private static string ResolveAvatar(MyOrganizationCardViewModel item)
        => string.IsNullOrWhiteSpace(item.AvatarUrl) ? "/images/mockimages/Org1/Avt.jpg" : item.AvatarUrl;

    private static string BuildDescription(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Chưa có mô tả.";

        var text = value.Trim();
        return text.Length <= 140 ? text : $"{text[..140]}...";
    }
}
