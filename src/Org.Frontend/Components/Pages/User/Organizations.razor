@page "/user/organizations"
@rendermode InteractiveServer
@using Org.Frontend.ViewModels
@using Org.Frontend.Services.Dashboard
@using Org.Frontend.Components.Pages.Organizations
@inject IUserDashboardService DashboardService
@inject Org.Frontend.Services.Organizations.IOrganizationService OrganizationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Tổ chức của tôi - Kora</PageTitle>

<div class="org-dashboard">
    <header class="dashboard-header">
        <div class="header-title-area">
            <span class="welcome-text">Chào mừng trở lại</span>
            <h2 class="user-greeting">Xin chào, @(_dashboard?.DisplayName ?? "User")!</h2>
        </div>
        @if (_dashboard != null)
        {
            <div class="header-stats">
                <div class="stat-card">
                    <span class="stat-label">Tổ chức tham gia</span>
                    <span class="stat-value">@_dashboard.Organizations.Count</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Sự kiện đăng ký</span>
                    <span class="stat-value">@(_dashboard?.RegisteredEvents.Count ?? 0)</span>
                </div>
            </div>
        }
    </header>

    @if (_dashboard == null)
    {
        <div class="d-flex justify-center pa-12">
            <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        <!-- SECTION: TỔ CHỨC TÔI LÀM CHỦ -->
        <section class="org-section">
            <div class="section-header">
                <h3>Tổ chức tôi làm chủ</h3>
                <div class="section-divider"></div>
            </div>

            <div class="org-grid-cards">
                <!-- Create New Card -->
                <div class="create-org-card" @onclick="OnCreateOrganizationClick" style="cursor: pointer;">
                    <div class="create-icon-wrap">
                        <span class="material-symbols-outlined">add</span>
                    </div>
                    <span>Tạo tổ chức mới</span>
                </div>

                @foreach (var org in _dashboard.Organizations.Where(o => o.Role == "Owner" || o.Role == "Admin"))
                {
                    <div class="org-card" @onclick="() => NavigateToOrg(org.OrganizationId)" style="cursor: pointer;">
                        <div class="role-badge @org.Role.ToLower()">@org.Role</div>
                        <div class="org-card-content">
                            @if (!string.IsNullOrEmpty(org.AvatarUrl))
                            {
                                <img src="@org.AvatarUrl" alt="Avatar" class="org-avatar-img" style="width: 48px; height: 48px; border-radius: 12px; margin-bottom: 1rem; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="org-avatar @GetRandomColorClass(org.Name)">@org.Name.FirstOrDefault()</div>
                            }
                            <h4 class="org-name">@org.Name</h4>
                            <p class="org-desc">@(string.IsNullOrWhiteSpace(org.Description) ? "Chưa có mô tả cho tổ chức này." : org.Description)</p>
                        </div>
                        <div class="org-card-footer">
                            <div class="members-overlap">
                                <img src="/images/mockimages/AvtUser/Avt1.jpg" alt="Member" class="member-avatar" />
                                <div class="member-count">+5</div>
                            </div>
                            <span class="project-count">Active</span>
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- SECTION: TỔ CHỨC TÔI THAM GIA -->
        <section class="org-section mt-lg">
            <div class="section-header">
                <h3>Tổ chức tôi tham gia</h3>
                <div class="section-divider"></div>
            </div>

            <div class="org-list-grid">
                @foreach (var org in _dashboard.Organizations.Where(o => o.Role != "Owner" && o.Role != "Admin"))
                {
                    <div class="org-list-item" @onclick="() => NavigateToOrg(org.OrganizationId)" style="cursor: pointer;">
                        <div class="org-list-left">
                            <div class="org-logo-wrap">
                                @if (!string.IsNullOrEmpty(org.AvatarUrl))
                                {
                                    <img src="@org.AvatarUrl" alt="Logo" class="org-logo-img" />
                                }
                                else
                                {
                                    <div class="org-text-logo @GetRandomColorClass(org.Name)">@org.Name.FirstOrDefault()</div>
                                }
                            </div>
                            <div class="org-list-info">
                                <h5>@org.Name</h5>
                                <span>@org.Role</span>
                            </div>
                        </div>
                        <div class="org-list-right">
                            <div class="join-date">
                                <span class="date-label">Tham gia từ</span>
                                <span class="date-value">@org.JoinedAtUtc.ToString("MM, yyyy")</span>
                            </div>
                            <span class="material-symbols-outlined action-icon">chevron_right</span>
                        </div>
                    </div>
                }
                
                @if (!_dashboard.Organizations.Any(o => o.Role != "Owner" && o.Role != "Admin"))
                {
                    <div class="pa-8 text-center text-muted">
                        <p>Bạn chưa tham gia tổ chức nào khác.</p>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Background Decorators -->
    <div class="bg-decoration top-right"></div>
    <div class="bg-decoration bottom-left"></div>
</div>

@code {
    private UserDashboardViewModel? _dashboard;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _dashboard = await DashboardService.GetDashboardAsync();
    }

    private void NavigateToOrg(Guid orgId)
    {
        NavigationManager.NavigateTo($"/org-overview?orgId={orgId}");
    }

    private async Task OnCreateOrganizationClick()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateOrganizationDialog>("Tạo tổ chức", options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CreateOrganizationViewModel model)
        {
            try
            {
                var newOrg = await OrganizationService.CreateOrganizationAsync(model);
                Snackbar.Add($"Đã tạo tổ chức {newOrg.Name} thành công!", Severity.Success);
                await LoadDashboardAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Lỗi khi tạo tổ chức: {ex.Message}", Severity.Error);
            }
        }
    }

    private string GetRandomColorClass(string name)
    {
        var colors = new[] { "dark-blue", "deep-blue", "subtle-orange", "subtle-blue" };
        var index = Math.Abs(name.GetHashCode()) % colors.Length;
        return colors[index];
    }
}

<style>
    .org-card:hover, .org-list-item:hover, .create-org-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
    }
</style>


