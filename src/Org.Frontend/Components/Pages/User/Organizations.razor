@page "/user/organizations"
@rendermode InteractiveServer
@using Org.Frontend.ViewModels
@using Org.Frontend.Services.Dashboard
@using Org.Frontend.Components.Pages.Organizations
@inject IUserDashboardService DashboardService
@inject Org.Frontend.Services.Organizations.IOrganizationService OrganizationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Tổ chức của tôi - Kora</PageTitle>

<div class="org-page-container">
    <!-- HEADER MỚI -->
    <header class="page-header">
        <div class="header-icon-box">
            <span class="material-symbols-outlined">account_balance</span>
        </div>
        <div class="header-text-box">
            <h1 class="page-title">Tổ chức của tôi</h1>
            <p class="page-subtitle">QUẢN LÝ VÀ THAM GIA KIẾN TẠO CỘNG ĐỒNG</p>
        </div>
    </header>

    @if (_dashboard == null)
    {
        <div class="d-flex justify-center pa-12">
            <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        var ownedOrgs = _dashboard!.Organizations.Where(o => o.Role == "Owner" || o.Role == "Admin").ToList();
        var joinedOrgs = _dashboard!.Organizations.Where(o => o.Role != "Owner" && o.Role != "Admin").ToList();

        <!-- SECTION: CÁC TỔ CHỨC TÔI CHỦ NHIỆM -->
        <section class="org-section">
            <div class="section-header">
                <h2>Các tổ chức tôi chủ nhiệm</h2>
                <div class="header-line"></div>
                <span class="header-badge owner-badge">CHỦ NHIỆM (@ownedOrgs.Count)</span>
            </div>

            <div class="org-grid">
                <!-- Nút tạo tổ chức mới -->
                <div class="org-card create-card" @onclick="OnCreateOrganizationClick">
                    <div class="create-icon-circle">
                        <span class="material-symbols-outlined">add</span>
                    </div>
                    <h3>Tạo tổ chức mới</h3>
                    <p>Bắt đầu hành trình kiến tạo một cộng đồng sinh viên mới của riêng bạn.</p>
                </div>

                @foreach (var org in ownedOrgs)
                {
                    <div class="org-card owned-card" @onclick="() => NavigateToOrg(org.OrganizationId)">
                        <div class="card-top">
                            <div class="org-icon">
                                <span class="material-symbols-outlined">@GetRandomIcon(org.Name)</span>
                            </div>
                            <span class="role-badge">CHỦ NHIỆM</span>
                        </div>
                        <div class="card-body">
                            <h3>@org.Name</h3>
                            <p class="org-desc">@(string.IsNullOrWhiteSpace(org.Description) ? "Chưa có mô tả cho tổ chức này." : org.Description)</p>
                        </div>
                        <div class="card-stats">
                            <div class="stat-item">
                                <span class="stat-label">THÀNH VIÊN</span>
                                <span class="stat-value">@GetRandomNumber(100, 500)</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">CHIẾN DỊCH</span>
                                <span class="stat-value">@GetRandomNumber(5, 20)</span>
                            </div>
                        </div>
                        <div class="card-footer">
                            <span class="action-link">Xem chi tiết <span class="material-symbols-outlined" style="font-size: 1rem;">arrow_forward</span></span>
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- SECTION: CÁC TỔ CHỨC TÔI ĐANG THAM GIA -->
        <section class="org-section mt-5">
            <div class="section-header">
                <h2>Các tổ chức tôi đang tham gia</h2>
                <div class="header-line"></div>
                <span class="header-badge member-badge">THÀNH VIÊN (@joinedOrgs.Count)</span>
            </div>

            <div class="org-list-grid">
                @foreach (var org in joinedOrgs)
                {
                    <div class="org-list-card" @onclick="() => NavigateToOrg(org.OrganizationId)">
                        <div class="list-card-icon">
                            <span class="material-symbols-outlined" style="color: #ff9b51;">@GetRandomIcon(org.Name)</span>
                        </div>
                        <div class="list-card-content">
                            <div class="list-card-title-row">
                                <h3>@org.Name</h3>
                                <span class="role-badge-small">THÀNH VIÊN</span>
                            </div>
                            <p class="org-desc-small">@(string.IsNullOrWhiteSpace(org.Description) ? "Nơi kết nối các tâm hồn yêu thích hoạt động và phát triển kỹ năng." : org.Description)</p>
                            <div class="list-card-stats">
                                <div class="stat-sm">
                                    <span class="material-symbols-outlined">group</span>
                                    <span>@GetRandomNumber(50, 200) thành viên</span>
                                </div>
                                <div class="stat-sm">
                                    <span class="material-symbols-outlined">campaign</span>
                                    <span>@GetRandomNumber(2, 10) chiến dịch</span>
                                </div>
                            </div>
                        </div>
                        <div class="list-card-action">
                            <button class="btn-arrow"><span class="material-symbols-outlined">chevron_right</span></button>
                        </div>
                    </div>
                }
                
                @if (joinedOrgs.Count == 0)
                {
                    <div class="empty-state">
                        <p>Bạn chưa tham gia tổ chức nào khác.</p>
                    </div>
                }
            </div>
        </section>
    }
</div>

@code {
    private UserDashboardViewModel? _dashboard;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _dashboard = await DashboardService.GetDashboardAsync();
    }

    private void NavigateToOrg(Guid orgId)
    {
        NavigationManager.NavigateTo($"/org-overview?orgId={orgId}");
    }

    private async Task OnCreateOrganizationClick()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateOrganizationDialog>("Tạo tổ chức", options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CreateOrganizationViewModel model)
        {
            try
            {
                var newOrg = await OrganizationService.CreateOrganizationAsync(model);
                Snackbar.Add($"Đã tạo tổ chức {newOrg.Name} thành công!", Severity.Success);
                await LoadDashboardAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Lỗi khi tạo tổ chức: {ex.Message}", Severity.Error);
            }
        }
    }

    // Mock data helpers
    private string GetRandomIcon(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "eco";
        
        var icons = new[] { "eco", "menu_book", "terminal", "music_note", "sports_esports", "palette" };
        var index = Math.Abs(name.GetHashCode()) % icons.Length;
        return icons[index];
    }
    
    private int GetRandomNumber(int min, int max)
    {
        return new Random().Next(min, max);
    }
}