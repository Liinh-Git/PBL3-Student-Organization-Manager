@page "/departments"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using Org.Frontend.Services.Departments
@using Org.Frontend.Services.Auth
@using Org.Frontend.Services.Members
@using Org.Frontend.Services.Organizations
@using Org.Shared.Contracts
@inject IDepartmentService DepartmentService
@inject IMemberService MemberService
@inject IOrganizationContext OrganizationContext
@inject FrontendAuthStateProvider FrontendAuthStateProvider
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Departments</PageTitle>

<section class="department-shell">
    <header class="department-header">
        <div>
            <p class="dashboard-eyebrow">Module</p>
            <h3>Departments</h3>
        </div>
        <button class="btn btn-success dept-primary-btn" @onclick="OpenCreate">Create Department</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert alert-info department-toast">@Message</div>
    }

    @if (ShowCreateForm)
    {
        <DepartmentForm Model="CreateModel"
                        ManagerOptions="ManagerOptions"
                        SaveText="Create"
                        OnSubmit="CreateDepartment"
                        OnCancel="CloseForms" />
    }

    @if (EditModel is not null)
    {
        <DepartmentForm Model="EditModel"
                        ManagerOptions="ManagerOptions"
                        SaveText="Update"
                        OnSubmit="UpdateDepartment"
                        OnCancel="CloseForms" />
    }

    @if (Departments.Count == 0)
    {
        <p class="department-empty">No departments available.</p>
    }
    else
    {
        <div class="department-table-wrap">
            <table class="table department-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Function</th>
                        <th>Manager</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dept in Departments)
                    {
                        <tr>
                            <td>@dept.DeptName</td>
                            <td>@dept.Function</td>
                            <td class="dept-manager-id">@GetManagerDisplayName(dept.ManagerId)</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEdit(dept)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteDepartment(dept)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private List<DepartmentDto> Departments { get; set; } = [];
    private List<MemberDto> Members { get; set; } = [];
    private DepartmentForm.DepartmentFormModel CreateModel { get; set; } = new();
    private DepartmentForm.DepartmentFormModel? EditModel { get; set; }
    private Guid? EditingDepartmentId { get; set; }
    private Guid? CurrentOrganizationId { get; set; }
    private bool ShowCreateForm { get; set; }
    private string? Message { get; set; }

    private IReadOnlyList<DepartmentForm.ManagerOption> ManagerOptions => Members
        .Select(x => new DepartmentForm.ManagerOption
        {
            Id = x.Id,
            DisplayName = x.DisplayName
        })
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            await ReloadSafely();
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            await InvokeAsync(async () =>
            {
                await ReloadSafely();
                StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private async Task Reload()
    {
        CurrentOrganizationId ??= await OrganizationContext.GetOrganizationIdAsync();
        Members = await MemberService.GetMembers(CurrentOrganizationId.Value);
        Departments = await DepartmentService.GetDepartments(CurrentOrganizationId.Value);
    }

    private async Task ReloadSafely()
    {
        try
        {
            await Reload();
        }
        catch (AuthApiException ex) when (ex.StatusCode == 401)
        {
            await HandleExpiredSessionAsync(ex.Message);
        }
        catch (Exception ex)
        {
            Message = $"Không thể tải dữ liệu departments: {ex.Message}";
        }
    }

    private void OpenCreate()
    {
        ShowCreateForm = true;
        EditModel = null;
        EditingDepartmentId = null;
        CreateModel = new DepartmentForm.DepartmentFormModel();
        Message = null;
    }

    private void OpenEdit(DepartmentDto dept)
    {
        ShowCreateForm = false;
        EditingDepartmentId = dept.Id;
        EditModel = new DepartmentForm.DepartmentFormModel
        {
            DeptName = dept.DeptName,
            ManagerId = dept.ManagerId,
            Function = dept.Function
        };
        Message = null;
    }

    private async Task CreateDepartment()
    {
        if (string.IsNullOrWhiteSpace(CreateModel.DeptName))
        {
            Message = "Department name is required.";
            return;
        }

        try
        {
            await DepartmentService.CreateDepartment(new CreateDepartmentRequest
            {
                OrgId = CurrentOrganizationId ?? await OrganizationContext.GetOrganizationIdAsync(),
                DeptName = CreateModel.DeptName,
                ManagerId = CreateModel.ManagerId,
                Function = CreateModel.Function
            });

            Message = "Department created.";
            ShowCreateForm = false;
            await Reload();
        }
        catch (AuthApiException ex) when (ex.StatusCode == 401)
        {
            await HandleExpiredSessionAsync(ex.Message);
        }
    }

    private async Task UpdateDepartment()
    {
        if (EditModel is null || EditingDepartmentId is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(EditModel.DeptName))
        {
            Message = "Department name is required.";
            return;
        }

        try
        {
            await DepartmentService.UpdateDepartment(EditingDepartmentId.Value, new UpdateDepartmentRequest
            {
                DeptName = EditModel.DeptName,
                ManagerId = EditModel.ManagerId,
                Function = EditModel.Function
            });

            Message = "Department updated.";
            CloseForms();
            await Reload();
        }
        catch (AuthApiException ex) when (ex.StatusCode == 401)
        {
            await HandleExpiredSessionAsync(ex.Message);
        }
    }

    private async Task HandleExpiredSessionAsync(string? reason = null)
    {
        CurrentOrganizationId = null;
        Members = [];
        Departments = [];
        Message = string.IsNullOrWhiteSpace(reason)
            ? "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại."
            : reason;

        await FrontendAuthStateProvider.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void CloseForms()
    {
        ShowCreateForm = false;
        EditModel = null;
        EditingDepartmentId = null;
    }

    private string GetManagerDisplayName(Guid? managerId)
    {
        if (!managerId.HasValue)
            return "-";

        return Members.FirstOrDefault(x => x.Id == managerId.Value)?.DisplayName
            ?? managerId.Value.ToString();
    }

    private async Task DeleteDepartment(DepartmentDto department)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete department '{department.DeptName}'?");
        if (!confirmed)
            return;

        try
        {
            await DepartmentService.DeleteDepartment(department.Id);

            if (EditingDepartmentId == department.Id)
                CloseForms();

            Message = "Department deleted.";
            await Reload();
        }
        catch (AuthApiException ex) when (ex.StatusCode == 401)
        {
            await HandleExpiredSessionAsync(ex.Message);
        }
        catch (Exception ex)
        {
            Message = $"Không thể xóa department: {ex.Message}";
        }
    }
}
