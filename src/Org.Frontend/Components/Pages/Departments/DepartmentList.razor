@page "/org/departments"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Org.Frontend.ViewModels
@using System.Globalization
@using System.Security.Claims
@inject IDepartmentService DepartmentService
@inject IMemberService MemberService
@inject IOrganizationContext OrganizationContext
@inject FrontendAuthStateProvider FrontendAuthStateProvider
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Departments</PageTitle>

<div class="dept-page-container">
    @{
        var filteredCards = GetFilteredDepartmentCards();
        var totalPages = GetDepartmentTotalPages(filteredCards.Count);
        var pagedCards = GetPagedDepartmentCards(filteredCards, totalPages);
    }

    <header class="page-header">
        <div class="header-content">
            <h1 class="page-title">Quan ly phong ban</h1>
            <p class="page-subtitle">
                Dieu phoi hoat dong theo tung bo phan chuc nang. Nhiem vu o day la department tasks, khong phai event tasks.
            </p>
            <div class="dept-toolbar">
                <input class="dept-search-input"
                       type="search"
                       placeholder="Tim phong ban..."
                       value="@_departmentSearch"
                       @oninput="OnDepartmentSearchChanged" />
                <div class="dept-pager">
                    <button type="button" class="icon-btn" disabled="@(_departmentPage <= 1)" @onclick="PrevDepartmentPage">
                        <span class="material-symbols-outlined">chevron_left</span>
                    </button>
                    <span>@_departmentPage / @totalPages</span>
                    <button type="button" class="icon-btn" disabled="@(_departmentPage >= totalPages)" @onclick="NextDepartmentPage">
                        <span class="material-symbols-outlined">chevron_right</span>
                    </button>
                </div>
            </div>
        </div>
        @if (_canManageDepartments)
        {
            <button class="btn-create-dept" @onclick="OpenCreate">
                <span class="material-symbols-outlined">add</span>
                TAO PHONG BAN MOI
            </button>
        }
    </header>

    <DepartmentForm IsOpen="ShowForm"
                    Title="@FormTitle"
                    Description="@FormDescription"
                    Model="ActiveFormModel"
                    ManagerOptions="ManagerOptions"
                    SaveText="@FormSaveText"
                    OnSubmit="HandleFormSubmit"
                    OnCancel="CloseForms" />

    <div class="dept-grid">
        @foreach (var card in pagedCards)
        {
            var canManageTaskInCard = DepartmentTaskCrudEnabled && CanManageDepartmentTasks(card);
            var todoTasks = card.Tasks.Where(IsTodoTask).ToList();
            var overdueTasks = card.Tasks.Where(IsOverdueTask).ToList();
            var doneTasks = card.Tasks.Where(IsDoneTask).ToList();

            <div class="dept-card">
                <span class="material-symbols-outlined watermark-icon">@GetWatermarkIcon(card.Function)</span>

                <div class="dept-card-header">
                    <div class="dept-title-area">
                        <h3>@card.Name</h3>
                        <p>@GetFunctionDisplay(card.Function)</p>
                    </div>

                    <div class="dept-actions">
                        @if (_canManageDepartments)
                        {
                            <button class="icon-btn" title="Sua" @onclick="() => OpenEditById(card.Id)"><span class="material-symbols-outlined">edit</span></button>
                            <button class="icon-btn delete" title="Xoa" @onclick="() => DeleteDepartmentById(card.Id)"><span class="material-symbols-outlined">delete</span></button>
                        }
                    </div>
                </div>

                <div class="dept-manager-badge">
                    <span class="material-symbols-outlined">person</span>
                    <span>Quan ly: <strong>@card.ManagerName</strong></span>
                </div>

                <div class="dept-members-row">
                    <span>Thanh vien:</span>
                    <div class="dept-members-overlap">
                        @foreach (var member in card.MemberPreview.Take(4))
                        {
                            <span class="member-avatar" title="@member.DisplayName">@GetMemberInitials(member.DisplayName)</span>
                        }
                        @if (card.MemberCount > 4)
                        {
                            <div class="member-avatar more-avatar">+@(card.MemberCount - 4)</div>
                        }
                        @if (card.MemberCount == 0)
                        {
                            <span class="empty-members">Chua co thanh vien</span>
                        }
                    </div>
                </div>

                <div class="task-section-header">
                    <h4>NHIEM VU CHUA HOAN THANH</h4>
                    @if (canManageTaskInCard)
                    {
                        <button class="btn-add-task" @onclick="() => OpenCreateTask(card)">
                            <span class="material-symbols-outlined">add</span> Add Task
                        </button>
                    }
                </div>

                <div class="task-list custom-scrollbar">
                    @if (!todoTasks.Any())
                    {
                        <p class="empty-tasks">Khong co task TODO.</p>
                    }
                    else
                    {
                        @foreach (var task in todoTasks)
                        {
                            <div class="task-item" @onclick="() => OpenTaskDetail(card, task)">
                                <div class="task-content">
                                    <div class="task-header-row">
                                        <h5 class="task-title">@task.Title</h5>
                                        <span class="task-badge" style="background-color: #e2e8f0; color: #334155">TODO</span>
                                    </div>
                                    <div class="task-meta-row">
                                        <span class="material-symbols-outlined">calendar_today</span> @FormatDueDate(task.DeadlineAt)
                                    </div>
                                </div>

                                <div class="task-right-col">
                                    <span class="assignee-avatar" title="@task.AssigneeNamesText">
                                        @task.AssigneeAvatarText
                                    </span>
                                    <button class="btn-complete-task"
                                            disabled="@(!CanCompleteTask(card, task))"
                                            title="Mark done"
                                            @onclick:stopPropagation
                                            @onclick="() => MarkTaskDone(card, task)">
                                        <span class="material-symbols-outlined">check_circle</span>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="task-section-header">
                    <h4>NHIEM VU QUA HAN (@overdueTasks.Count)</h4>
                    <button class="icon-btn" @onclick="() => ToggleOverdue(card.Id)">
                        <span class="material-symbols-outlined">@(IsOverdueExpanded(card.Id) ? "expand_less" : "expand_more")</span>
                    </button>
                </div>
                @if (IsOverdueExpanded(card.Id))
                {
                    <div class="task-list custom-scrollbar">
                        @if (!overdueTasks.Any())
                        {
                            <p class="empty-tasks">Khong co task qua han.</p>
                        }
                        else
                        {
                            @foreach (var task in overdueTasks)
                            {
                                <div class="task-item" @onclick="() => OpenTaskDetail(card, task)">
                                    <div class="task-content">
                                        <div class="task-header-row">
                                            <h5 class="task-title">@task.Title</h5>
                                            <span class="task-badge" style="background-color: #fee2e2; color: #b91c1c">OVERDUE</span>
                                        </div>
                                        <div class="task-meta-row">
                                            <span class="material-symbols-outlined">calendar_today</span> @FormatDueDate(task.DeadlineAt)
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }

                <div class="task-section-header">
                    <h4>NHIEM VU DA HOAN THANH (@doneTasks.Count)</h4>
                    <button class="icon-btn" @onclick="() => ToggleCompleted(card.Id)">
                        <span class="material-symbols-outlined">@(IsCompletedExpanded(card.Id) ? "expand_less" : "expand_more")</span>
                    </button>
                </div>
                @if (IsCompletedExpanded(card.Id))
                {
                    <div class="task-list custom-scrollbar">
                        @if (!doneTasks.Any())
                        {
                            <p class="empty-tasks">Khong co task DONE.</p>
                        }
                        else
                        {
                            @foreach (var task in doneTasks)
                            {
                                <div class="task-item" @onclick="() => OpenTaskDetail(card, task)">
                                    <div class="task-content">
                                        <div class="task-header-row">
                                            <h5 class="task-title" style="text-decoration: line-through; opacity: 0.6;">@task.Title</h5>
                                            <span class="task-badge" style="background-color: #1a2634; color: #ffffff">DONE</span>
                                        </div>
                                        <div class="task-meta-row" style="opacity: 0.6;">
                                            <span class="material-symbols-outlined">calendar_today</span> @FormatDueDate(task.DeadlineAt)
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (_isTaskDialogOpen && _taskDraft is not null && _selectedTaskDepartment is not null)
    {
        <div class="task-modal-backdrop" @onclick="CloseTaskDialog">
            <div class="task-modal-content" @onclick:stopPropagation>
                <div class="modal-header">
                    <button class="btn-close-modal" @onclick="CloseTaskDialog">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                    <div class="modal-header-right">
                        <div class="modal-icon-circle">
                            <span class="material-symbols-outlined">assignment</span>
                        </div>
                        <div>
                            <h5 class="modal-kicker">DEPARTMENT TASK</h5>
                        </div>
                    </div>
                    <span class="task-badge" style="margin-left:auto;background-color:#e2e8f0;color:#334155">@_taskDraft.Status</span>
                </div>

                <div class="modal-body custom-scrollbar" style="max-height: 60vh; overflow-y: auto;">
                    <input type="text" class="editable-title editable-input" @bind="_taskDraft.Title" placeholder="Nhap ten task..." />

                    <div class="modal-grid">
                        <div class="modal-info-box">
                            <p class="info-label"><span class="material-symbols-outlined">calendar_today</span> DEADLINE</p>
                            <input type="date" class="editable-input font-bold" @bind="_taskDeadlineInput" />
                        </div>
                        <div class="modal-info-box">
                            <p class="info-label"><span class="material-symbols-outlined">task_alt</span> STATUS</p>
                            <select class="editable-select" @bind="_taskDraft.Status" disabled="@(!_canEditSelectedTask)">
                                <option value="TODO">TODO</option>
                                <option value="DONE">DONE</option>
                            </select>
                        </div>
                        <div class="modal-info-box">
                            <p class="info-label"><span class="material-symbols-outlined">group</span> ASSIGNEES</p>
                            <div class="assignee-checks">
                                @foreach (var option in GetTaskAssigneeOptions(_selectedTaskDepartment.Id))
                                {
                                    <label class="assignee-check-item">
                                        <input type="checkbox"
                                               disabled="@(!_canEditSelectedTask)"
                                               checked="@_taskDraft.AssigneeMemberIds.Contains(option.Id)"
                                               @onchange="args => ToggleTaskAssignee(option.Id, args)" />
                                        <span>@option.DisplayName</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="modal-desc-section">
                        <h4 class="desc-label"><span class="material-symbols-outlined" style="color: #ff9b51;">subject</span> Mo ta</h4>
                        <textarea class="editable-textarea custom-scrollbar"
                                  @bind="_taskDraft.Description"
                                  placeholder="Task nay thuoc department, khong phai event."></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    @if (_isCreatingTask)
                    {
                        <button class="btn-confirm-complete active" @onclick="SaveTaskDraft" disabled="@(!_canEditSelectedTask)">
                            <span class="material-symbols-outlined">save</span> TAO TASK
                        </button>
                    }
                    else
                    {
                        <div class="dialog-actions">
                            @if (_canEditSelectedTask)
                            {
                                <button class="btn-confirm-complete active" @onclick="SaveTaskDraft">
                                    <span class="material-symbols-outlined">save</span> LUU
                                </button>
                                <button class="btn-confirm-complete done" @onclick="DeleteSelectedTask">
                                    <span class="material-symbols-outlined">delete</span> XOA
                                </button>
                            }
                            @if (_canCompleteSelectedTask)
                            {
                                <button class="btn-confirm-complete active" @onclick="CompleteSelectedTask">
                                    <span class="material-symbols-outlined">check_circle</span> MARK DONE
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const int DepartmentsPerPage = 4;
    private static bool DepartmentTaskCrudEnabled => false;

    private List<DepartmentDto> Departments { get; set; } = [];
    private List<MemberDto> Members { get; set; } = [];
    private List<DepartmentWorkspaceCard> DepartmentCards { get; set; } = [];
    private readonly Dictionary<Guid, List<MemberDto>> _departmentMembers = [];

    private DepartmentForm.DepartmentFormModel ActiveFormModel { get; set; } = new();
    private Guid? EditingDepartmentId { get; set; }
    private Guid? CurrentOrganizationId { get; set; }
    private bool ShowForm { get; set; }
    private bool _canManageDepartments;
    private Guid? _currentUserId;
    private string? _currentUserEmail;
    private Guid? _currentMemberId;
    private string _departmentSearch = string.Empty;
    private int _departmentPage = 1;

    private bool _isTaskDialogOpen;
    private bool _isCreatingTask;
    private bool _canEditSelectedTask;
    private bool _canCompleteSelectedTask;
    private DepartmentWorkspaceCard? _selectedTaskDepartment;
    private DepartmentTaskDraft? _taskDraft;
    private DateTime? _taskDeadlineInput;

    private readonly Dictionary<Guid, bool> _overdueExpandedByDept = [];
    private readonly Dictionary<Guid, bool> _completedExpandedByDept = [];

    private string FormTitle { get; set; } = string.Empty;
    private string FormDescription { get; set; } = string.Empty;
    private string FormSaveText { get; set; } = string.Empty;

    private IReadOnlyList<DepartmentForm.ManagerOption> ManagerOptions => Members
        .Select(x => new DepartmentForm.ManagerOption
        {
            Id = x.Id,
            DisplayName = x.DisplayName
        })
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await FrontendAuthStateProvider.InitializeAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            await ReloadSafely();
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            await InvokeAsync(async () =>
            {
                await ReloadSafely();
                StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private async Task Reload()
    {
        CurrentOrganizationId ??= await OrganizationContext.GetOrganizationIdAsync();
        var organizationId = CurrentOrganizationId.Value;

        _currentUserId = await ResolveCurrentUserIdAsync();
        _currentUserEmail = await ResolveCurrentUserEmailAsync();
        _canManageDepartments = await MemberService.CanManageOrganizationMembersAsync(organizationId);

        Members = await MemberService.GetMembers(organizationId);
        Departments = await DepartmentService.GetDepartments(organizationId);
        _currentMemberId = ResolveCurrentMemberId();

        await LoadDepartmentMembersAsync();
        await BuildDepartmentCardsAsync();
    }

    private async Task ReloadSafely()
    {
        try
        {
            await Reload();
        }
        catch (AuthApiException ex) when (ex.StatusCode == 401)
        {
            await HandleExpiredSessionAsync(ex.Message);
        }
        catch (NotSupportedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            DepartmentCards = [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the tai du lieu departments: {ex.Message}", Severity.Error);
            DepartmentCards = [];
        }
    }

    private void OnDepartmentSearchChanged(ChangeEventArgs args)
    {
        _departmentSearch = args.Value?.ToString() ?? string.Empty;
        _departmentPage = 1;
    }

    private List<DepartmentWorkspaceCard> GetFilteredDepartmentCards()
    {
        var keyword = _departmentSearch.Trim();
        if (string.IsNullOrWhiteSpace(keyword))
        {
            return DepartmentCards;
        }

        return DepartmentCards
            .Where(x =>
                x.Name.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || (x.Function?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();
    }

    private int GetDepartmentTotalPages(int totalItems)
    {
        return Math.Max(1, (int)Math.Ceiling(totalItems / (double)DepartmentsPerPage));
    }

    private List<DepartmentWorkspaceCard> GetPagedDepartmentCards(List<DepartmentWorkspaceCard> filteredCards, int totalPages)
    {
        _departmentPage = Math.Clamp(_departmentPage, 1, totalPages);
        return filteredCards
            .Skip((_departmentPage - 1) * DepartmentsPerPage)
            .Take(DepartmentsPerPage)
            .ToList();
    }

    private void PrevDepartmentPage()
    {
        _departmentPage = Math.Max(1, _departmentPage - 1);
    }

    private void NextDepartmentPage()
    {
        var totalPages = GetDepartmentTotalPages(GetFilteredDepartmentCards().Count);
        _departmentPage = Math.Min(totalPages, _departmentPage + 1);
    }

    private void OpenCreate()
    {
        if (!_canManageDepartments)
        {
            Snackbar.Add("Ban khong co quyen tao phong ban.", Severity.Warning);
            return;
        }

        EditingDepartmentId = null;
        ActiveFormModel = new DepartmentForm.DepartmentFormModel();
        FormTitle = "Tao phong ban moi";
        FormDescription = "Khai bao bo phan va phan cong nhan su de bat dau van hanh.";
        FormSaveText = "Tao";
        ShowForm = true;
    }

    private async Task OpenEditAsync(DepartmentDto dept)
    {
        if (!_canManageDepartments)
        {
            Snackbar.Add("Ban khong co quyen chinh sua phong ban.", Severity.Warning);
            return;
        }

        EditingDepartmentId = dept.Id;
        ActiveFormModel = new DepartmentForm.DepartmentFormModel
        {
            DeptName = dept.DeptName,
            ManagerId = dept.ManagerId,
            MemberIds = _departmentMembers.TryGetValue(dept.Id, out var currentMembers)
                ? currentMembers
                    .Where(x => !dept.ManagerId.HasValue || x.Id != dept.ManagerId.Value)
                    .Select(x => x.Id)
                    .Distinct()
                    .ToList()
                : [],
            Function = dept.Function
        };
        FormTitle = "Cap nhat phong ban";
        FormDescription = "Dong bo thong tin bo phan, quan ly va nhan su.";
        FormSaveText = "Cap nhat";
        ShowForm = true;
    }

    private async Task OpenEditById(Guid departmentId)
    {
        var department = Departments.FirstOrDefault(x => x.Id == departmentId);
        if (department is null)
        {
            Snackbar.Add("Khong tim thay phong ban can chinh sua.", Severity.Warning);
            return;
        }

        await OpenEditAsync(department);
    }

    private async Task HandleFormSubmit()
    {
        if (EditingDepartmentId.HasValue)
        {
            await UpdateDepartment();
            return;
        }

        await CreateDepartment();
    }

    private async Task CreateDepartment()
    {
        if (string.IsNullOrWhiteSpace(ActiveFormModel.DeptName))
        {
            Snackbar.Add("Ten phong ban khong duoc de trong.", Severity.Warning);
            return;
        }

        try
        {
            var created = await DepartmentService.CreateDepartment(new CreateDepartmentRequest
            {
                OrgId = CurrentOrganizationId ?? await OrganizationContext.GetOrganizationIdAsync(),
                DeptName = ActiveFormModel.DeptName,
                ManagerId = ActiveFormModel.ManagerId,
                Function = ActiveFormModel.Function
            });

            await SyncDepartmentAssignmentsAsync(
                created.Id,
                ActiveFormModel.ManagerId,
                ActiveFormModel.MemberIds,
                []);

            Snackbar.Add("Phong ban da duoc tao.", Severity.Success);
            CloseForms();
            await Reload();
        }
        catch (AuthApiException ex) when (ex.StatusCode == 401)
        {
            await HandleExpiredSessionAsync(ex.Message);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the tao phong ban: {ex.Message}", Severity.Error);
        }
    }

    private async Task UpdateDepartment()
    {
        if (EditingDepartmentId is null)
            return;

        if (string.IsNullOrWhiteSpace(ActiveFormModel.DeptName))
        {
            Snackbar.Add("Ten phong ban khong duoc de trong.", Severity.Warning);
            return;
        }

        try
        {
            var updated = await DepartmentService.UpdateDepartment(EditingDepartmentId.Value, new UpdateDepartmentRequest
            {
                DeptName = ActiveFormModel.DeptName,
                ManagerId = ActiveFormModel.ManagerId,
                Function = ActiveFormModel.Function
            });

            var existingMemberIds = _departmentMembers.TryGetValue(updated.Id, out var existingRows)
                ? existingRows.Select(x => x.Id).ToList()
                : [];

            await SyncDepartmentAssignmentsAsync(
                updated.Id,
                ActiveFormModel.ManagerId,
                ActiveFormModel.MemberIds,
                existingMemberIds);

            Snackbar.Add("Phong ban da duoc cap nhat.", Severity.Success);
            CloseForms();
            await Reload();
        }
        catch (AuthApiException ex) when (ex.StatusCode == 401)
        {
            await HandleExpiredSessionAsync(ex.Message);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the cap nhat phong ban: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteDepartmentById(Guid departmentId)
    {
        var department = Departments.FirstOrDefault(x => x.Id == departmentId);
        if (department is null)
        {
            Snackbar.Add("Khong tim thay phong ban can xoa.", Severity.Warning);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete department '{department.DeptName}'?");
        if (!confirmed)
            return;

        try
        {
            await DepartmentService.DeleteDepartment(department.Id);
            Snackbar.Add("Phong ban da duoc xoa.", Severity.Success);
            await Reload();
        }
        catch (AuthApiException ex) when (ex.StatusCode == 401)
        {
            await HandleExpiredSessionAsync(ex.Message);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the xoa department: {ex.Message}", Severity.Error);
        }
    }

    private void CloseForms()
    {
        ShowForm = false;
        ActiveFormModel = new();
        EditingDepartmentId = null;
    }

    private async Task BuildDepartmentCardsAsync()
    {
        DepartmentCards = Departments
            .OrderBy(x => x.DeptName, StringComparer.OrdinalIgnoreCase)
            .Select(department =>
            {
                var departmentMembers = _departmentMembers.TryGetValue(department.Id, out var rows)
                    ? rows.OrderBy(x => x.DisplayName, StringComparer.OrdinalIgnoreCase).ToList()
                    : [];

                return new DepartmentWorkspaceCard
                {
                    Id = department.Id,
                    Name = department.DeptName,
                    Function = department.Function,
                    ManagerMemberId = department.ManagerId,
                    ManagerName = GetManagerDisplayName(department.ManagerId),
                    MemberCount = departmentMembers.Count,
                    MemberPreview = departmentMembers.Take(6).ToList(),
                    Tasks = []
                };
            })
            .ToList();
    }

    private async Task LoadDepartmentMembersAsync()
    {
        _departmentMembers.Clear();
        foreach (var department in Departments)
        {
            var members = await DepartmentService.GetDepartmentMembersAsync(department.Id);
            _departmentMembers[department.Id] = members;
        }
    }

    private async Task SyncDepartmentAssignmentsAsync(
        Guid departmentId,
        Guid? managerMemberId,
        IReadOnlyCollection<Guid> selectedMemberIds,
        IReadOnlyCollection<Guid> existingMemberIds)
    {
        var cleanedSelection = selectedMemberIds
            .Where(x => !managerMemberId.HasValue || x != managerMemberId.Value)
            .Distinct()
            .ToHashSet();

        await DepartmentService.AssignManagerAsync(departmentId, managerMemberId);

        var existingSet = existingMemberIds.ToHashSet();
        var toRemove = existingSet.Where(x => !cleanedSelection.Contains(x)).ToList();
        var toAdd = cleanedSelection.Where(x => !existingSet.Contains(x)).ToList();

        foreach (var memberId in toRemove)
        {
            await DepartmentService.RemoveMemberAsync(departmentId, memberId);
        }

        foreach (var memberId in toAdd)
        {
            await DepartmentService.AssignMemberAsync(departmentId, memberId);
        }
    }

    private string GetManagerDisplayName(Guid? managerId)
    {
        if (!managerId.HasValue)
            return "-";

        return Members.FirstOrDefault(x => x.Id == managerId.Value)?.DisplayName ?? managerId.Value.ToString();
    }

    private bool CanManageDepartmentTasks(DepartmentWorkspaceCard card)
    {
        if (_canManageDepartments)
        {
            return true;
        }

        return _currentMemberId.HasValue && card.ManagerMemberId == _currentMemberId.Value;
    }

    private bool CanCompleteTask(DepartmentWorkspaceCard card, DepartmentTaskCard task)
    {
        if (string.Equals(task.Status, "DONE", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (CanManageDepartmentTasks(card))
        {
            return true;
        }

        return _currentMemberId.HasValue && task.AssigneeMemberIds.Contains(_currentMemberId.Value);
    }

    private void OpenCreateTask(DepartmentWorkspaceCard card)
    {
        if (!DepartmentTaskCrudEnabled)
        {
            Snackbar.Add("Department task CRUD chua ho tro trong live API.", Severity.Info);
            return;
        }

        _selectedTaskDepartment = card;
        _isTaskDialogOpen = true;
        _isCreatingTask = true;
        _canEditSelectedTask = CanManageDepartmentTasks(card);
        _canCompleteSelectedTask = false;
        _taskDraft = new DepartmentTaskDraft
        {
            DepartmentId = card.Id,
            Status = "TODO"
        };
        _taskDeadlineInput = DateTime.Today.AddDays(1);
    }

    private void OpenTaskDetail(DepartmentWorkspaceCard card, DepartmentTaskCard task)
    {
        if (!DepartmentTaskCrudEnabled)
        {
            Snackbar.Add("Department task CRUD chua ho tro trong live API.", Severity.Info);
            return;
        }

        _selectedTaskDepartment = card;
        _isTaskDialogOpen = true;
        _isCreatingTask = false;
        _canEditSelectedTask = CanManageDepartmentTasks(card);
        _canCompleteSelectedTask = CanCompleteTask(card, task);
        _taskDraft = DepartmentTaskDraft.FromTask(task);
        _taskDeadlineInput = task.DeadlineAt?.Date;
    }

    private void CloseTaskDialog()
    {
        _isTaskDialogOpen = false;
        _isCreatingTask = false;
        _taskDraft = null;
        _selectedTaskDepartment = null;
        _taskDeadlineInput = null;
        _canEditSelectedTask = false;
        _canCompleteSelectedTask = false;
    }

    private async Task SaveTaskDraft()
    {
        if (!DepartmentTaskCrudEnabled)
        {
            Snackbar.Add("Department task CRUD chua ho tro trong live API.", Severity.Info);
            return;
        }

        if (_taskDraft is null || _selectedTaskDepartment is null)
            return;

        if (!_canEditSelectedTask)
        {
            Snackbar.Add("Ban khong co quyen chinh sua task cua phong ban nay.", Severity.Warning);
            return;
        }

        _taskDraft.DeadlineAt = _taskDeadlineInput;

        try
        {
            if (_isCreatingTask)
            {
                await DepartmentService.CreateDepartmentTaskAsync(_selectedTaskDepartment.Id, new CreateDepartmentTaskRequest
                {
                    Title = _taskDraft.Title,
                    Description = _taskDraft.Description,
                    DeadlineAt = _taskDraft.DeadlineAt,
                    AssigneeMemberIds = _taskDraft.AssigneeMemberIds.ToList()
                });
            }
            else if (_taskDraft.TaskId.HasValue)
            {
                await DepartmentService.UpdateDepartmentTaskAsync(_taskDraft.TaskId.Value, new UpdateDepartmentTaskRequest
                {
                    Title = _taskDraft.Title,
                    Description = _taskDraft.Description,
                    DeadlineAt = _taskDraft.DeadlineAt,
                    Status = _taskDraft.Status,
                    AssigneeMemberIds = _taskDraft.AssigneeMemberIds.ToList()
                });
            }

            Snackbar.Add("Department task da duoc cap nhat.", Severity.Success);
            CloseTaskDialog();
            await ReloadSafely();
        }
        catch (NotSupportedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the luu task: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteSelectedTask()
    {
        if (!DepartmentTaskCrudEnabled)
        {
            Snackbar.Add("Department task CRUD chua ho tro trong live API.", Severity.Info);
            return;
        }

        if (_taskDraft?.TaskId is null || !_canEditSelectedTask)
            return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this department task?");
        if (!confirmed)
            return;

        try
        {
            await DepartmentService.DeleteDepartmentTaskAsync(_taskDraft.TaskId.Value);
            Snackbar.Add("Da xoa department task.", Severity.Success);
            CloseTaskDialog();
            await ReloadSafely();
        }
        catch (NotSupportedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the xoa task: {ex.Message}", Severity.Error);
        }
    }

    private async Task CompleteSelectedTask()
    {
        if (!DepartmentTaskCrudEnabled)
        {
            Snackbar.Add("Department task CRUD chua ho tro trong live API.", Severity.Info);
            return;
        }

        if (_taskDraft?.TaskId is null || !_canCompleteSelectedTask)
            return;

        try
        {
            await DepartmentService.CompleteDepartmentTaskAsync(_taskDraft.TaskId.Value);
            Snackbar.Add("Task da duoc danh dau DONE.", Severity.Success);
            CloseTaskDialog();
            await ReloadSafely();
        }
        catch (NotSupportedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the complete task: {ex.Message}", Severity.Error);
        }
    }

    private async Task MarkTaskDone(DepartmentWorkspaceCard card, DepartmentTaskCard task)
    {
        if (!DepartmentTaskCrudEnabled)
        {
            Snackbar.Add("Department task CRUD chua ho tro trong live API.", Severity.Info);
            return;
        }

        if (!CanCompleteTask(card, task))
        {
            Snackbar.Add("Ban khong co quyen danh dau task nay.", Severity.Warning);
            return;
        }

        try
        {
            await DepartmentService.CompleteDepartmentTaskAsync(task.Id);
            await ReloadSafely();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Khong the cap nhat trang thai: {ex.Message}", Severity.Error);
        }
    }

    private IEnumerable<MemberDto> GetTaskAssigneeOptions(Guid departmentId)
    {
        return _departmentMembers.TryGetValue(departmentId, out var members)
            ? members.OrderBy(x => x.DisplayName, StringComparer.OrdinalIgnoreCase)
            : [];
    }

    private void ToggleTaskAssignee(Guid memberId, ChangeEventArgs args)
    {
        if (_taskDraft is null || !_canEditSelectedTask)
            return;

        var isChecked = args.Value is bool b && b;
        if (isChecked)
        {
            if (!_taskDraft.AssigneeMemberIds.Contains(memberId))
            {
                _taskDraft.AssigneeMemberIds.Add(memberId);
            }
        }
        else
        {
            _taskDraft.AssigneeMemberIds.Remove(memberId);
        }
    }

    private bool IsOverdueExpanded(Guid departmentId)
        => _overdueExpandedByDept.TryGetValue(departmentId, out var value) && value;

    private bool IsCompletedExpanded(Guid departmentId)
        => _completedExpandedByDept.TryGetValue(departmentId, out var value) && value;

    private void ToggleOverdue(Guid departmentId)
        => _overdueExpandedByDept[departmentId] = !IsOverdueExpanded(departmentId);

    private void ToggleCompleted(Guid departmentId)
        => _completedExpandedByDept[departmentId] = !IsCompletedExpanded(departmentId);

    private static bool IsTodoTask(DepartmentTaskCard task)
        => string.Equals(task.Status, "TODO", StringComparison.OrdinalIgnoreCase)
           && !IsOverdueTask(task);

    private static bool IsOverdueTask(DepartmentTaskCard task)
        => string.Equals(task.Status, "TODO", StringComparison.OrdinalIgnoreCase)
           && task.DeadlineAt.HasValue
           && task.DeadlineAt.Value.Date < DateTime.Today;

    private static bool IsDoneTask(DepartmentTaskCard task)
        => string.Equals(task.Status, "DONE", StringComparison.OrdinalIgnoreCase);

    private static DepartmentTaskCard MapTaskCard(DepartmentTaskDto source)
    {
        return new DepartmentTaskCard
        {
            Id = source.Id,
            DepartmentId = source.DepartmentId,
            Title = source.Title,
            Description = source.Description,
            DeadlineAt = source.DeadlineAt,
            Status = source.Status,
            AssigneeMemberIds = source.AssigneeMemberIds.ToList()
        };
    }

    private static string GetFunctionDisplay(string? function)
        => string.IsNullOrWhiteSpace(function) ? "Chua cap nhat mo ta chuc nang." : function;

    private static string GetMemberInitials(string displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName))
            return "NA";

        var parts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();

        return string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }

    private string FormatDueDate(DateTime? dueDate)
    {
        if (!dueDate.HasValue)
            return "No deadline";

        return dueDate.Value.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture);
    }

    private string GetWatermarkIcon(string? function)
    {
        var lower = function?.ToLowerInvariant() ?? string.Empty;
        if (lower.Contains("truyen thong") || lower.Contains("media") || lower.Contains("pr")) return "campaign";
        if (lower.Contains("ky thuat") || lower.Contains("it") || lower.Contains("tech")) return "code_blocks";
        if (lower.Contains("doi ngoai") || lower.Contains("tai tro") || lower.Contains("sponsor")) return "public";
        return "workspaces";
    }

    private async Task<Guid?> ResolveCurrentUserIdAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdText = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(userIdText, out var userId) ? userId : null;
    }

    private async Task<string?> ResolveCurrentUserEmailAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var email = authState.User.FindFirst(ClaimTypes.Email)?.Value;
        return string.IsNullOrWhiteSpace(email) ? null : email.Trim();
    }

    private Guid? ResolveCurrentMemberId()
    {
        if (_currentUserId.HasValue)
        {
            var byUserId = Members.FirstOrDefault(x => x.UserId == _currentUserId.Value)?.Id;
            if (byUserId.HasValue)
            {
                return byUserId;
            }
        }

        if (!string.IsNullOrWhiteSpace(_currentUserEmail))
        {
            return Members.FirstOrDefault(x =>
                    !string.IsNullOrWhiteSpace(x.Email)
                    && string.Equals(x.Email, _currentUserEmail, StringComparison.OrdinalIgnoreCase))
                ?.Id;
        }

        return null;
    }

    private async Task HandleExpiredSessionAsync(string? reason = null)
    {
        CurrentOrganizationId = null;
        Members = [];
        Departments = [];
        DepartmentCards = [];

        var msg = string.IsNullOrWhiteSpace(reason)
            ? "Phien dang nhap da het han. Vui long dang nhap lai."
            : reason;
        Snackbar.Add(msg, Severity.Warning);

        await FrontendAuthStateProvider.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

