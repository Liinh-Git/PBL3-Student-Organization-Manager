@page "/org/departments"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Org.Frontend.ViewModels
@using System.Globalization
@inject IDepartmentService DepartmentService
@inject IMemberService MemberService
@inject IOrganizationContext OrganizationContext
@inject FrontendAuthStateProvider FrontendAuthStateProvider
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Departments</PageTitle>

<div class="dept-page-container">
    <header class="page-header">
        <div class="header-content">
            <h1 class="page-title">Quản lý phòng ban</h1>
            <p class="page-subtitle">
                Điều phối hoạt động theo từng bộ phận chức năng. Bấm vào nút View Full Report để mở rộng và xem tóm tắt của nhiệm vụ.
            </p>
        </div>
        <button class="btn-create-dept" @onclick="OpenCreate">
            <span class="material-symbols-outlined">add</span>
            TẠO PHÒNG BAN MỚI
        </button>
    </header>

    <DepartmentForm IsOpen="ShowForm"
                    Title="@FormTitle"
                    Description="@FormDescription"
                    Model="ActiveFormModel"
                    ManagerOptions="ManagerOptions"
                    SaveText="@FormSaveText"
                    OnSubmit="HandleFormSubmit"
                    OnCancel="CloseForms" />

    <div class="dept-grid">
        @foreach (var card in DepartmentCards)
        {
            <div class="dept-card @(card.IsExpanded ? "expanded" : "")">
                <span class="material-symbols-outlined watermark-icon">@GetWatermarkIcon(card.Function)</span>

                <div class="dept-card-header">
                    <div class="dept-title-area">
                        <h3>@card.Name</h3>
                        <p>@GetFunctionDisplay(card.Function)</p>
                    </div>
                    
                    <div class="dept-members-wrap">
                        <div class="dept-members-overlap">
                            @foreach (var member in card.MemberPreview.Take(3))
                            {
                                <span class="member-avatar" title="@member.DisplayName">@GetMemberInitials(member.DisplayName)</span>
                            }
                            @if (card.MemberCount > 3)
                            {
                                <div class="member-avatar more-avatar">+@(card.MemberCount - 3)</div>
                            }
                        </div>
                        <div class="dept-actions">
                            <button class="icon-btn" title="Sửa" @onclick="() => OpenEditById(card.Id)"><span class="material-symbols-outlined">edit</span></button>
                            <button class="icon-btn delete" title="Xóa" @onclick="() => DeleteDepartmentById(card.Id)"><span class="material-symbols-outlined">delete</span></button>
                        </div>
                    </div>
                </div>

                <div class="dept-manager-badge">
                    <span class="material-symbols-outlined">person</span> 
                    <span>Quản lý bởi: <strong>@card.ManagerName</strong></span>
                </div>

                <div class="task-section-header">
                    <h4>NHIỆM VỤ HIỆN TẠI</h4>
                    <button class="btn-add-task" @onclick="() => NotifyTaskFeature(card.Name)">
                        <span class="material-symbols-outlined">add</span> Add New Task
                    </button>
                </div>

                <div class="task-list">
                    @foreach (var task in (card.IsExpanded ? card.AllTasks : card.AllTasks.Take(2)))
                    {
                        <div class="task-item" @onclick="() => OpenTaskDetail(task)">
                            <div class="task-content">
                                <div class="task-header-row">
                                    <h5 class="task-title">@task.Title</h5>
                                    <span class="task-badge" style="background-color: @task.BadgeBgColor; color: @task.BadgeTextColor">@task.StatusLabel</span>
                                </div>
                                <div class="task-meta-row">
                                    <span class="material-symbols-outlined">calendar_today</span> Due: @task.DueLabel
                                </div>
                                
                                @* Chỉ hiện Summary ngắn gọn khi được Expand *@
                                @if (card.IsExpanded && !string.IsNullOrWhiteSpace(task.Summary))
                                {
                                    <div class="task-summary">
                                        @task.Summary
                                    </div>
                                }
                            </div>
                            
                            <div class="task-right-col">
                                <span class="assignee-avatar" title="@task.AssigneeName">
                                    @(task.AssigneeName == "Chưa phân công" ? "?" : GetMemberInitials(task.AssigneeName))
                                </span>
                                <button class="btn-more" @onclick:stopPropagation><span class="material-symbols-outlined">more_vert</span></button>
                            </div>
                        </div>
                    }
                </div>

                <button class="btn-full-report" @onclick="() => ToggleExpand(card)">
                    @(card.IsExpanded ? "THU GỌN LẠI" : "VIEW FULL REPORT")
                </button>
            </div>
        }
    </div>

    <!-- Popup Chi tiết nhiệm vụ (Hiển thị Description dài) -->
    @if (SelectedTask != null)
    {
        <div class="task-modal-backdrop" @onclick="CloseTaskDetail">
            <div class="task-modal-content" @onclick:stopPropagation>
                <div class="modal-header">
                    <div class="modal-header-left">
                        <div class="modal-icon-circle">
                            <span class="material-symbols-outlined">check_circle</span>
                        </div>
                        <div>
                            <h5 class="modal-kicker">CHI TIẾT NHIỆM VỤ</h5>
                            <span class="task-badge" style="background-color: @SelectedTask.BadgeBgColor; color: @SelectedTask.BadgeTextColor">@SelectedTask.StatusLabel</span>
                        </div>
                    </div>
                    <button class="btn-close-modal" @onclick="CloseTaskDetail">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <div class="modal-body">
                    <h2 class="modal-task-title">@SelectedTask.Title</h2>
                    
                    <div class="modal-grid">
                        <div class="modal-info-box">
                            <p class="info-label"><span class="material-symbols-outlined">calendar_today</span> THỜI HẠN</p>
                            <p class="info-value">@SelectedTask.DueLabel</p>
                        </div>
                        <div class="modal-info-box">
                            <p class="info-label"><span class="material-symbols-outlined">group</span> NGƯỜI PHỤ TRÁCH</p>
                            <div class="assignee-value">
                                <span class="assignee-avatar" style="width: 24px; height: 24px; font-size: 0.6rem;">
                                    @(SelectedTask.AssigneeName == "Chưa phân công" ? "?" : GetMemberInitials(SelectedTask.AssigneeName))
                                </span>
                                <span>@SelectedTask.AssigneeName</span>
                            </div>
                        </div>
                    </div>

                    <div class="modal-desc-section">
                        <h4 class="desc-label"><span class="material-symbols-outlined" style="color: #ff9b51;">subject</span> Mô tả công việc chi tiết</h4>
                        <div class="desc-box">
                            @SelectedTask.Desc
                        </div>
                    </div>
                    
                    <div class="modal-progress-section">
                        <h4 class="progress-label">Tiến độ</h4>
                        <div class="progress-rail">
                            <div class="progress-fill" style="width: 65%;"></div>
                        </div>
                        <p class="progress-text">65% Hoàn thành</p>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn-cancel" @onclick="CloseTaskDetail">Đóng</button>
                    <button class="btn-goto">Đi tới bảng công việc</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<DepartmentDto> Departments { get; set; } = [];
    private List<MemberDto> Members { get; set; } = [];
    private List<DepartmentWorkspaceCard> DepartmentCards { get; set; } = [];
    
    private DepartmentForm.DepartmentFormModel ActiveFormModel { get; set; } = new();
    private Guid? EditingDepartmentId { get; set; }
    private Guid? CurrentOrganizationId { get; set; }
    private bool ShowForm { get; set; }
    
    private string FormTitle { get; set; } = string.Empty;
    private string FormDescription { get; set; } = string.Empty;
    private string FormSaveText { get; set; } = string.Empty;

    private DepartmentTaskCard? SelectedTask { get; set; }

    private IReadOnlyList<DepartmentForm.ManagerOption> ManagerOptions => Members
        .Select(x => new DepartmentForm.ManagerOption
        {
            Id = x.Id,
            DisplayName = x.DisplayName
        })
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            await ReloadSafely();
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            await InvokeAsync(async () =>
            {
                await ReloadSafely();
                StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private async Task Reload()
    {
        CurrentOrganizationId ??= await OrganizationContext.GetOrganizationIdAsync();
        var organizationId = CurrentOrganizationId.Value;

        Members = await MemberService.GetMembers(organizationId);
        Departments = await DepartmentService.GetDepartments(organizationId);

        await BuildDepartmentCardsAsync();
    }

    private async Task ReloadSafely()
    {
        try
        {
            await Reload();
        }
        catch (AuthApiException ex) when (ex.StatusCode == 401)
        {
            await HandleExpiredSessionAsync(ex.Message);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không thể tải dữ liệu departments: {ex.Message}", Severity.Error);
            DepartmentCards = [];
        }
    }

    private void OpenCreate()
    {
        EditingDepartmentId = null;
        ActiveFormModel = new DepartmentForm.DepartmentFormModel();
        FormTitle = "Tạo phòng ban mới";
        FormDescription = "Khai báo bộ phận và phân công người quản lý để bắt đầu vận hành.";
        FormSaveText = "Tạo";
        ShowForm = true;
    }

    private void OpenEdit(DepartmentDto dept)
    {
        EditingDepartmentId = dept.Id;
        ActiveFormModel = new DepartmentForm.DepartmentFormModel
        {
            DeptName = dept.DeptName,
            ManagerId = dept.ManagerId,
            Function = dept.Function
        };
        FormTitle = "Cập nhật phòng ban";
        FormDescription = "Đồng bộ lại thông tin bộ phận, quản lý và mô tả chức năng.";
        FormSaveText = "Cập nhật";
        ShowForm = true;
    }

    private void OpenEditById(Guid departmentId)
    {
        var department = Departments.FirstOrDefault(x => x.Id == departmentId);
        if (department is null)
        {
            Snackbar.Add("Không tìm thấy phòng ban cần chỉnh sửa.", Severity.Warning);
            return;
        }
        OpenEdit(department);
    }

    private async Task HandleFormSubmit()
    {
        if (EditingDepartmentId.HasValue) await UpdateDepartment();
        else await CreateDepartment();
    }

    private async Task CreateDepartment()
    {
        if (string.IsNullOrWhiteSpace(ActiveFormModel.DeptName))
        {
            Snackbar.Add("Tên phòng ban không được để trống.", Severity.Warning);
            return;
        }

        try
        {
            await DepartmentService.CreateDepartment(new CreateDepartmentRequest
            {
                OrgId = CurrentOrganizationId ?? await OrganizationContext.GetOrganizationIdAsync(),
                DeptName = ActiveFormModel.DeptName,
                ManagerId = ActiveFormModel.ManagerId,
                Function = ActiveFormModel.Function
            });

            Snackbar.Add("Phòng ban đã được tạo.", Severity.Success);
            CloseForms();
            await Reload();
        }
        catch (AuthApiException ex) when (ex.StatusCode == 401)
        {
            await HandleExpiredSessionAsync(ex.Message);
        }
    }

    private async Task UpdateDepartment()
    {
        if (EditingDepartmentId is null) return;
        if (string.IsNullOrWhiteSpace(ActiveFormModel.DeptName))
        {
            Snackbar.Add("Tên phòng ban không được để trống.", Severity.Warning);
            return;
        }

        try
        {
            await DepartmentService.UpdateDepartment(EditingDepartmentId.Value, new UpdateDepartmentRequest
            {
                DeptName = ActiveFormModel.DeptName,
                ManagerId = ActiveFormModel.ManagerId,
                Function = ActiveFormModel.Function
            });

            Snackbar.Add("Phòng ban đã được cập nhật.", Severity.Success);
            CloseForms();
            await Reload();
        }
        catch (AuthApiException ex) when (ex.StatusCode == 401)
        {
            await HandleExpiredSessionAsync(ex.Message);
        }
    }

    private async Task HandleExpiredSessionAsync(string? reason = null)
    {
        CurrentOrganizationId = null;
        Members = [];
        Departments = [];
        DepartmentCards = [];

        var msg = string.IsNullOrWhiteSpace(reason)
            ? "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại."
            : reason;
        Snackbar.Add(msg, Severity.Warning);

        await FrontendAuthStateProvider.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void CloseForms()
    {
        ShowForm = false;
        ActiveFormModel = new();
        EditingDepartmentId = null;
    }

    private string GetManagerDisplayName(Guid? managerId)
    {
        if (!managerId.HasValue) return "-";
        return Members.FirstOrDefault(x => x.Id == managerId.Value)?.DisplayName ?? managerId.Value.ToString();
    }

    private async Task DeleteDepartment(DepartmentDto department)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete department '{department.DeptName}'?");
        if (!confirmed) return;

        try
        {
            await DepartmentService.DeleteDepartment(department.Id);

            if (EditingDepartmentId == department.Id) CloseForms();

            Snackbar.Add("Phòng ban đã được xóa.", Severity.Success);
            await Reload();
        }
        catch (AuthApiException ex) when (ex.StatusCode == 401)
        {
            await HandleExpiredSessionAsync(ex.Message);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không thể xóa department: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteDepartmentById(Guid departmentId)
    {
        var department = Departments.FirstOrDefault(x => x.Id == departmentId);
        if (department is null)
        {
            Snackbar.Add("Không tìm thấy phòng ban cần xóa.", Severity.Warning);
            return;
        }
        await DeleteDepartment(department);
    }

    private void NotifyTaskFeature(string departmentName)
    {
        Snackbar.Add($"Tính năng tạo nhiệm vụ mới cho phòng ban '{departmentName}' sẽ sớm ra mắt.", Severity.Info);
    }

    private void NotifyTaskAttachmentFeature(string taskTitle)
    {
        Snackbar.Add($"Tệp đính kèm cho nhiệm vụ '{taskTitle}' sẽ sớm ra mắt.", Severity.Info);
    }

    private void ToggleExpand(DepartmentWorkspaceCard card)
    {
        card.IsExpanded = !card.IsExpanded;
    }

    private void OpenTaskDetail(DepartmentTaskCard task)
    {
        SelectedTask = task;
    }

    private void CloseTaskDetail()
    {
        SelectedTask = null;
    }

    private string GetWatermarkIcon(string? function)
    {
        var lower = function?.ToLowerInvariant() ?? "";
        if (lower.Contains("truyền thông") || lower.Contains("media") || lower.Contains("pr")) return "campaign";
        if (lower.Contains("kỹ thuật") || lower.Contains("it") || lower.Contains("tech")) return "code_blocks";
        if (lower.Contains("đối ngoại") || lower.Contains("tài trợ") || lower.Contains("sponsor")) return "public";
        return "workspaces";
    }

    private async Task BuildDepartmentCardsAsync()
    {
        var membersByDepartment = Members
            .Where(x => x.DepartmentId.HasValue)
            .GroupBy(x => x.DepartmentId!.Value)
            .ToDictionary(
                group => group.Key,
                group => group.OrderBy(x => x.DisplayName, StringComparer.OrdinalIgnoreCase).ToList());

        var overviewTasks = await Task.WhenAll(
            Departments.Select(async department =>
            {
                var overview = await DepartmentService.GetTasksOverviewAsync(department.Id);
                return (department.Id, overview.Items);
            }));

        var tasksByDepartment = overviewTasks.ToDictionary(
            x => x.Id,
            x => (IReadOnlyList<DepartmentTaskItemViewModel>)x.Items);

        DepartmentCards = Departments
            .OrderBy(x => x.DeptName, StringComparer.OrdinalIgnoreCase)
            .Select((department, index) =>
            {
                var departmentMembers = membersByDepartment.TryGetValue(department.Id, out var currentMembers)
                    ? currentMembers : [];
                var departmentTasks = tasksByDepartment.TryGetValue(department.Id, out var currentTasks)
                    ? currentTasks : [];

                return new DepartmentWorkspaceCard
                {
                    Id = department.Id,
                    Name = department.DeptName,
                    Function = department.Function,
                    ManagerName = GetManagerDisplayName(department.ManagerId),
                    MemberCount = departmentMembers.Count,
                    MemberPreview = departmentMembers.Take(4).ToList(),
                    TaskCount = departmentTasks.Count,
                    AllTasks = departmentTasks.Select(MapTaskCard).ToList(),
                    IsExpanded = false
                };
            }).ToList();
    }

    private static DepartmentTaskCard MapTaskCard(DepartmentTaskItemViewModel task)
    {
        var status = GetStatusBadge(task.Status);
        var assigneeName = string.IsNullOrWhiteSpace(task.AssigneeName)
            ? "Chưa phân công" : task.AssigneeName;

        var shortSummary = "Cập nhật tiến độ theo kế hoạch.";
        var longDesc = $"Đây là phần mô tả chi tiết đầy đủ cho nhiệm vụ '{task.Title}'. Nhiệm vụ này yêu cầu người phụ trách phải theo dõi sát sao, liên tục cập nhật trạng thái hoạt động thực tế vào hệ thống và phối hợp với các ban khác để đảm bảo hoàn thành đúng thời hạn. Kiểm tra cẩn thận các tài liệu liên quan trước khi chốt tiến độ.";

        return new DepartmentTaskCard
        {
            Id = Guid.NewGuid(),
            Title = task.Title,
            Summary = shortSummary,
            Desc = longDesc,
            AssigneeName = assigneeName,
            DueLabel = FormatDueDate(task.DueDate),
            StatusLabel = status.Label,
            BadgeBgColor = status.BgColor,
            BadgeTextColor = status.TextColor,
            StripColor = status.StripColor
        };
    }

    private static string GetFunctionDisplay(string? function)
        => string.IsNullOrWhiteSpace(function) ? "Chưa cập nhật mô tả chức năng." : function;

    private static string GetMemberInitials(string displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName)) return "NA";
        var parts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }

    private static string FormatDueDate(DateTime? dueDate)
    {
        if (!dueDate.HasValue) return "Chưa đặt";
        return dueDate.Value.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture);
    }

    private static BadgeInfo GetStatusBadge(string? status)
        => status?.ToUpperInvariant() switch
        {
            "DONE" => new BadgeInfo("HOÀN THÀNH", "#1a2634", "#ffffff", "#1a2634"),
            "IN_PROGRESS" => new BadgeInfo("ĐANG CHẠY", "#ff9b51", "#ffffff", "#ff9b51"),
            "TODO" => new BadgeInfo("CẦN LÀM", "#e2e8f0", "#334155", "#94a3b8"),
            _ => new BadgeInfo("KHÁC", "#f1f5f9", "#475569", "transparent")
        };

    private sealed class DepartmentWorkspaceCard
    {
        public Guid Id { get; init; }
        public string Name { get; init; } = string.Empty;
        public string? Function { get; init; }
        public string ManagerName { get; init; } = "-";
        public int MemberCount { get; init; }
        public IReadOnlyList<MemberDto> MemberPreview { get; init; } = [];
        public int TaskCount { get; init; }
        public IReadOnlyList<DepartmentTaskCard> AllTasks { get; set; } = [];
        public bool IsExpanded { get; set; }
    }

    private sealed class DepartmentTaskCard
    {
        public Guid Id { get; init; }
        public string Title { get; init; } = string.Empty;
        public string Summary { get; init; } = string.Empty;
        public string Desc { get; init; } = string.Empty;
        public string AssigneeName { get; init; } = string.Empty;
        public string DueLabel { get; init; } = string.Empty;
        public string StatusLabel { get; init; } = string.Empty;
        public string BadgeBgColor { get; init; } = string.Empty;
        public string BadgeTextColor { get; init; } = string.Empty;
        public string StripColor { get; init; } = string.Empty;
    }

    private sealed record BadgeInfo(string Label, string BgColor, string TextColor, string StripColor);
}