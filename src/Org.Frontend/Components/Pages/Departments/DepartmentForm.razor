@* ---- Form nhập liệu phòng ban — hiển thị như modal theo IsOpen ---- *@

@if (IsOpen)
{
    <div class="dept-dialog-backdrop" @onclick="OnCancel">
        <section class="dept-dialog-panel custom-scrollbar" role="dialog" aria-modal="true" aria-label="@Title" @onclick:stopPropagation="true">
            <header class="dept-dialog-head">
                <div class="dept-dialog-title-wrap">
                    <h2>@Title</h2>
                    @if (!string.IsNullOrWhiteSpace(Description))
                    {
                        <p>@Description</p>
                    }
                </div>
                <button class="dept-dialog-close" type="button" aria-label="Đóng" @onclick="OnCancel">✕</button>
            </header>

            <EditForm Model="Model" OnValidSubmit="HandleValidSubmit" class="department-form">
                <DataAnnotationsValidator />

                <div class="department-field">
                    <label class="form-label">Tên phòng ban <span style="color:#ef4444">*</span></label>
                    <InputText class="form-control department-input" @bind-Value="Model.DeptName" placeholder="Ví dụ: Ban Truyền thông, Ban Đối ngoại..." />
                    <ValidationMessage For="@(() => Model.DeptName)" />
                </div>

                @* Manager Field *@
                <div class="department-field">
                    <label class="form-label">Người quản lý (Chỉ 1 người)</label>
                    @if (Model.ManagerId.HasValue)
                    {
                        var manager = ManagerOptions.FirstOrDefault(x => x.Id == Model.ManagerId.Value);
                        <div class="selected-chip manager-chip">
                            <div class="chip-avatar">@GetInitials(manager?.DisplayName)</div>
                            <span class="chip-text">@manager?.DisplayName</span>
                            <button type="button" class="chip-remove" @onclick="() => Model.ManagerId = null"><span class="material-symbols-outlined">close</span></button>
                        </div>
                    }
                    else
                    {
                        <InputSelect TValue="Guid?" class="form-select department-input" @bind-Value="Model.ManagerId" @bind-Value:after="OnManagerChanged">
                            <option value="">-- Chọn người quản lý --</option>
                            @foreach (var option in GetManagerSelectionOptions())
                            {
                                <option value="@option.Id">@option.DisplayName</option>
                            }
                        </InputSelect>
                    }
                </div>

                @* Members Field *@
                <div class="department-field">
                    <label class="form-label">Thành viên ban (Có thể chọn nhiều)</label>
                    @if (Model.MemberIds.Any())
                    {
                        <div class="chip-list">
                            @foreach (var mId in Model.MemberIds.ToList())
                            {
                                var member = ManagerOptions.FirstOrDefault(x => x.Id == mId);
                                <div class="selected-chip member-chip">
                                    <div class="chip-avatar">@GetInitials(member?.DisplayName)</div>
                                    <span class="chip-text">@member?.DisplayName</span>
                                    <button type="button" class="chip-remove" @onclick="() => Model.MemberIds.Remove(mId)"><span class="material-symbols-outlined">close</span></button>
                                </div>
                            }
                        </div>
                    }
                    
                    <select class="form-select department-input" @bind="_selectedMemberId" @bind:after="OnMemberSelected">
                        <option value="">-- Chọn thêm thành viên --</option>
                        @foreach (var option in GetMemberSelectionOptions())
                        {
                            <option value="@option.Id">@option.DisplayName</option>
                        }
                    </select>
                </div>

                <div class="department-field">
                    <label class="form-label">Chức năng / Mô tả</label>
                    <InputTextArea class="form-control department-input" @bind-Value="Model.Function" rows="3" placeholder="Mô tả ngắn gọn chức năng của phòng ban..." />
                </div>

                <footer class="department-form-actions">
                    <button type="button" class="btn btn-secondary" @onclick="OnCancel">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary dept-primary-btn">@SaveText</button>
                </footer>
            </EditForm>
        </section>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "Phòng ban";
    [Parameter] public string Description { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public DepartmentFormModel Model { get; set; } = new();

    [Parameter]
    public string SaveText { get; set; } = "Lưu";

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public IReadOnlyList<ManagerOption> ManagerOptions { get; set; } = [];

    private string _selectedMemberId = "";

    private IEnumerable<ManagerOption> GetManagerSelectionOptions()
    {
        return ManagerOptions.Where(option => !Model.MemberIds.Contains(option.Id));
    }

    private IEnumerable<ManagerOption> GetMemberSelectionOptions()
    {
        return ManagerOptions.Where(option =>
            !Model.MemberIds.Contains(option.Id)
            && (!Model.ManagerId.HasValue || option.Id != Model.ManagerId.Value));
    }

    private void OnManagerChanged()
    {
        if (Model.ManagerId.HasValue)
        {
            Model.MemberIds.Remove(Model.ManagerId.Value);
        }
    }

    private void OnMemberSelected()
    {
        if (Guid.TryParse(_selectedMemberId, out var newId))
        {
            if (!Model.MemberIds.Contains(newId) && (!Model.ManagerId.HasValue || Model.ManagerId.Value != newId))
            {
                Model.MemberIds.Add(newId);
            }
        }
        _selectedMemberId = ""; // Reset dropdown
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }

    private Task HandleValidSubmit()
    {
        if (Model.ManagerId.HasValue)
        {
            Model.MemberIds.Remove(Model.ManagerId.Value);
        }

        return OnSubmit.InvokeAsync();
    }

    public sealed class DepartmentFormModel
    {
        public string DeptName { get; set; } = string.Empty;
        public Guid? ManagerId { get; set; }
        public List<Guid> MemberIds { get; set; } = new();
        public string? Function { get; set; }
    }

    public sealed class ManagerOption
    {
        public Guid Id { get; set; }
        public string DisplayName { get; set; } = string.Empty;
    }
}
