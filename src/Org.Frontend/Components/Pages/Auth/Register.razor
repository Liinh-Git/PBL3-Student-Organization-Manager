@* ---- Trang register: nhập thông tin, gọi API register, auto login ---- *@
@page "/register"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject AuthApiClient AuthApiClient
@inject FrontendAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations

<PageTitle>Đăng ký</PageTitle>

<section class="auth-form-shell">
    <header class="auth-form-header">
        <h2>Tạo tài khoản mới</h2>
        <p>Vui lòng điền thông tin để đăng ký</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="auth-alert auth-alert-error">@_errorMessage</div>
    }

    <EditForm FormName="register-form" Model="_model" OnValidSubmit="HandleSubmitAsync" class="auth-form">
        <DataAnnotationsValidator />

        <div class="auth-field-group">
            <label for="register-fullname" class="auth-label">Họ và tên</label>
            <div class="auth-input-wrapper">
                <span class="material-symbols-outlined auth-input-icon">person</span>
                <InputText id="register-fullname" class="auth-input auth-input-with-icon" @bind-Value="_model.FullName" placeholder="Nguyễn Văn A" />
            </div>
            <ValidationMessage For="() => _model.FullName" class="auth-validation" />
        </div>

        <div class="auth-field-group">
            <label for="register-email" class="auth-label">Email</label>
            <div class="auth-input-wrapper">
                <span class="material-symbols-outlined auth-input-icon">mail</span>
                <InputText id="register-email" class="auth-input auth-input-with-icon" @bind-Value="_model.Email" placeholder="email@example.com" />
            </div>
            <ValidationMessage For="() => _model.Email" class="auth-validation" />
        </div>

        <div class="auth-field-group">
            <label for="register-password" class="auth-label">Mật khẩu</label>
            <div class="auth-input-wrapper">
                <span class="material-symbols-outlined auth-input-icon">lock</span>
                <InputText id="register-password" type="password" class="auth-input auth-input-with-icon" @bind-Value="_model.Password" placeholder="••••••••" />
            </div>
            <ValidationMessage For="() => _model.Password" class="auth-validation" />
        </div>

        <div class="auth-field-group">
            <label for="register-confirm-password" class="auth-label">Xác nhận mật khẩu</label>
            <div class="auth-input-wrapper">
                <span class="material-symbols-outlined auth-input-icon">lock_reset</span>
                <InputText id="register-confirm-password" type="password" class="auth-input auth-input-with-icon" @bind-Value="_model.ConfirmPassword" placeholder="••••••••" />
            </div>
            <ValidationMessage For="() => _model.ConfirmPassword" class="auth-validation" />
        </div>

        <label class="auth-checkbox-row" for="register-accept-terms">
            <InputCheckbox id="register-accept-terms" @bind-Value="_model.AcceptTerms" class="auth-checkbox" />
            <span>Tôi đồng ý với các <a href="#">Điều khoản dịch vụ</a> và <a href="#">Chính sách quyền riêng tư</a></span>
        </label>
        <ValidationMessage For="() => _model.AcceptTerms" class="auth-validation" />

        <button type="submit" class="auth-primary-btn" disabled="@_isSubmitting">
            @(_isSubmitting ? "Đang đăng ký..." : "Đăng ký")
        </button>
    </EditForm>

    <div class="auth-divider" role="separator">Hoặc</div>

    <button class="auth-google-btn" type="button" disabled title="Google OAuth sẽ được triển khai ở phase sau.">
        Đăng ký bằng Google (Coming soon)
    </button>

    <p class="auth-footnote">
        Đã có tài khoản?
        <a href="/login">Đăng nhập ngay</a>
    </p>
</section>

@code {
    // Model chứa dữ liệu nhập từ form đăng ký
    private readonly RegisterFormModel _model = new();
    // Cờ trạng thái để tránh submit trùng khi đang gọi API
    private bool _isSubmitting;
    // Thông báo lỗi hiển thị khi đăng ký hoặc đăng nhập tự động thất bại
    private string? _errorMessage;

    // ---- Nếu đã login thì về home, tránh mở lại trang register ----
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await AuthStateProvider.InitializeAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/", forceLoad: false);
    }

    // ---- Submit form: register -> login -> lưu token -> redirect ----
    private async Task HandleSubmitAsync()
    {
        // Bắt đầu submit: khóa nút và reset thông báo lỗi cũ
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            // Bước 1: gọi API đăng ký tài khoản mới
            await AuthApiClient.RegisterAsync(new RegisterRequest
            {
                FullName = _model.FullName.Trim(),
                Email = _model.Email.Trim(),
                Password = _model.Password
            });

            // Bước 2: tự động đăng nhập ngay sau khi đăng ký thành công
            var loginResponse = await AuthApiClient.LoginAsync(new LoginRequest
            {
                Email = _model.Email.Trim(),
                Password = _model.Password
            });

            // Bước 3: lưu token, cập nhật state và chuyển về trang chủ
            await AuthStateProvider.SignInAsync(loginResponse);
            Navigation.NavigateTo("/", forceLoad: false);
        }
        catch (AuthApiException ex)
        {
            // Map status code để hiển thị lỗi thân thiện cho người dùng
            _errorMessage = ex.StatusCode switch
            {
                409 => "Email này đã được đăng ký. Vui lòng dùng email khác.",
                400 => "Thông tin đăng ký chưa hợp lệ. Vui lòng kiểm tra lại.",
                _ => ex.Message
            };
        }
        finally
        {
            // Kết thúc submit: mở lại nút để user có thể thao tác tiếp
            _isSubmitting = false;
        }
    }

    // ---- Model cho form register (validation + so khớp mật khẩu) ----
    private sealed class RegisterFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Vui lòng nhập họ và tên.")]
        [MinLength(2, ErrorMessage = "Họ và tên phải có ít nhất 2 ký tự.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng nhập email.")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu.")]
        [MinLength(8, ErrorMessage = "Mật khẩu phải có tối thiểu 8 ký tự.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng xác nhận mật khẩu.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        [Range(typeof(bool), "true", "true", ErrorMessage = "Bạn cần đồng ý điều khoản để tiếp tục.")]
        public bool AcceptTerms { get; set; }

        // Tự validate: kiểm tra password và confirm password
        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!string.Equals(Password, ConfirmPassword, StringComparison.Ordinal))
            {
                yield return new ValidationResult(
                    "Mật khẩu xác nhận không khớp.",
                    [nameof(ConfirmPassword)]);
            }
        }
    }
}
