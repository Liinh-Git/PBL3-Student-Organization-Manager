@* ---- Trang mẫu có bảo vệ auth: dùng để test render và sự kiện click ---- *@
@* Bảo vệ route do AuthorizeRouteView trong Routes.razor, không dùng [Authorize] ở đây *@
@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    // ---- Lưu trạng thái bộ đếm hiện tại trên UI ----
    private int currentCount = 0;

    // ---- Mỗi lần bấm nút thì tăng bộ đếm thêm 1 ----
    private void IncrementCount()
    {
        currentCount++;
    }
}
