@page "/org/events/{EventId:guid}"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IEventService EventService
@inject IMilestoneService MilestoneService
@inject IEventCategoryService CategoryService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="detail-page">
    @if (eventDetail == null)
    {
        <div class="d-flex align-center justify-center" style="height: 100vh;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        <header class="app-bar">
            <div class="breadcrumb">
                <span style="cursor:pointer" @onclick='() => NavigationManager.NavigateTo("/org/events")'>Events</span>
                <span class="material-symbols-outlined" style="font-size: 1rem;">chevron_right</span>
                <span class="breadcrumb-active">@eventDetail.Name</span>
            </div>
            
            <!-- Đã bỏ thanh search, chuông và avatar theo yêu cầu -->
        </header>

        <section class="hero-section">
              <img class="hero-img" 
                  src="@(eventDetail.ImageUrl ?? "/images/mockimages/Org1/Card1.jpg")" 
                 alt="Background" />
            <div class="hero-gradient"></div>
            <div class="hero-content">
                <div class="hero-badge-row">
                    <span class="status-pill">@eventDetail.StatusLabel</span>
                    <span class="hero-subtitle">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" />
                        @eventDetail.StartDate.ToString("MMM dd") - @eventDetail.EndDate.ToString("MMM dd, yyyy")
                    </span>
                </div>
                <h1 class="hero-title">@eventDetail.Name</h1>
                <p class="hero-desc">@eventDetail.Description</p>
            </div>
        </section>

        <div class="content-container">
            <div class="section-header">
                <div class="section-title">
                    <h2>Lộ trình dự án</h2>
                    <p>Quản lý giai đoạn và hạng mục công việc.</p>
                </div>
                <button class="add-ms-btn" @onclick="OpenCreateMilestoneDialog">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                    THÊM MILESTONE
                </button>
            </div>

            <div class="roadmap-container">
                @foreach (var ms in milestones.Select((value, index) => new { value, index }))
                {
                    var cats = categoriesByMilestone.ContainsKey(ms.value.Id) ? categoriesByMilestone[ms.value.Id] : new();
                    var today = DateTime.Today;
                    
                    bool isAllCatsCompleted = cats.Any() && cats.All(c => c.ProgressPercentage >= 100);
                    bool isCompleted = isAllCatsCompleted || ms.value.EndDate.Date < today;
                    bool isCurrent = !isCompleted && ms.value.StartDate.Date <= today;

                    <div class="milestone-node">
                        <div class="node-icon @(isCompleted ? "completed" : isCurrent ? "active" : "future")">
                            @if (isCompleted) { <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /> }
                            else if (isCurrent) { <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" /> }
                            else { <MudIcon Icon="@Icons.Material.Filled.RadioButtonUnchecked" Size="Size.Small" /> }
                        </div>

                        <div class="ms-card @(isCurrent ? "current-active" : "")">
                            <div class="ms-card-header">
                                <div class="ms-header-info">
                                    <span class="phase-label" style="color: @(isCompleted ? "#22c55e" : isCurrent ? "#f97316" : "#94a3b8")">Phase @(ms.index + 1)</span>
                                    <h3>@ms.value.Name</h3>
                                    <div class="ms-date-range">
                                         <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Style="font-size: 14px;" />
                                         @ms.value.StartDate.ToString("dd/MM/yyyy") 
                                         <MudIcon Icon="@Icons.Material.Filled.ArrowRightAlt" Size="Size.Small" /> 
                                         @ms.value.EndDate.ToString("dd/MM/yyyy")
                                    </div>
                                </div>
                                <button class="add-cat-btn" @onclick="OpenCreateCategoryDialog">
                                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                                    HẠNG MỤC
                                </button>
                            </div>

                            <div class="ms-card-body">
                                @if (cats.Any())
                                {
                                    @foreach (var cat in cats)
                                    {
                                        <div class="cat-item" @onclick="@(() => NavigationManager.NavigateTo(BuildTaskBoardRoute(cat.Id)))">
                                            <div class="cat-info">
                                                <div class="cat-title">
                                                    <p>@cat.Name</p>
                                                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Class="opacity-0 hover-show" Style="font-size: 14px; color: #cbd5e1;" />
                                                </div>
                                                <p class="cat-sub">@cat.ActiveSubtasks công việc phụ đang chạy</p>
                                            </div>

                                            <div class="cat-stats">
                                                <div class="lead-pill">
                                                    <div class="lead-avatar">@GetLeadInitial(cat.LeadName)</div>
                                                    <span class="lead-name">@(string.IsNullOrWhiteSpace(cat.LeadName) ? "Chưa gán" : cat.LeadName)</span>
                                                </div>

                                                <div class="progress-box">
                                                    <span class="progress-label">@cat.ProgressPercentage%</span>
                                                    <div class="progress-bar-bg">
                                                        <div class="progress-bar-fill" style="width: @(cat.ProgressPercentage)%; background: @(cat.ProgressPercentage == 100 ? "#22c55e" : "#f97316")"></div>
                                                    </div>
                                                </div>

                                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Style="color: #cbd5e1" />
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="empty-cat">
                                        <MudIcon Icon="@Icons.Material.Filled.Inbox" Style="color: #e2e8f0; font-size: 2rem;" />
                                        <p>Hạng mục trống</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid EventId { get; set; }

    private EventViewModel? eventDetail;
    private List<MilestoneViewModel> milestones = new();
    
    private Dictionary<Guid, List<EventCategoryViewModel>> categoriesByMilestone = new();
    private List<EventCategoryViewModel> allCategories = new();
    
    private bool _isOrganizationRoute;

    private const string EventsBaseRoute = "/org/events";

    protected override async Task OnInitializedAsync()
    {
        var currentRoute = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim('/');
        _isOrganizationRoute = currentRoute.StartsWith("/org/", StringComparison.OrdinalIgnoreCase);

        await LoadEventDetailAsync();
    }

    private async Task LoadEventDetailAsync()
    {
        eventDetail = await EventService.GetEventDetailAsync(EventId);
        milestones = await MilestoneService.GetMilestonesAsync(EventId);
        
        allCategories.Clear();
        categoriesByMilestone.Clear();

        foreach (var ms in milestones)
        {
            var cats = await CategoryService.GetCategoriesAsync(ms.Id);
            if (cats != null)
            {
                categoriesByMilestone[ms.Id] = cats.ToList();
                allCategories.AddRange(cats);
            }
            else
            {
                categoriesByMilestone[ms.Id] = new List<EventCategoryViewModel>();
            }
        }
    }

    private int GetPercent(string? label)
    {
        if (string.IsNullOrEmpty(label)) return 0;
        var clean = label.TrimEnd('%');
        return int.TryParse(clean, out var val) ? val : 0;
    }

    private string BuildTaskBoardRoute(Guid categoryId) =>
        $"{EventsBaseRoute}/{EventId}/tasks/board/{categoryId}";

    private void OpenCreateTaskDialog()
    {
        var firstCategoryId = allCategories.FirstOrDefault()?.Id;
        if (firstCategoryId.HasValue && firstCategoryId.Value != Guid.Empty)
        {
            NavigationManager.NavigateTo(BuildTaskBoardRoute(firstCategoryId.Value));
            return;
        }

        Snackbar.Add("Chưa có hạng mục để tạo task. Vui lòng tạo milestone/category trước.", Severity.Info);
    }

    private async Task OpenCreateMilestoneDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters
        {
            ["EventId"] = EventId
        };
        var dialog = await DialogService.ShowAsync<CreateMilestoneDialog>("Tạo Milestone", parameters, options);
        var result = await dialog.Result;
        
        if (result is null || result.Canceled || result.Data is not CreateMilestoneViewModel req)
        {
            return;
        }

        req.EventId = EventId;
        await MilestoneService.CreateMilestoneAsync(req);
        await LoadEventDetailAsync();
        Snackbar.Add("Đã tạo milestone mới.", Severity.Success);
    }

    private async Task OpenCreateCategoryDialog()
    {
        if (milestones.Count == 0)
        {
            Snackbar.Add("Cần có milestone trước khi tạo hạng mục.", Severity.Info);
            return;
        }

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters
        {
            ["Milestones"] = milestones.Select(m => new CreateCategoryDialog.MilestoneOption(m.Id, m.Name)).ToList()
        };
        var dialog = await DialogService.ShowAsync<CreateCategoryDialog>("Tạo Hạng Mục", parameters, options);
        var result = await dialog.Result;
        
        if (result is null || result.Canceled || result.Data is not CreateEventCategoryViewModel req)
        {
            return;
        }

        await CategoryService.CreateCategoryAsync(req);
        await LoadEventDetailAsync();
        Snackbar.Add("Đã tạo hạng mục mới.", Severity.Success);
    }

    private static string GetLeadInitial(string? leadName)
    {
        if (string.IsNullOrWhiteSpace(leadName))
        {
            return "NA";
        }

        var parts = leadName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "NA";
        }

        if (parts.Length == 1)
        {
            return parts[0][0].ToString().ToUpperInvariant();
        }

        return string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }
}