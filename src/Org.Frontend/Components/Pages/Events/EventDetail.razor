@page "/org/events/{EventId:guid}"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IEventService EventService
@inject IMilestoneService MilestoneService
@inject IEventCategoryService CategoryService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="detail-page">
    @if (eventDetail == null)
    {
        <div class="d-flex align-center justify-center" style="height: 100vh;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        <!-- Sticky App Bar -->
        <header class="app-bar">
            <div class="breadcrumb">
                <span style="cursor:pointer" @onclick='() => NavigationManager.NavigateTo("/org/events")'>Events</span>
                <span class="material-symbols-outlined" style="font-size: 1rem;">chevron_right</span>
                <span class="breadcrumb-active">@eventDetail.Name</span>
            </div>
            
            <div class="d-flex align-center gap-6">
                <div class="header-search">
                    <span class="material-symbols-outlined search-icon">search</span>
                    <input class="search-input" placeholder="SEARCH WORKSPACE..." type="text" />
                </div>
                <div class="d-flex align-center gap-4">
                    <span class="material-symbols-outlined" style="color: var(--primary); cursor: pointer;">notifications</span>
                    <div style="width: 2rem; height: 2rem; border-radius: 9999px; overflow: hidden; border: 2px solid var(--background);">
                        <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuD1AKBm3yccBzRB36XcVfo-C-fdLR1iOv6tkaOc-YljiJrEwUTELaME-VjqJ5zKYTYNioMB1hsrtzx1IAcg1leUA63dWVNUn-X722ptDy5zfF-6HdqArvfKXCgvPBSPPzulb0vmuxo_ROj8QMffcRSPa5No-ESfi-L_mDpR6EY8NFT1s5GEb0zSatqd5wfEaO4K7cXQB1AzWlAEWS3SBZTf7gpwDS5ozX_v98lnuuoG8013hgicjbMrxQ4kAgU2SZr0rQjjvSQmZzY" 
                             alt="Profile" style="width: 100%; height: 100%; object-fit: cover;" />
                    </div>
                </div>
            </div>
        </header>

        <!-- Hero Section -->
        <section class="hero-section">
            <img class="hero-img" 
                 src="https://lh3.googleusercontent.com/aida-public/AB6AXuABr2iOHd5LvrL8ehdrMPT_dH6PBMT27uvRJdi3NnEH-QmorPbWrPyZp-Cr1_5yH1-ki4c4MZryMuDRD-PJe4-xqgfLDMGUIZiy179Hb9-SJgQ3V7l-BmDKiq7nanXNgi0qWjkASuU46UnxXhI04lY-35yrmV_fKBk1_TCQoYLm2hgnt07gADn_USCQcMf5SOJxqfPTplwBSjZSdQAv8B7kVXIpMeDtR93Ezu_qO0EsLMcO1P78qPtmYCRi-kD-hkdm25CWkpOgy5w" 
                 alt="Background" />
            <div class="hero-gradient"></div>
            <div class="hero-content">
                <div class="hero-badge-row">
                    <span class="status-pill">@eventDetail.StatusLabel</span>
                    <span class="hero-subtitle">@eventDetail.StartDate.ToString("MMM dd") - @eventDetail.EndDate.ToString("MMM dd, yyyy")</span>
                </div>
                <h1 class="hero-title">@eventDetail.Name</h1>
                <p class="hero-desc">@eventDetail.Description</p>
            </div>
        </section>

        <div class="content-grid">
            <!-- Left Column -->
            <div class="main-col">
                
                <!-- Stats Row -->
                <div class="stats-row">
                    <div class="stat-card accent">
                        <p class="stat-label">Completion</p>
                        <h3 class="stat-value">@eventDetail.CompletionLabel</h3>
                        <div class="stat-progress-rail">
                            <div class="stat-progress-fill" style="width: @(GetPercent(eventDetail.CompletionLabel) + "%")"></div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <p class="stat-label">Budget Used</p>
                        <h3 class="stat-value">@eventDetail.BudgetLabel</h3>
                        <p class="stat-trend">↑ Near Limit</p>
                    </div>
                    <div class="stat-card">
                        <p class="stat-label">Days Left</p>
                        <h3 class="stat-value">@((eventDetail.StartDate.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days)</h3>
                        <p class="stat-label" style="font-size: 0.6rem; color: rgba(37, 52, 63, 0.4); margin-top: 0.5rem;">@eventDetail.StartDate.ToString("MMM dd") Deadline</p>
                    </div>
                    <div class="stat-card">
                        <p class="stat-label">Risk Level</p>
                        <h3 class="stat-value risk">@eventDetail.RiskLevel</h3>
                        <p class="stat-label" style="font-size: 0.6rem; color: rgba(37, 52, 63, 0.4); margin-top: 0.5rem;">Stability: High</p>
                    </div>
                </div>

                <!-- Workflow Table -->
                <div class="content-block">
                    <div class="block-header">
                        <h2 class="block-title">Department Workflows</h2>
                        <button class="styled-btn" style="box-shadow: none; padding: 4px 8px; font-size: 0.7rem; color: var(--secondary);" @onclick="OpenCreateCategoryDialog">
                            ADD CATEGORY
                        </button>
                    </div>
                    <table class="workflow-table">
                        <thead class="table-header">
                            <tr>
                                <th>Department</th>
                                <th>Lead</th>
                                <th>Progress</th>
                                <th style="text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in allCategories)
                            {
                                <tr class="table-row">
                                    <td>
                                        <p class="dept-name">@cat.Name</p>
                                        <p class="dept-sub">@cat.ActiveSubtasks Active Subtasks</p>
                                    </td>
                                    <td>
                                        <div class="lead-box">
                                            <div class="d-flex align-center justify-center" style="width: 1.5rem; height: 1.5rem; border-radius: 9999px; background-color: var(--background); font-size: 0.6rem; font-weight: 800;">
                                                @GetLeadInitial(cat.LeadName)
                                            </div>
                                            <span class="lead-name">@cat.LeadName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="progress-rail-small">
                                            <div class="progress-fill-small" style="width: @(cat.ProgressPercentage + "%")"></div>
                                        </div>
                                    </td>
                                    <td style="text-align: right;">
                                        <a class="action-link" href="@BuildTaskBoardRoute(cat.Id)">View Details</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

            <!-- Right Column -->
            <div class="side-col">
                
                <!-- Timeline Section -->
                <div class="content-block timeline-block">
                    <span class="material-symbols-outlined timeline-bg-icon">schedule</span>
                    <div class="d-flex justify-space-between align-center mb-6">
                        <h2 class="block-title">Timeline Milestones</h2>
                        <span class="material-symbols-outlined" style="cursor: pointer; color: var(--secondary);" @onclick="OpenCreateMilestoneDialog">add</span>
                    </div>

                    <div class="timeline-container">
                        <div class="timeline-line"></div>
                        @foreach (var ms in milestones.Select((value, index) => new { value, index }))
                        {
                            var today = DateTime.Today;
                            bool isCompleted = ms.value.EndDate.Date < today;
                            bool isCurrent = !isCompleted && ms.value.StartDate.Date <= today;

                            <div class="timeline-item">
                                <div class='timeline-dot @(isCompleted ? "dot-completed" : (isCurrent ? "dot-active" : ""))'>
                                    @if (isCompleted) {
                                        <span class="material-symbols-outlined text-white" style="font-size: 0.75rem;">check</span>
                                    } else if (isCurrent) {
                                        <div class="pulse"></div>
                                    }
                                </div>
                                <p class="timeline-phase">PHASE @(ms.index + 1): @(ms.value.Name?.Split(':').LastOrDefault()?.Trim().ToUpper() ?? "PLANNING")</p>
                                <h4 class="timeline-title">@(ms.value.Name?.Split(':').FirstOrDefault()?.Trim() ?? "Stage")</h4>
                                <p class="timeline-date">
                                    @(isCompleted
                                        ? $"Completed: {ms.value.EndDate:MMM dd, yyyy}"
                                        : isCurrent
                                            ? $"Active: Est. End {ms.value.EndDate:MMM dd}"
                                            : $"Planned: {ms.value.StartDate:MMM dd} - {ms.value.EndDate:MMM dd}")
                                </p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Info Grid -->
                <div class="info-grid mt-8">
                    <div class="info-card">
                        <span class="material-symbols-outlined info-icon">description</span>
                        <p class="info-label">Total Files</p>
                        <h3 class="info-value">@eventDetail.TotalFiles</h3>
                    </div>
                    <div class="info-card">
                        <span class="material-symbols-outlined info-icon">payments</span>
                        <p class="info-label">Spending</p>
                        <h3 class="info-value">$@eventDetail.ActualSpending.ToString("N0")</h3>
                    </div>
                </div>

                <!-- CTA -->
                <div class="cta-card mt-8">
                    <p class="cta-text">Need a customized report for the board?</p>
                    <button class="cta-btn">Generate Summary</button>
                    <button class="cta-btn" style="background-color: transparent; color: white; border: 1px solid rgba(255,255,255,0.2); margin-top: 0.5rem;" @onclick="OpenCreateTaskDialog">
                        Add New Task
                    </button>
                </div>
            </div>
        </div>

    }
</div>

@code {
    [Parameter] public Guid EventId { get; set; }

    private EventViewModel? eventDetail;
    private List<MilestoneViewModel> milestones = new();
    private List<EventCategoryViewModel> allCategories = new();
    private bool _isOrganizationRoute;

    private const string EventsBaseRoute = "/org/events";

    protected override async Task OnInitializedAsync()
    {
        var currentRoute = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim('/');
        _isOrganizationRoute = currentRoute.StartsWith("/org/", StringComparison.OrdinalIgnoreCase);

        await LoadEventDetailAsync();
    }

    private async Task LoadEventDetailAsync()
    {
        eventDetail = await EventService.GetEventDetailAsync(EventId);
        milestones = await MilestoneService.GetMilestonesAsync(EventId);
        allCategories = [];

        foreach (var ms in milestones)
        {
            var cats = await CategoryService.GetCategoriesAsync(ms.Id);
            if (cats != null)
            {
                allCategories.AddRange(cats);
            }
        }
    }

    private int GetPercent(string? label)
    {
        if (string.IsNullOrEmpty(label)) return 0;
        var clean = label.TrimEnd('%');
        return int.TryParse(clean, out var val) ? val : 0;
    }

    private string BuildTaskBoardRoute(Guid categoryId) =>
        $"{EventsBaseRoute}/{EventId}/tasks/board/{categoryId}";

    private void OpenCreateTaskDialog()
    {
        var firstCategoryId = allCategories.FirstOrDefault()?.Id;
        if (firstCategoryId.HasValue && firstCategoryId.Value != Guid.Empty)
        {
            NavigationManager.NavigateTo(BuildTaskBoardRoute(firstCategoryId.Value));
            return;
        }

        Snackbar.Add("Chưa có hạng mục để tạo task. Vui lòng tạo milestone/category trước.", Severity.Info);
    }

    private async Task OpenCreateMilestoneDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters
        {
            ["EventId"] = EventId
        };

        var dialog = await DialogService.ShowAsync<CreateMilestoneDialog>("Tạo Milestone", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not CreateMilestoneViewModel req)
        {
            return;
        }

        req.EventId = EventId;
        await MilestoneService.CreateMilestoneAsync(req);
        await LoadEventDetailAsync();
        Snackbar.Add("Đã tạo milestone mới.", Severity.Success);
    }

    private async Task OpenCreateCategoryDialog()
    {
        if (milestones.Count == 0)
        {
            Snackbar.Add("Cần có milestone trước khi tạo hạng mục.", Severity.Info);
            return;
        }

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters
        {
            ["Milestones"] = milestones.Select(m => new CreateCategoryDialog.MilestoneOption(m.Id, m.Name)).ToList()
        };

        var dialog = await DialogService.ShowAsync<CreateCategoryDialog>("Tạo Hạng Mục", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not CreateEventCategoryViewModel req)
        {
            return;
        }

        await CategoryService.CreateCategoryAsync(req);
        await LoadEventDetailAsync();
        Snackbar.Add("Đã tạo hạng mục mới.", Severity.Success);
    }

    private static string GetLeadInitial(string? leadName)
    {
        if (string.IsNullOrWhiteSpace(leadName))
        {
            return "NA";
        }

        var parts = leadName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "NA";
        }

        if (parts.Length == 1)
        {
            return parts[0][0].ToString().ToUpperInvariant();
        }

        return string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }
}