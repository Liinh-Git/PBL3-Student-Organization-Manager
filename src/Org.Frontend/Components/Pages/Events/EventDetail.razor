@page "/org/events/{EventId:guid}"
@rendermode InteractiveServer
@using Org.Frontend.Services.Events
@using Org.Frontend.Services.Members
@using Org.Frontend.ViewModels
@using Org.Shared.Contracts
@inject NavigationManager NavigationManager
@inject IEventService EventService
@inject IMilestoneService MilestoneService
@inject IEventCategoryService CategoryService
@inject IMemberService MemberService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="detail-page">
    @if (_isLoading)
    {
        <div class="d-flex align-center justify-center" style="height: 70vh;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="pa-6">
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="LoadEventDetailAsync">Retry</MudButton>
        </div>
    }
    else if (eventDetail is not null)
    {
        <header class="app-bar">
            <div class="breadcrumb">
                <span style="cursor:pointer" @onclick="GoBackToEventList">Events</span>
                <span class="material-symbols-outlined" style="font-size: 1rem;">chevron_right</span>
                <span class="breadcrumb-active">@eventDetail.Name</span>
            </div>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => NavigationManager.NavigateTo(BuildPublicEventRoute()))">Public View</MudButton>
                @if (_canManage)
                {
                    <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" OnClick="OpenUpdateDialog">Edit Event</MudButton>
                }
            </div>
        </header>

        <section class="hero-section">
            <img class="hero-img" src="@(string.IsNullOrWhiteSpace(eventDetail.ImageUrl) ? "/images/mockimages/Org1/Card1.jpg" : eventDetail.ImageUrl)" alt="Background" />
            <div class="hero-gradient"></div>
            <div class="hero-content">
                <div class="hero-badge-row">
                    <span class="status-pill">@eventDetail.StatusLabel</span>
                    <span class="hero-subtitle">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" />
                        @eventDetail.StartDate.ToString("dd/MM/yyyy") - @eventDetail.EndDate.ToString("dd/MM/yyyy")
                    </span>
                </div>
                <h1 class="hero-title">@eventDetail.Name</h1>
                <p class="hero-desc">@(string.IsNullOrWhiteSpace(eventDetail.Description) ? "Su kien dang cap nhat mo ta." : eventDetail.Description)</p>
            </div>
        </section>

        <div class="content-container">
            <MudTabs Rounded="true" PanelClass="pa-4">
                <MudTabPanel Text="Details">
                    <div class="d-flex flex-column gap-4">
                        <MudPaper Class="pa-4">
                            <MudText Typo="Typo.h6">Thong tin su kien</MudText>
                            <MudText Typo="Typo.body2" Class="mt-2">Dia diem: @(string.IsNullOrWhiteSpace(eventDetail.Location) ? "Dang cap nhat" : eventDetail.Location)</MudText>
                            <MudText Typo="Typo.body2">Nguoi tham gia: @eventDetail.RegisteredCount / @eventDetail.TotalSlots</MudText>
                            <MudText Typo="Typo.body2">Tien do cong viec: @(eventDetail.CompletionLabel ?? "0%")</MudText>
                        </MudPaper>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Timeline">
                    <div class="section-header">
                        <div class="section-title">
                            <h2>Lo trinh du an</h2>
                            <p>Quan ly cac milestone theo tung giai doan.</p>
                        </div>
                        @if (_canManage)
                        {
                            <button class="add-ms-btn" @onclick="OpenCreateMilestoneDialog">
                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                                THEM MILESTONE
                            </button>
                        }
                    </div>

                    <div class="roadmap-container">
                        @foreach (var ms in milestones.Select((value, index) => new { value, index }))
                        {
                            var cats = categoriesByMilestone.TryGetValue(ms.value.Id, out var categoryItems)
                                ? categoryItems
                                : [];
                            var today = DateTime.Today;
                            bool isAllCatsCompleted = cats.Any() && cats.All(c => c.ProgressPercentage >= 100);
                            bool isCompleted = isAllCatsCompleted || ms.value.EndDate.Date < today;
                            bool isCurrent = !isCompleted && ms.value.StartDate.Date <= today;

                            <div class="milestone-node">
                                <div class="node-icon @(isCompleted ? "completed" : isCurrent ? "active" : "future")">
                                    @if (isCompleted)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                    }
                                    else if (isCurrent)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.RadioButtonUnchecked" Size="Size.Small" />
                                    }
                                </div>

                                <div class="ms-card @(isCurrent ? "current-active" : "")">
                                    <div class="ms-card-header">
                                        <div class="ms-header-info">
                                            <span class="phase-label" style="color: @(isCompleted ? "#22c55e" : isCurrent ? "#f97316" : "#94a3b8")">Phase @(ms.index + 1)</span>
                                            <h3>@ms.value.Name</h3>
                                            <div class="ms-date-range">
                                                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Style="font-size: 14px;" />
                                                @ms.value.StartDate.ToString("dd/MM/yyyy")
                                                <MudIcon Icon="@Icons.Material.Filled.ArrowRightAlt" Size="Size.Small" />
                                                @ms.value.EndDate.ToString("dd/MM/yyyy")
                                            </div>
                                        </div>
                                        @if (_canManage)
                                        {
                                            <button class="add-cat-btn" @onclick="@(() => OpenCreateCategoryDialog(ms.value.Id))">
                                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                                                HANG MUC
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Work Assignment">
                    <div class="d-flex flex-column gap-4">
                        @if (milestones.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info">Chua co milestone de phan cong cong viec.</MudAlert>
                        }
                        else
                        {
                            @foreach (var milestone in milestones.OrderBy(x => x.OrderIndex))
                            {
                                <MudPaper Class="pa-4">
                                    <div class="d-flex justify-space-between align-center mb-3">
                                        <MudText Typo="Typo.h6">@milestone.Name</MudText>
                                        @if (_canManage)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => OpenCreateCategoryDialog(milestone.Id))">Them category</MudButton>
                                        }
                                    </div>

                                    @{
                                        var categories = categoriesByMilestone.TryGetValue(milestone.Id, out var items) ? items : [];
                                    }
                                    @if (categories.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2">Milestone nay chua co category.</MudText>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-2">
                                            @foreach (var category in categories.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                                            {
                                                <MudPaper Class="pa-3 d-flex justify-space-between align-center" Outlined="true">
                                                    <div>
                                                        <MudText Typo="Typo.subtitle1">@category.Name</MudText>
                                                        <MudText Typo="Typo.caption">Manager: @(string.IsNullOrWhiteSpace(category.LeadName) ? "Chua gan" : category.LeadName)</MudText>
                                                    </div>
                                                    <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                                                               OnClick="@(() => NavigationManager.NavigateTo(BuildTaskBoardRoute(category.Id)))">
                                                        View Category Detail
                                                    </MudButton>
                                                </MudPaper>
                                            }
                                        </div>
                                    }
                                </MudPaper>
                            }
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
        </div>
    }
</div>

@code {
    [Parameter] public Guid EventId { get; set; }

    private EventViewModel? eventDetail;
    private List<MilestoneViewModel> milestones = [];
    private Dictionary<Guid, List<EventCategoryViewModel>> categoriesByMilestone = [];
    private List<MemberDto> _members = [];
    private bool _canManage;
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _safeReturnUrl;
    private Guid? _orgIdFromQuery;

    protected override async Task OnInitializedAsync()
    {
        ResolveNavigationContext();
        await LoadEventDetailAsync();
    }

    private async Task LoadEventDetailAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            eventDetail = await EventService.GetEventDetailAsync(EventId);
            if (eventDetail is null)
            {
                _errorMessage = "Event not found.";
                return;
            }

            _canManage = await EventService.CanManageEventAsync(EventId);
            milestones = await MilestoneService.GetMilestonesAsync(EventId);

            categoriesByMilestone.Clear();
            foreach (var ms in milestones)
            {
                var cats = await CategoryService.GetCategoriesAsync(ms.Id);
                categoriesByMilestone[ms.Id] = cats.ToList();
            }

            _members = await MemberService.GetMembers(eventDetail.OrganizationId);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string BuildTaskBoardRoute(Guid categoryId)
    {
        var route = $"/org/events/{EventId:D}/tasks/board/{categoryId:D}";
        var queryParts = new List<string>();

        if (_orgIdFromQuery.HasValue)
        {
            queryParts.Add($"orgId={_orgIdFromQuery.Value:D}");
        }

        var currentRoute = BuildCurrentRouteWithQuery();
        queryParts.Add($"returnUrl={Uri.EscapeDataString(currentRoute)}");

        return queryParts.Count == 0 ? route : $"{route}?{string.Join("&", queryParts)}";
    }

    private void GoBackToEventList()
    {
        if (!string.IsNullOrWhiteSpace(_safeReturnUrl))
        {
            NavigationManager.NavigateTo(_safeReturnUrl);
            return;
        }

        var orgId = _orgIdFromQuery ?? eventDetail?.OrganizationId;
        if (orgId.HasValue)
        {
            NavigationManager.NavigateTo($"/org/events?orgId={orgId.Value:D}");
            return;
        }

        NavigationManager.NavigateTo("/org/events");
    }

    private string BuildPublicEventRoute()
    {
        var returnUrl = Uri.EscapeDataString(BuildCurrentRouteWithQuery());
        return $"/events/{EventId:D}?returnUrl={returnUrl}";
    }

    private string BuildCurrentRouteWithQuery()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        return $"{uri.AbsolutePath}{uri.Query}";
    }

    private void ResolveNavigationContext()
    {
        _safeReturnUrl = null;
        _orgIdFromQuery = null;

        var currentUri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(currentUri.Query);

        if (query.TryGetValue("returnUrl", out var rawReturnUrl))
        {
            var candidate = rawReturnUrl.ToString();
            if (IsSafeReturnUrl(candidate))
            {
                _safeReturnUrl = candidate;
            }
        }

        if (query.TryGetValue("orgId", out var rawOrgId) && Guid.TryParse(rawOrgId, out var orgId))
        {
            _orgIdFromQuery = orgId;
        }
    }

    private static bool IsSafeReturnUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        if (!value.StartsWith("/", StringComparison.Ordinal))
            return false;

        if (value.StartsWith("//", StringComparison.Ordinal))
            return false;

        if (value.Contains("://", StringComparison.Ordinal))
            return false;

        return true;
    }

    private async Task OpenUpdateDialog()
    {
        if (!_canManage || eventDetail is null)
            return;

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters
        {
            ["Model"] = new UpdateEventViewModel
            {
                EventId = eventDetail.Id,
                Name = eventDetail.Name,
                Description = eventDetail.Description,
                StartDate = eventDetail.StartDate.ToDateTime(TimeOnly.MinValue),
                EndDate = eventDetail.EndDate.ToDateTime(TimeOnly.MinValue),
                Location = eventDetail.Location,
                TotalSlots = eventDetail.TotalSlots
            }
        };

        var dialog = await DialogService.ShowAsync<UpdateEventDialog>("Update event", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not UpdateEventViewModel req)
            return;

        await EventService.UpdateEventAsync(EventId, req);
        await LoadEventDetailAsync();
        Snackbar.Add("Cap nhat su kien thanh cong.", Severity.Success);
    }

    private async Task OpenCreateMilestoneDialog()
    {
        if (!_canManage)
        {
            Snackbar.Add("Ban khong co quyen tao milestone.", Severity.Warning);
            return;
        }

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters { ["EventId"] = EventId };
        var dialog = await DialogService.ShowAsync<CreateMilestoneDialog>("Tao Milestone", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not CreateMilestoneViewModel req)
            return;

        req.EventId = EventId;
        await MilestoneService.CreateMilestoneAsync(req);
        await LoadEventDetailAsync();
        Snackbar.Add("Da tao milestone moi.", Severity.Success);
    }

    private async Task OpenCreateCategoryDialog(Guid defaultMilestoneId)
    {
        if (!_canManage)
        {
            Snackbar.Add("Ban khong co quyen tao category.", Severity.Warning);
            return;
        }

        if (milestones.Count == 0)
        {
            Snackbar.Add("Can co milestone truoc khi tao category.", Severity.Info);
            return;
        }

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters
        {
            ["Milestones"] = milestones
                .Select(m => new CreateCategoryDialog.MilestoneOption(m.Id, m.Name))
                .ToList(),
            ["Members"] = _members
                .Select(m => new CreateCategoryDialog.MemberOption(m.Id, m.DisplayName))
                .ToList(),
            ["DefaultMilestoneId"] = defaultMilestoneId
        };

        var dialog = await DialogService.ShowAsync<CreateCategoryDialog>("Tao category", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not CreateEventCategoryViewModel req)
            return;

        await CategoryService.CreateCategoryAsync(req);
        await LoadEventDetailAsync();
        Snackbar.Add("Da tao category moi.", Severity.Success);
    }
}
