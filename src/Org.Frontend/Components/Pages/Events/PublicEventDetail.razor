@page "/events/{EventId:guid}"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using Org.Frontend.Services.Events
@using Org.Frontend.ViewModels
@inject IEventService EventService
@inject NavigationManager Navigation

@if (_isLoading)
{
    <div class="app-layout">
        <div class="state-card">
            <i class="fas fa-spinner fa-spin fa-2x"></i>
            <p>Dang tai thong tin su kien...</p>
        </div>
    </div>
}
else if (_event is null)
{
    <div class="app-layout">
        <div class="state-card error">
            <i class="fas fa-exclamation-triangle fa-2x"></i>
            <p>@(_errorMessage ?? "Khong tim thay su kien.")</p>
        </div>
    </div>
}
else
{
    <div class="app-layout">
        <header class="nav-header">
            <button class="nav-btn" @onclick="GoBack"><i class="fas fa-arrow-left"></i> Quay lai</button>
        </header>

        <section class="hero-section">
            <img src="@ResolveImage(_event.ImageUrl)" alt="Banner" class="hero-img" />
            <div class="hero-content">
                <h1 class="hero-title">@_event.Name</h1>
                <p class="hero-summary">@(_event.Description ?? "Su kien dang cap nhat noi dung.")</p>
                <div class="hero-actions">
                    <button class="btn-main @(_isRegistered ? "registered" : "")" @onclick="ToggleRegistrationAsync" disabled="@_processingRegistration">
                        @if (_isRegistered)
                        {
                            <i class="fas fa-user-check"></i> <span>Da dang ky</span>
                        }
                        else
                        {
                            <i class="fas fa-bolt"></i> <span>Dang ky tham gia</span>
                        }
                    </button>
                </div>
            </div>
        </section>

        <section class="stats-row">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-calendar-alt"></i></div>
                <div>
                    <h4>THOI GIAN</h4>
                    <p>@_event.StartDate.ToString("dd/MM/yyyy") - @_event.EndDate.ToString("dd/MM/yyyy")</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-map-marker-alt"></i></div>
                <div>
                    <h4>DIA DIEM</h4>
                    <p>@ResolveLocation(_event.Location)</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-users"></i></div>
                <div>
                    <h4>THAM GIA</h4>
                    <p>@_registeredCount / @(_event.TotalSlots <= 0 ? 0 : _event.TotalSlots)</p>
                </div>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public Guid EventId { get; set; }

    private EventViewModel? _event;
    private bool _isLoading = true;
    private bool _isRegistered;
    private bool _processingRegistration;
    private int _registeredCount;
    private string? _errorMessage;
    private string? _safeReturnUrl;

    protected override async Task OnParametersSetAsync()
    {
        ResolveReturnUrl();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _event = await EventService.GetPublicEventDetailAsync(EventId);
            if (_event is not null)
            {
                _registeredCount = _event.RegisteredCount;
            }

            await ResolveRegistrationStateAsync();
        }
        catch (Exception ex)
        {
            _event = null;
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ResolveRegistrationStateAsync()
    {
        try
        {
            var myEvents = await EventService.GetMyEventsAsync();
            _isRegistered = myEvents.AttendeeEvents.Any(x => x.EventId == EventId)
                || myEvents.OrganizerEvents.Any(x => x.EventId == EventId);
        }
        catch
        {
            _isRegistered = false;
        }
    }

    private async Task ToggleRegistrationAsync()
    {
        if (_event is null)
            return;

        _processingRegistration = true;
        try
        {
            if (_isRegistered)
            {
                await EventService.UnregisterEventAsync(EventId);
                _isRegistered = false;
                _registeredCount = Math.Max(0, _registeredCount - 1);
            }
            else
            {
                await EventService.RegisterEventAsync(EventId);
                _isRegistered = true;
                _registeredCount++;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _processingRegistration = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo(_safeReturnUrl ?? "/user/events");
    }

    private void ResolveReturnUrl()
    {
        _safeReturnUrl = null;

        var currentUri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(currentUri.Query);
        if (!query.TryGetValue("returnUrl", out var rawValue))
            return;

        var candidate = rawValue.ToString();
        if (IsSafeReturnUrl(candidate))
        {
            _safeReturnUrl = candidate;
        }
    }

    private static bool IsSafeReturnUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        if (!value.StartsWith("/", StringComparison.Ordinal))
            return false;

        if (value.StartsWith("//", StringComparison.Ordinal))
            return false;

        if (value.Contains("://", StringComparison.Ordinal))
            return false;

        return true;
    }

    private static string ResolveImage(string? imageUrl)
        => string.IsNullOrWhiteSpace(imageUrl) ? "/images/mockimages/Org1/Card1.jpg" : imageUrl;

    private static string ResolveLocation(string? location)
        => string.IsNullOrWhiteSpace(location) ? "Dia diem se cap nhat" : location;
}
