@using MudBlazor
@using Org.Frontend.ViewModels
@inject ISnackbar Snackbar

<MudDialog DisableSidePadding="true" Class="custom-dialog-border">
    <TitleContent>
        <div class="px-6 pt-4 pb-2">
            <MudText Typo="Typo.h5" Class="fw-bold mb-1" Style="color: #1e293b;">Thêm Milestone mới</MudText>
            <MudText Typo="Typo.body2" Style="color: #64748b;">Thiết lập giai đoạn và thời gian triển khai cụ thể cho sự kiện.</MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="px-6">
            <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1" Style="color: #334155;">Tên Milestone</MudText>
            <MudTextField @bind-Value="model.Name"
                          Placeholder="Ví dụ: Phase 1: Planning, Giai đoạn chuẩn bị..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4" />

            <MudGrid Class="mb-4" Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1" Style="color: #334155;">Ngày bắt đầu</MudText>
                    <MudDatePicker @bind-Date="model.StartDate"
                                   Placeholder="-- Chọn ngày --"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   IconSize="Size.Small" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1" Style="color: #334155;">Ngày kết thúc</MudText>
                    <MudDatePicker @bind-Date="model.EndDate"
                                   Placeholder="-- Chọn ngày --"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   IconSize="Size.Small" />
                </MudItem>
            </MudGrid>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="px-6 pb-4 pt-2 w-100 d-flex justify-end gap-3">
            <MudButton OnClick="Cancel" 
                       Variant="Variant.Filled" 
                       Style="background-color: #64748b; color: white; border-radius: 6px; text-transform: none; padding: 8px 20px; font-weight: 500;">
                Hủy bỏ
            </MudButton>
            <MudButton OnClick="Submit" 
                       Variant="Variant.Filled" 
                       Style="background-color: #f97316; color: white; border-radius: 6px; text-transform: none; padding: 8px 28px; font-weight: 600;">
                Tạo milestone
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

<style>
    /* Ẩn label mặc định của MudBlazor vì chúng ta đã tự viết nhãn ở trên */
    .mud-input-label {
        display: none !important;
    }
    
    /* Làm bo góc cho toàn bộ Dialog */
    .custom-dialog-border {
        border-radius: 12px !important;
    }
    
    /* Chỉnh lại màu viền của input cho thanh thoát hơn */
    .mud-input-outlined-border {
        border-color: #cbd5e1 !important;
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public Guid EventId { get; set; }

    private readonly CreateMilestoneViewModel model = new()
    {
        StartDate = DateTime.Today,
        EndDate = DateTime.Today.AddDays(7)
    };

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(model.Name))
        {
            Snackbar.Add("Vui lòng nhập tên milestone.", Severity.Warning);
            return;
        }

        if (!model.StartDate.HasValue || !model.EndDate.HasValue)
        {
            Snackbar.Add("Vui lòng chọn đầy đủ ngày bắt đầu và kết thúc.", Severity.Warning);
            return;
        }

        if (model.EndDate.Value.Date < model.StartDate.Value.Date)
        {
            Snackbar.Add("Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu.", Severity.Warning);
            return;
        }

        model.EventId = EventId;
        // Gửi data về cho hàm OpenCreateMilestoneDialog ở EventDetail.razor
        MudDialog?.Close(DialogResult.Ok(model));
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }
}