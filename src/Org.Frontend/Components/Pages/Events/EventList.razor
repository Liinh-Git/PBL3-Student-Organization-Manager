@page "/org/events"
@rendermode InteractiveServer
@using Org.Frontend.Services.Events
@using Org.Frontend.Services.Organizations
@using Org.Frontend.ViewModels
@inject IEventService EventService
@inject IOrganizationContext OrganizationContext
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="events-page">
    <header class="glass-header">
        <div class="header-main">
            <h1 class="header-title">Manage Events</h1>
            <div class="breadcrumb">
                <span>Directory</span>
                <span class="material-symbols-outlined" style="font-size: 10px; font-weight: 900;">chevron_right</span>
                <span class="breadcrumb-active">All Events</span>
            </div>
        </div>

        <div class="header-actions">
            <div class="search-container">
                <span class="material-symbols-outlined search-icon">search</span>
                <input class="search-input"
                       placeholder="Search events..."
                       type="text"
                       @bind="SearchTerm"
                       @bind:event="oninput" />
            </div>
        </div>
    </header>

    <div class="page-content">
        <div class="controls-bar">
            <div class="filter-capsule">
                <button class="filter-item @(statusFilter == "All" ? "active" : "")" @onclick='() => OnStatusFilterChanged("All")'>All Events</button>
                <button class="filter-item @(statusFilter == "Upcoming" ? "active" : "")" @onclick='() => OnStatusFilterChanged("Upcoming")'>Upcoming</button>
                <button class="filter-item @(statusFilter == "Ongoing" ? "active" : "")" @onclick='() => OnStatusFilterChanged("Ongoing")'>Ongoing</button>
                <button class="filter-item @(statusFilter == "Past" ? "active" : "")" @onclick='() => OnStatusFilterChanged("Past")'>Past Events</button>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="d-flex justify-center pa-10">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="d-flex flex-column gap-4 pa-8">
                <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadEvents">Retry</MudButton>
            </div>
        }
        else
        {
            <div class="bento-grid">
                @if (_canCreateEvent)
                {
                    <div class="create-card" @onclick="OpenCreateDialog">
                        <div class="create-icon-circle">
                            <span class="material-symbols-outlined" style="font-size: 2.5rem; font-weight: 300;">add</span>
                        </div>
                        <span style="font-weight: 800; color: var(--primary); font-size: 1.1rem;">Create New Event</span>
                        <p style="font-size: 0.85rem; color: rgba(37, 52, 63, 0.6); margin-top: 0.5rem; text-align: center; max-width: 220px;">
                            Event moi chi tao tu du lieu nguoi dung nhap.
                        </p>
                    </div>
                }

                @foreach (var evt in filteredEvents)
                {
                    var status = evt.StatusLabel?.ToLowerInvariant() ?? "upcoming";
                    var statusClass = status switch
                    {
                        "ongoing" => "status-ongoing",
                        "completed" => "status-completed",
                        _ => "status-upcoming"
                    };

                    <div class="premium-card">
                        <div class="card-img-box">
                            <img class="card-image" src="@ResolveImage(evt.ImageUrl)" alt="@evt.Name" />
                            <div class="status-tag @statusClass">@evt.StatusLabel</div>
                            @if (evt.CanManage)
                            {
                                <div class="card-dropdown" @onclick:stopPropagation="true">
                                    <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Color="Color.Surface" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                        <MudMenuItem OnClick="@(async () => await OpenUpdateDialog(evt))">Edit</MudMenuItem>
                                        <MudMenuItem OnClick="@(async () => await DeleteEventAsync(evt))">Delete</MudMenuItem>
                                    </MudMenu>
                                </div>
                            }
                        </div>

                        <div class="card-body">
                            <h3 class="card-title">@evt.Name</h3>
                            <div class="card-meta-list">
                                <div class="meta-row">
                                    <span class="material-symbols-outlined">calendar_today</span>
                                    <span>@evt.StartDate.ToString("dd/MM/yyyy") - @evt.EndDate.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="meta-row">
                                    <span class="material-symbols-outlined">location_on</span>
                                    <span>@(string.IsNullOrWhiteSpace(evt.Location) ? "Dia diem se cap nhat" : evt.Location)</span>
                                </div>
                            </div>

                            <div class="progress-meta">
                                <span class="participants-count">@evt.RegisteredCount/@evt.TotalSlots</span>
                                <span class="capacity-percent text-@status">@evt.CompletionLabel</span>
                            </div>
                            <div class="progress-rail-modern">
                                <div class="progress-fill-modern fill-@status" style="width:@(Math.Clamp(evt.CompletionPercentage, 0, 100))%"></div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-4">
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => GoToPublicDetail(evt.Id))">View Details</MudButton>
                                <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" Disabled="@(!evt.CanEnterWorkspace)" OnClick="@(() => GoToWorkspace(evt.Id))">Enter Workspace</MudButton>
                                @if (evt.CanManage)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Warning" OnClick="@(async () => await OpenUpdateDialog(evt))">Edit</MudButton>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="@(async () => await DeleteEventAsync(evt))">Delete</MudButton>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @if (_canCreateEvent)
    {
        <button class="context-fab" @onclick="OpenCreateDialog">
            <span class="material-symbols-outlined" style="font-size: 2rem;">add</span>
        </button>
    }
</div>

@code {
    private List<EventViewModel>? events;
    private List<EventViewModel> filteredEvents = [];
    private string searchTerm = string.Empty;
    private string statusFilter = "All";
    private Guid currentOrgId;
    private bool _canCreateEvent;
    private bool _isLoading = true;
    private string? _errorMessage;

    private string SearchTerm
    {
        get => searchTerm;
        set
        {
            if (string.Equals(searchTerm, value, StringComparison.Ordinal))
                return;

            searchTerm = value;
            ApplyFilters();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        currentOrgId = await OrganizationContext.GetOrganizationIdAsync();
        await LoadEvents();
    }

    private async Task LoadEvents()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _canCreateEvent = await EventService.CanCreateEventAsync(currentOrgId);
            events = await EventService.GetEventsAsync(currentOrgId);
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnStatusFilterChanged(string value)
    {
        statusFilter = string.IsNullOrWhiteSpace(value) ? "All" : value;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (events is null)
        {
            filteredEvents = [];
            return;
        }

        filteredEvents = events
            .Where(evt => string.IsNullOrWhiteSpace(searchTerm) || evt.Name.Contains(searchTerm.Trim(), StringComparison.OrdinalIgnoreCase))
            .Where(evt => statusFilter switch
            {
                "Past" => string.Equals(evt.StatusLabel, "COMPLETED", StringComparison.OrdinalIgnoreCase),
                "Ongoing" => string.Equals(evt.StatusLabel, "ONGOING", StringComparison.OrdinalIgnoreCase),
                "Upcoming" => string.Equals(evt.StatusLabel, "UPCOMING", StringComparison.OrdinalIgnoreCase),
                _ => true
            })
            .OrderBy(x => x.StartDate)
            .ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task OpenCreateDialog()
    {
        if (!_canCreateEvent)
        {
            Snackbar.Add("Ban khong co quyen tao su kien.", Severity.Warning);
            return;
        }

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateEventDialog>("Tao su kien", options);
        if (dialog is null)
            return;

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not CreateEventViewModel req)
            return;

        await EventService.CreateEventAsync(req);
        await LoadEvents();
        Snackbar.Add("Tao su kien thanh cong.", Severity.Success);
    }

    private async Task OpenUpdateDialog(EventViewModel evt)
    {
        if (!evt.CanManage)
        {
            Snackbar.Add("Ban khong co quyen cap nhat su kien nay.", Severity.Warning);
            return;
        }

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters
        {
            ["Model"] = new UpdateEventViewModel
            {
                EventId = evt.Id,
                Name = evt.Name,
                Description = evt.Description,
                StartDate = evt.StartDate.ToDateTime(TimeOnly.MinValue),
                EndDate = evt.EndDate.ToDateTime(TimeOnly.MinValue),
                Location = evt.Location,
                TotalSlots = evt.TotalSlots
            }
        };

        var dialog = await DialogService.ShowAsync<UpdateEventDialog>("Cap nhat su kien", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not UpdateEventViewModel req)
            return;

        await EventService.UpdateEventAsync(evt.Id, req);
        await LoadEvents();
        Snackbar.Add("Cap nhat su kien thanh cong.", Severity.Success);
    }

    private async Task DeleteEventAsync(EventViewModel evt)
    {
        if (!evt.CanManage)
        {
            Snackbar.Add("Ban khong co quyen xoa su kien nay.", Severity.Warning);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Xoa su kien '{evt.Name}'?");
        if (!confirmed)
            return;

        await EventService.DeleteEventAsync(evt.Id);
        await LoadEvents();
        Snackbar.Add("Da xoa su kien.", Severity.Success);
    }

    private static string ResolveImage(string? imageUrl)
        => string.IsNullOrWhiteSpace(imageUrl) ? "/images/mockimages/Org1/Avt.jpg" : imageUrl;

    private void GoToPublicDetail(Guid eventId)
        => NavigationManager.NavigateTo($"/events/{eventId:D}");

    private void GoToWorkspace(Guid eventId)
        => NavigationManager.NavigateTo($"/org/events/{eventId:D}?orgId={currentOrgId:D}");
}
