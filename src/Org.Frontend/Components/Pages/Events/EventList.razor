@page "/org/events"
@rendermode InteractiveServer
@inject IEventService EventService
@inject IOrganizationContext OrganizationContext
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="events-page">
    
    <!-- Thanh điều hướng trên cùng (Sticky Glass) -->
    <header class="glass-header">
        <div class="header-main">
            <h1 class="header-title">Manage Events</h1>
            <div class="breadcrumb">
                <span>Directory</span>
                <span class="material-symbols-outlined" style="font-size: 10px; font-weight: 900;">chevron_right</span>
                <span class="breadcrumb-active">All Events</span>
            </div>
        </div>
        
        <div class="header-actions">
            <div class="search-container">
                <span class="material-symbols-outlined search-icon">search</span>
                <input class="search-input" 
                       placeholder="Search events..." 
                       type="text"
                       @bind="SearchTerm"
                       @bind:event="oninput" />
            </div>
            <button class="icon-btn">
                <span class="material-symbols-outlined">notifications</span>
            </button>
            <button class="icon-btn">
                <span class="material-symbols-outlined">help</span>
            </button>
        </div>
    </header>

    <!-- Nội dung trang có thể cuộn -->
    <div class="page-content">
        
        <!-- Bộ lọc và các điều khiển phụ -->
        <div class="controls-bar">
            <div class="filter-capsule">
                <button class="filter-item @(statusFilter == "All" ? "active" : "")" 
                        @onclick='() => OnStatusFilterChanged("All")'>All Events</button>
                <button class="filter-item @(statusFilter == "Upcoming" ? "active" : "")" 
                        @onclick='() => OnStatusFilterChanged("Upcoming")'>Upcoming</button>
                <button class="filter-item @(statusFilter == "Past" ? "active" : "")" 
                        @onclick='() => OnStatusFilterChanged("Past")'>Past Events</button>
            </div>
            
            <div class="action-buttons">
                <button class="styled-btn">
                    <span class="material-symbols-outlined">filter_list</span>
                    <span>Filter</span>
                </button>
                <button class="styled-btn">
                    <span class="material-symbols-outlined">sort</span>
                    <span>Sort by Date</span>
                </button>
            </div>
        </div>

        <!-- Bố cục lưới Bento -->
        <div class="bento-grid">
            
            <!-- Thẻ "Thêm mới" theo ngữ cảnh -->
            <div class="create-card" @onclick="OpenCreateDialog">
                <div class="create-icon-circle">
                    <span class="material-symbols-outlined" style="font-size: 2.5rem; font-weight: 300;">add</span>
                </div>
                <span style="font-weight: 800; color: var(--primary); font-size: 1.1rem;">Create New Event</span>
                <p style="font-size: 0.85rem; color: rgba(37, 52, 63, 0.6); margin-top: 0.5rem; text-align: center; max-width: 200px;">
                    Schedule a meeting, workshop, or seminar
                </p>
            </div>

            @if (events != null)
            {
                @foreach (var evt in filteredEvents)
                {
                    var status = evt.StatusLabel?.ToLower() ?? "upcoming";
                    var isCompleted = status == "completed";
                    
                    var statusClass = status switch {
                        "ongoing" => "status-ongoing",
                        "upcoming" => "status-upcoming",
                        "completed" => "status-completed",
                        _ => "status-upcoming"
                    };

                    var imageUrl = status switch {
                        "ongoing" => "/images/mockimages/Messenger_creation_579B0B6A-530E-4262-BA4C-19752EAE6395.jpeg",
                        "upcoming" => "/images/mockimages/Messenger_creation_9429B1FE-35C0-4741-9B7F-227691AD73C7.jpeg",
                        _ => "/images/mockimages/Messenger_creation_EFE1EA93-20EE-4EDA-8412-6C714ED80C8C.jpeg"
                    };

                    <div class="premium-card @(isCompleted ? "event-card-completed" : "")" @onclick="() => GoToDetail(evt.Id)">
                        <div class="card-img-box">
                            <img class="card-image" src="@imageUrl" alt="@evt.Name" />
                            <div class="status-tag @statusClass">
                                @evt.StatusLabel
                            </div>
                            
                            <!-- Các hành động nội bộ (Sửa/Xóa) -->
                            <div class="card-dropdown" @onclick:stopPropagation="true">
                                <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Color="Color.Surface" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    <MudMenuItem OnClick="@(async () => await OpenUpdateDialog(evt))">Sửa</MudMenuItem>
                                    <MudMenuItem OnClick="@(async () => await DeleteEventAsync(evt))">Xóa</MudMenuItem>
                                </MudMenu>
                            </div>
                        </div>

                        <div class="card-body">
                            <h3 class="card-title">@evt.Name</h3>
                            
                            <div class="card-meta-list">
                                <div class="meta-row">
                                    <span class="material-symbols-outlined">calendar_today</span>
                                    <span>@FormatEventDate(evt)</span>
                                </div>
                                <div class="meta-row">
                                    <span class="material-symbols-outlined">location_on</span>
                                    <span>@evt.Location</span>
                                </div>
                            </div>

                            <div class="card-footer-box">
                                <div class="progress-meta">
                                    <span class="participants-count">@GetParticipantText(evt)</span>
                                    <span class="capacity-percent text-@status">@GetCapacityText(evt)</span>
                                </div>
                                <div class="progress-rail-modern">
                                    <div class="progress-fill-modern fill-@status" 
                                         style="width: @(isCompleted ? "100%" : GetProgress(evt).ToString("F0") + "%")"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Nút hành động nổi (FAB) -->
    <button class="context-fab" @onclick="OpenCreateDialog">
        <span class="material-symbols-outlined" style="font-size: 2rem;">add</span>
    </button>
</div>


@code {
    private List<EventViewModel>? events;
    private List<EventViewModel> filteredEvents = [];
    private string searchTerm = string.Empty;
    private string statusFilter = "All";
    private Guid currentOrgId;
    private bool _isOrganizationRoute;

    private string SearchTerm
    {
        get => searchTerm;
        set
        {
            if (string.Equals(searchTerm, value, StringComparison.Ordinal))
            {
                return;
            }

            searchTerm = value;
            ApplyFilters();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var currentRoute = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim('/');
        _isOrganizationRoute = currentRoute.StartsWith("/org/", StringComparison.OrdinalIgnoreCase);

        currentOrgId = await OrganizationContext.GetOrganizationIdAsync();
        await LoadEvents();
    }

    private async Task LoadEvents()
    {
        events = await EventService.GetEventsAsync(currentOrgId);
        ApplyFilters();
    }

    private void OnStatusFilterChanged(string value)
    {
        statusFilter = string.IsNullOrWhiteSpace(value) ? "All" : value;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (events is null)
        {
            filteredEvents = [];
            return;
        }

        var normalizedSearch = searchTerm.Trim();
        var today = DateOnly.FromDateTime(DateTime.Today);

        filteredEvents = events
            .Where(evt => string.IsNullOrWhiteSpace(normalizedSearch)
                || evt.Name.Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase))
            .Where(evt => statusFilter switch
            {
                "Past" => string.Equals(evt.StatusLabel, "COMPLETED", StringComparison.OrdinalIgnoreCase)
                    || evt.EndDate < today,
                "Upcoming" => !(string.Equals(evt.StatusLabel, "COMPLETED", StringComparison.OrdinalIgnoreCase)
                    || evt.EndDate < today),
                _ => true
            })
            .ToList();
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateEventDialog>("Tạo Chiến Dịch/Sự Kiện", options);
        
        if (dialog == null) return;

        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data != null)
        {
            var req = (CreateEventViewModel)result.Data;
            await EventService.CreateEventAsync(req);
            
            await LoadEvents();
            Snackbar.Add("Tạo sự kiện thành công!", Severity.Success);
            StateHasChanged();
        }
    }

    private async Task OpenUpdateDialog(EventViewModel evt)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters
        {
            ["Model"] = new UpdateEventViewModel
            {
                EventId = evt.Id,
                Name = evt.Name,
                Description = evt.Description,
                StartDate = evt.StartDate.ToDateTime(TimeOnly.MinValue),
                EndDate = evt.EndDate.ToDateTime(TimeOnly.MinValue),
                Location = evt.Location,
                TotalSlots = evt.TotalSlots
            }
        };

        var dialog = await DialogService.ShowAsync<UpdateEventDialog>("Cập nhật sự kiện", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not UpdateEventViewModel req)
        {
            return;
        }

        await EventService.UpdateEventAsync(evt.Id, req);
        await LoadEvents();
        Snackbar.Add("Cập nhật sự kiện thành công.", Severity.Success);
    }

    private async Task DeleteEventAsync(EventViewModel evt)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Xóa sự kiện '{evt.Name}'?");
        if (!confirmed)
        {
            return;
        }

        await EventService.DeleteEventAsync(evt.Id);
        await LoadEvents();
        Snackbar.Add("Đã xóa sự kiện.", Severity.Success);
    }

    private string FormatEventDate(EventViewModel evt)
    {
        if (evt.StatusLabel == "ONGOING")
            return "Today, 09:00 AM";
            
        if (evt.StartDate == DateOnly.FromDateTime(DateTime.Today))
            return "Today";
            
        return evt.StartDate.ToString("MMM dd, yyyy") + " • 02:00 PM";
    }

    private double GetProgress(EventViewModel evt)
    {
        if (evt.TotalSlots == 0) return 0;
        return ((double)evt.RegisteredCount / evt.TotalSlots) * 100;
    }

    private string GetParticipantText(EventViewModel evt) => evt.StatusLabel switch
    {
        "COMPLETED" => $"{evt.RegisteredCount} Attendees",
        "ONGOING" => $"{evt.RegisteredCount} Participants",
        _ => $"{evt.RegisteredCount} Registered"
    };

    private string GetCapacityText(EventViewModel evt) => evt.StatusLabel switch
    {
        "COMPLETED" => "Closed",
        "ONGOING" => $"{Math.Round(GetProgress(evt))}% Capacity",
        _ => $"{evt.RegisteredCount}/{evt.TotalSlots} Slots"
    };

    private void GoToDetail(Guid eventId)
    {
        const string eventsBaseRoute = "/org/events";
        NavigationManager.NavigateTo($"{eventsBaseRoute}/{eventId}");
    }
}