@page "/events"
@rendermode InteractiveServer
@using MudBlazor
@using Org.Shared.Features.Events
@using Org.Frontend.Services.Events
@inject IEventService EventService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6 events-page">

    <div class="d-flex justify-space-between align-start mb-6 flex-wrap gap-4">
        <div>
            <MudText Typo="Typo.h4" Class="fw-bold" Style="color: #0f172a; font-weight: 800; letter-spacing: -0.5px;">
                Manage Events
            </MudText>
            <MudText Typo="Typo.caption" Class="fw-bold text-muted d-flex align-center mt-1" Style="letter-spacing: 1px; font-size: 0.7rem;">
                DIRECTORY <span style="color: #94a3b8; margin: 0 6px;">&gt;</span> <span style="color: #0f172a;">ALL EVENTS</span>
            </MudText>
        </div>

        <div class="d-flex gap-3 align-center">
            <MudTextField T="string"
                          Placeholder="Search events..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="search-box" />

            <div class="mock-icon-btn">N</div>
            <div class="mock-icon-btn">?</div>
        </div>
    </div>

    <div class="d-flex justify-space-between align-center mb-8 flex-wrap gap-4">
        
        <MudToggleGroup T="string"
                        Value="@("All")"
                        SelectionMode="SelectionMode.SingleSelection"
                        Class="toggle-box"
                        Color="Color.Primary">
            <MudToggleItem Value="@("All")" Text="All Events" Class="fw-bold px-5 rounded-lg bg-white shadow-sm" Style="font-size: 0.85rem;" />
            <MudToggleItem Value="@("Upcoming")" Text="Upcoming" Class="text-muted fw-bold px-4" Style="font-size: 0.85rem;" />
            <MudToggleItem Value="@("Past")" Text="Past Events" Class="text-muted fw-bold px-4" Style="font-size: 0.85rem;" />
        </MudToggleGroup>

        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined"
                       Class="action-btn fw-bold text-dark px-4" Style="font-size: 0.85rem;">
                <span class="mr-2" style="font-size: 1.1rem; line-height: 0;">≡</span> Filter
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Class="action-btn fw-bold text-dark px-4" Style="font-size: 0.85rem;">
                <span class="mr-2" style="font-size: 1.1rem; line-height: 0;">↕</span> Sort by Date
            </MudButton>
        </div>
    </div>

    <MudGrid Spacing="4" Class="custom-grid-fallback">
        
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="create-card elevation-0" @onclick="OpenCreateDialog">
                <div class="create-icon-text">+</div>
                <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #0f172a;">
                    Create New Event
                </MudText>
                <MudText Typo="Typo.body2" Class="text-muted mt-2 text-center px-4" Style="font-size: 0.85rem; line-height: 1.5;">
                    Schedule a meeting,<br/>workshop, or seminar
                </MudText>
            </MudCard>
        </MudItem>

        @if (events != null)
        {
            @foreach (var evt in events)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Class="event-card elevation-0 cursor-pointer" @onclick="() => GoToDetail(evt.Id)">
                        
                        <div class="image-placeholder">
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Class="@($"status-chip status-{evt.Status?.ToLower()}")">
                                @evt.Status
                            </MudChip>
                        </div>

                        <MudCardContent Class="pa-5 d-flex flex-column flex-grow-1">
                            <MudText Typo="Typo.h6" Class="fw-bold event-title" Style="color: #0f172a; line-height: 1.4; font-size: 1.1rem;">
                                @evt.Title
                            </MudText>

                            <div class="event-info mb-2">
                                <span class="fw-bold text-muted mr-2" style="font-size: 0.85rem;">Date:</span>
                                <span style="font-size: 0.85rem; color: #475569; font-weight: 500;">@FormatEventDate(evt.Date)</span>
                            </div>

                            <div class="event-info mb-5">
                                <span class="fw-bold text-muted mr-2" style="font-size: 0.85rem;">Loc:</span>
                                <span style="font-size: 0.85rem; color: #475569; font-weight: 500;">@evt.Location</span>
                            </div>

                            <div class="mt-auto pt-4" style="border-top: 1px solid #f1f5f9;">
                                <div class="d-flex justify-space-between mb-2">
                                    <MudText Typo="Typo.caption" Class="fw-bold text-muted" Style="font-size: 0.75rem;">
                                        @GetParticipantText(evt)
                                    </MudText>

                                    @if (evt.TotalSlots > 0 || evt.Status == "COMPLETED")
                                    {
                                        <MudText Typo="Typo.caption" Class="fw-bold" Style="@($"font-size: 0.75rem; {GetCapacityStyle(evt)}")">
                                            @GetCapacityText(evt)
                                        </MudText>
                                    }
                                </div>

                                @if (evt.TotalSlots > 0 && evt.Status != "COMPLETED")
                                {
                                    <MudProgressLinear Value="@GetProgress(evt)"
                                                       Color="@GetProgressColor(evt.Status)"
                                                       Rounded="true"
                                                       Size="Size.Small" 
                                                       Class="mt-1" />
                                }
                                @if(evt.Status == "COMPLETED")
                                {
                                    <MudProgressLinear Value="100" Color="Color.Default" Rounded="true" Size="Size.Small" Class="mt-1 opacity-50" />
                                }
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        }
    </MudGrid>

    <MudFab Color="Color.Warning" 
            Label="+" 
            Class="fixed-fab fw-bold" 
            Style="font-size: 1.5rem;"
            DisableElevation="false" />

</MudContainer>


<style>
    /* CSS DỰ PHÒNG: Ép Grid chia cột ngay cả khi MudBlazor CSS bị lỗi */
    .custom-grid-fallback.mud-grid {
        display: flex;
        flex-wrap: wrap;
        margin: -16px;
    }
    .custom-grid-fallback .mud-grid-item {
        padding: 16px;
        width: 100%;
    }
    @@media (min-width: 600px) { .custom-grid-fallback .mud-grid-item { width: 50%; } }
    @@media (min-width: 960px) { .custom-grid-fallback .mud-grid-item { width: 33.333333%; } }
    @@media (min-width: 1280px) { .custom-grid-fallback .mud-grid-item { width: 25%; } }

    /* --- STYLES CHÍNH --- */
    .events-page {
        background: #f8fafc;
        min-height: 100vh;
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .text-muted { color: #64748b !important; }
    .text-dark { color: #0f172a !important; }
    .fw-bold { font-weight: 700 !important; }

    .search-box {
        width: 280px;
        background: white;
        border-radius: 10px;
    }

    .mock-icon-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: white;
        border: 1px solid #e2e8f0;
        color: #475569;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.9rem;
        cursor: pointer;
        box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    }

    .toggle-box {
        background: #f1f5f9;
        padding: 5px;
        border-radius: 12px;
    }

    .action-btn {
        background: white;
        border-radius: 10px;
        border: 1px solid #e2e8f0 !important;
        text-transform: none;
        box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    }

    /* Thẻ Create */
    .create-card {
        height: 100%;
        min-height: 380px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 2px dashed #cbd5e1;
        border-radius: 16px;
        background-color: transparent;
        cursor: pointer;
        transition: 0.2s;
    }
    .create-card:hover {
        border-color: #f97316;
        background-color: rgba(249, 115, 22, 0.02);
    }
    
    .create-icon-text {
        background: #fff7ed;
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: #f97316;
        font-size: 2rem;
        font-weight: 400;
        margin-bottom: 20px;
    }

    /* Thẻ Event */
    .event-card {
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05) !important;
        transition: 0.3s ease;
        height: 100%;
        min-height: 380px;
        display: flex;
        flex-direction: column;
    }
    .event-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
    }

    .image-placeholder {
        height: 170px;
        background-color: #e2e8f0;
        position: relative;
        width: 100%;
        flex-shrink: 0;
    }

    /* Status Badge */
    .status-chip {
        position: absolute;
        top: 14px;
        left: 14px;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        padding: 0 10px;
        border-radius: 6px;
    }
    .status-ongoing { background-color: #f97316 !important; color: white !important; }
    .status-upcoming { background-color: #1e293b !important; color: white !important; }
    .status-completed { background-color: #64748b !important; color: white !important; }

    .event-title {
        margin-bottom: 16px;
        min-height: 48px;
    }

    .event-info {
        display: flex;
        align-items: center;
    }

    .fixed-fab {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 100;
        box-shadow: 0 4px 14px 0 rgba(249, 115, 22, 0.39);
    }
</style>

@code {
    private List<EventDto>? events;
    private Guid currentOrgId = Guid.NewGuid(); 

    protected override async Task OnInitializedAsync()
    {
        await LoadEvents();
    }

    private async Task LoadEvents()
    {
        events = await EventService.GetEventsAsync(currentOrgId);
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateEventDialog>("Tạo Chiến Dịch/Sự Kiện", options);
        
        // Thêm dòng này để C# biết chắc chắn dialog không bị null
        if (dialog == null) return;

        var result = await dialog.Result;

        // Thêm check result != null vào cụm điều kiện này
        if (result != null && !result.Canceled && result.Data != null)
        {
            var req = (CreateEventRequest)result.Data;
            await EventService.CreateEventAsync(req);
            
            await LoadEvents();
            Snackbar.Add("Tạo sự kiện thành công!", Severity.Success);
            StateHasChanged();
        }
    }

    private string FormatEventDate(DateTime date)
    {
        if (date.Date == DateTime.Today)
            return $"Today, {date:hh:mm tt}";
        return $"{date:MMM dd, yyyy} • {date:hh:mm tt}";
    }

    private double GetProgress(EventDto evt)
    {
        if (evt.TotalSlots == 0) return 0;
        return ((double)evt.RegisteredCount / evt.TotalSlots) * 100;
    }

    private Color GetProgressColor(string? status) => status switch
    {
        "ONGOING" => Color.Warning,   
        "UPCOMING" => Color.Dark,     
        _ => Color.Default
    };

    private string GetParticipantText(EventDto evt) => evt.Status switch
    {
        "COMPLETED" => $"{evt.RegisteredCount} Attendees",
        "ONGOING" => $"{evt.RegisteredCount} Participants",
        _ => $"{evt.RegisteredCount} Registered"
    };

    private string GetCapacityText(EventDto evt) => evt.Status switch
    {
        "COMPLETED" => "Closed",
        "ONGOING" => $"{Math.Round(GetProgress(evt))}% Capacity",
        _ => $"{evt.RegisteredCount}/{evt.TotalSlots} Slots"
    };

    private string GetCapacityStyle(EventDto evt) => evt.Status switch
    {
        "ONGOING" => "color: #f97316;", 
        "COMPLETED" => "color: #94a3b8;", 
        _ => "color: #0f172a;" 
    };

    private void GoToDetail(Guid eventId)
    {
        // Chuyển hướng sang trang Event Detail với ID tương ứng
        NavigationManager.NavigateTo($"/events/{eventId}");
    }
}