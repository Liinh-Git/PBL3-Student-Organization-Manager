@using Org.Frontend.Services.Overview
@using MudBlazor

<article class="overview-card clickable" @onclick="() => OnOpen.InvokeAsync(Item.OrganizationId)">
    <div class="overview-card-head">
        <img src="@ResolveAvatar()" alt="@Item.Name" class="overview-avatar" />
        <div class="overview-card-meta">
            <h3>@Item.Name</h3>
            <p>@(string.IsNullOrWhiteSpace(Item.Role) ? "Member" : Item.Role)</p>
        </div>
    </div>
    <p class="overview-card-desc">@BuildDescription(Item.Description)</p>
    <div class="overview-card-stats">
        <span>@Item.MemberCount thanh vien</span>
        <span>@Item.EventCount su kien</span>
        <span>@Item.TaskCount task</span>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public OverviewOrganizationItem Item { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnOpen { get; set; }

    private string ResolveAvatar()
        => string.IsNullOrWhiteSpace(Item.AvatarUrl) ? "/images/mockimages/Org1/Avt.jpg" : Item.AvatarUrl;

    private static string BuildDescription(string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
            return "Chua co mo ta.";

        var text = description.Trim();
        return text.Length <= 140 ? text : $"{text[..140]}...";
    }
}
