@using Org.Frontend.Services.Overview
@using MudBlazor

<article class="overview-card event-card clickable" @onclick="() => OnOpen.InvokeAsync(Item.EventId)">
    <div class="event-card-cover">
        <img src="@ResolveImage()" alt="@Item.EventTitle" />
    </div>
    <div class="event-card-body">
        <p class="event-org">@Item.OrganizationName</p>
        <h3>@Item.EventTitle</h3>
        <div class="event-meta">
            <span><MudIcon Icon="@Icons.Material.Outlined.CalendarToday" /> @BuildDateRange()</span>
            <span><MudIcon Icon="@Icons.Material.Outlined.LocationOn" /> @BuildLocation()</span>
        </div>
        <div class="event-tags">
            @if (!string.IsNullOrWhiteSpace(Item.UserRole))
            {
                <span class="event-tag role">@Item.UserRole</span>
            }
            @if (!string.IsNullOrWhiteSpace(Item.ParticipationStatus))
            {
                <span class="event-tag status">@Item.ParticipationStatus</span>
            }
            @if (!string.IsNullOrWhiteSpace(Item.Status))
            {
                <span class="event-tag">@Item.Status</span>
            }
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public OverviewEventItem Item { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnOpen { get; set; }

    private string BuildDateRange()
    {
        var start = Item.StartDate.ToString("dd/MM/yyyy");
        var end = Item.EndDate.ToString("dd/MM/yyyy");
        return start == end ? start : $"{start} - {end}";
    }

    private string BuildLocation()
        => string.IsNullOrWhiteSpace(Item.Location) ? "Dang cap nhat" : Item.Location;

    private string ResolveImage()
        => string.IsNullOrWhiteSpace(Item.ImageUrl) ? "/images/mockimages/Org1/Card1.jpg" : Item.ImageUrl;
}
