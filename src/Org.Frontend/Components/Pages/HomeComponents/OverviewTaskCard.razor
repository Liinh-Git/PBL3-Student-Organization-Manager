@using Org.Frontend.Services.Overview
@using MudBlazor

<article class="overview-card task-card">
    <div class="task-head">
        <h3>@Item.Title</h3>
        <div class="task-badges">
            <span class="task-badge">@Item.Status</span>
            @if (!string.IsNullOrWhiteSpace(Item.Priority))
            {
                <span class="task-badge priority">@Item.Priority</span>
            }
        </div>
    </div>
    <p class="task-desc">@Item.Description</p>
    <div class="task-meta">
        <span><MudIcon Icon="@Icons.Material.Outlined.Business" /> @Item.OrganizationName</span>
        <span><MudIcon Icon="@Icons.Material.Outlined.Event" /> @Item.EventName</span>
        <span><MudIcon Icon="@Icons.Material.Outlined.Flag" /> @Item.MilestoneName</span>
        <span><MudIcon Icon="@Icons.Material.Outlined.Category" /> @Item.CategoryName</span>
        <span><MudIcon Icon="@Icons.Material.Outlined.Groups" /> @BuildDepartment()</span>
        <span><MudIcon Icon="@Icons.Material.Outlined.Schedule" /> @BuildDeadline()</span>
    </div>
    <div class="task-co-assignees">
        @if (Item.CoAssignees.Count == 0)
        {
            <p>Khong co cong tac vien.</p>
        }
        else
        {
            @foreach (var assignee in Item.CoAssignees)
            {
                <div class="assignee-chip">
                    <img src="@ResolveAvatar(assignee.AvatarUrl)" alt="@assignee.DisplayName" />
                    <div>
                        <strong>@assignee.DisplayName</strong>
                        <span>@(string.IsNullOrWhiteSpace(assignee.Role) ? "Member" : assignee.Role)</span>
                    </div>
                </div>
            }
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public OverviewTaskItem Item { get; set; } = default!;

    private string BuildDepartment()
        => string.IsNullOrWhiteSpace(Item.DepartmentName) ? "Chua gan bo phan" : Item.DepartmentName;

    private string BuildDeadline()
    {
        if (!Item.DeadlineUtc.HasValue)
            return "Chua co han";

        return Item.DeadlineUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    }

    private static string ResolveAvatar(string? avatarUrl)
        => string.IsNullOrWhiteSpace(avatarUrl) ? "/images/avatars/user.png" : avatarUrl;
}
