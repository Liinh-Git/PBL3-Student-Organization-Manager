@page "/home"
@inject IUserDashboardService DashboardService
@inject NavigationManager Navigation
@using Org.Frontend.Services.Dashboard
@using Org.Frontend.ViewModels
@using System.Globalization

<PageTitle>Hoạt động của tôi</PageTitle>

<div class="home-shell">
    @if (_isLoading)
    {
        <section class="dashboard-state">
            <h1>Đang tải dữ liệu</h1>
            <p>Xin vui lòng chờ trong giây lát...</p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="dashboard-state error">
            <h1>Không tải được dữ liệu</h1>
            <p>@_errorMessage</p>
            <button type="button" class="state-button" @onclick="ReloadAsync">Thử lại</button>
        </section>
    }
    else if (_dashboard is not null)
    {
        @* ---- SECTION: HOẠT ĐỘNG CỦA TÔI ---- *@
        <div class="page-header">
            <h1>Hoạt động của tôi</h1>
            <p>Tổng quan các sự kiện và câu lạc bộ đang tham gia.</p>
        </div>

        <div class="activities-grid">
            @* Cột 1: Sự kiện đã ghi danh *@
            <div class="activity-column">
                <div class="column-head">
                    <h2>Sự kiện đã ghi danh</h2>
                    <button class="text-link" @onclick="OpenMyEvents">Xem tất cả</button>
                </div>
                <div class="mini-card-list">
                    @if (MyRegisteredEventItems.Count == 0)
                    {
                        <div class="empty-block"><p>Bạn chưa đăng ký sự kiện nào.</p></div>
                    }
                    else
                    {
                        @foreach (var item in MyRegisteredEventItems)
                        {
                            <article class="mini-event-card clickable" @onclick="() => OpenEventDetail(item.EventId)">
                                <div class="mini-event-img">
                                    <img src="@ResolveImage(item.ImageUrl, DefaultEventImageUrl)" alt="@item.Name" />
                                </div>
                                <div class="mini-event-info">
                                    <span class="mini-pill">@BuildEventTypeLabel(item.Name)</span>
                                    <h4>@item.Name</h4>
                                    <div class="mini-meta">
                                        <span><MudIcon Icon="@Icons.Material.Outlined.Schedule" /> @FormatEventTimeOnly(item.StartDate)</span>
                                        <span><MudIcon Icon="@Icons.Material.Outlined.LocationOn" /> @ResolveLocationShort(item.Location)</span>
                                    </div>
                                </div>
                            </article>
                        }
                    }
                </div>
            </div>

            @* Cột 2: Câu lạc bộ của tôi *@
            <div class="activity-column">
                <div class="column-head">
                    <h2>Câu lạc bộ của tôi</h2>
                    <button class="text-link" @onclick="OpenMyOrganizations">Quản lý</button>
                </div>
                <div class="mini-card-list">
                    @if (MyOrganizationItems.Count == 0)
                    {
                        <div class="empty-block"><p>Bạn chưa tham gia câu lạc bộ nào.</p></div>
                    }
                    else
                    {
                        @foreach (var org in MyOrganizationItems)
                        {
                            <article class="mini-org-card clickable" @onclick="() => OpenOrganizationDetail(org.OrganizationId)">
                                <div class="mini-org-avatar">
                                    <img src="@ResolveImage(org.AvatarUrl, DefaultOrganizationImageUrl)" alt="@org.Name" />
                                </div>
                                <div class="mini-org-info">
                                    <h4>@org.Name</h4>
                                    <p>@org.Role</p>
                                </div>
                                <div class="mini-action-icon">
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
                                </div>
                            </article>
                        }
                    }
                </div>
            </div>
        </div>

        @* ---- SECTION: KHÁM PHÁ ---- *@
        <div class="page-header mt-4">
            <h1>Khám phá</h1>
            <p>Cơ hội mới để phát triển kỹ năng và mở rộng mạng lưới.</p>
        </div>

        @* Tổ chức đề xuất *@
        <div class="discover-panel">
            <div class="discover-head">
                <h3>Tổ chức đề xuất</h3>
                <div class="pager">
                    <button class="pager-btn" @onclick="PreviousOrganizationPage" disabled="@(!CanGoPreviousOrganizations)"><MudIcon Icon="@Icons.Material.Filled.ChevronLeft" /></button>
                    <span class="pager-text">@OrganizationPageDisplay/@OrganizationPageCount</span>
                    <button class="pager-btn" @onclick="NextOrganizationPage" disabled="@(!CanGoNextOrganizations)"><MudIcon Icon="@Icons.Material.Filled.ChevronRight" /></button>
                </div>
            </div>

            <div class="discover-grid">
                @foreach (var org in OrganizationDiscoverItems)
                {
                    <article class="discover-card org-discover-card">
                        <div class="card-cover">
                            <img src="@ResolveImage(org.ImageUrl, DefaultOrganizationImageUrl)" alt="Cover" />
                            <div class="floating-avatar">
                                <img src="@ResolveImage(org.ImageUrl, DefaultOrganizationImageUrl)" alt="@org.Name" />
                            </div>
                        </div>
                        <div class="card-body">
                            <span class="kicker">CÂU LẠC BỘ</span>
                            <h4>@org.Name</h4>
                            <p class="desc">@BuildDescription(org.Description, 80)</p>
                            <div class="card-footer">
                                <div class="member-bubbles">
                                    @foreach (var bubble in BuildMemberBubbles(org.Name, org.MemberCount))
                                    {
                                        <span>@bubble</span>
                                    }
                                </div>
                                <button class="btn-dark" @onclick="() => OpenOrganizationDetail(org.OrganizationId)">Xem chi tiết</button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>

        @* Sự kiện đề xuất *@
        <div class="discover-panel mt-2">
            <div class="discover-head">
                <h3>Sự kiện đề xuất</h3>
                <div class="pager">
                    <button class="pager-btn" @onclick="PreviousEventPage" disabled="@(!CanGoPreviousEvents)"><MudIcon Icon="@Icons.Material.Filled.ChevronLeft" /></button>
                    <span class="pager-text">@EventPageDisplay/@EventPageCount</span>
                    <button class="pager-btn" @onclick="NextEventPage" disabled="@(!CanGoNextEvents)"><MudIcon Icon="@Icons.Material.Filled.ChevronRight" /></button>
                </div>
            </div>

            <div class="discover-grid">
                @foreach (var item in EventDiscoverItems)
                {
                    <article class="discover-card event-discover-card">
                        <div class="card-cover">
                            <img src="@ResolveImage(item.ImageUrl, DefaultEventImageUrl)" alt="@item.Name" />
                            <span class="tag-orange">@BuildEventTypeLabel(item.Name)</span>
                            <div class="overlay-title">
                                <h4>@item.Name</h4>
                            </div>
                        </div>
                        <div class="card-body">
                            <ul class="meta-list">
                                <li><MudIcon Icon="@Icons.Material.Outlined.CalendarToday" /> @FormatEventDate(item.StartDate)</li>
                                <li><MudIcon Icon="@Icons.Material.Outlined.Schedule" /> @FormatEventTimeRange(item.StartDate, item.EndDate)</li>
                                <li><MudIcon Icon="@Icons.Material.Outlined.LocationOn" /> @ResolveLocation(item.Location)</li>
                            </ul>
                            <button class="btn-outline-full" @onclick="() => OpenEventDetail(item.EventId)">Xem chi tiết</button>
                        </div>
                    </article>
                }
            </div>
        </div>
    }
</div>

@code {
    private const int DiscoverPageSize = 3;
    private const string DefaultOrganizationImageUrl = "/images/mockimages/1773043475804.png";
    private const string DefaultEventImageUrl = "/images/mockimages/IMG_20260301_060428.jpg";

    private UserDashboardViewModel? _dashboard;
    private bool _isLoading = true;
    private string? _errorMessage;

    private int _organizationPageIndex;
    private int _eventPageIndex;

    private IReadOnlyList<UserOrganizationViewModel> MyOrganizationItems =>
        _dashboard != null ? _dashboard.Organizations.Take(2).ToList() : Array.Empty<UserOrganizationViewModel>();

    private IReadOnlyList<UserRegisteredEventViewModel> MyRegisteredEventItems =>
        _dashboard != null ? _dashboard.RegisteredEvents.Take(2).ToList() : Array.Empty<UserRegisteredEventViewModel>();

    private int OrganizationPageCount => GetPageCount(AvailableSuggestedOrganizations.Count);
    private int EventPageCount => GetPageCount(_dashboard?.SuggestedEvents.Count ?? 0);

    private int OrganizationPageDisplay => Math.Min(_organizationPageIndex + 1, OrganizationPageCount);
    private int EventPageDisplay => Math.Min(_eventPageIndex + 1, EventPageCount);

    private bool CanGoPreviousOrganizations => _organizationPageIndex > 0;
    private bool CanGoNextOrganizations => _organizationPageIndex < OrganizationPageCount - 1;

    private bool CanGoPreviousEvents => _eventPageIndex > 0;
    private bool CanGoNextEvents => _eventPageIndex < EventPageCount - 1;

    private IReadOnlyList<SuggestedOrganizationViewModel> OrganizationDiscoverItems =>
        AvailableSuggestedOrganizations.Skip(_organizationPageIndex * DiscoverPageSize).Take(DiscoverPageSize).ToList();

    private IReadOnlyList<SuggestedOrganizationViewModel> AvailableSuggestedOrganizations
    {
        get
        {
            if (_dashboard is null) return Array.Empty<SuggestedOrganizationViewModel>();
            var joinedIds = _dashboard.Organizations.Select(x => x.OrganizationId).ToHashSet();
            return _dashboard.SuggestedOrganizations.Where(x => !joinedIds.Contains(x.OrganizationId)).ToList();
        }
    }

    private IReadOnlyList<SuggestedEventViewModel> EventDiscoverItems =>
        _dashboard != null ? _dashboard.SuggestedEvents.Skip(_eventPageIndex * DiscoverPageSize).Take(DiscoverPageSize).ToList() : Array.Empty<SuggestedEventViewModel>();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _isLoading = true; _errorMessage = null;
        try
        {
            _dashboard = await DashboardService.GetDashboardAsync();
            _organizationPageIndex = 0; _eventPageIndex = 0;
        }
        catch { _errorMessage = "Hệ thống tạm thời không tải được dữ liệu dashboard. Vui lòng thử lại."; }
        finally { _isLoading = false; }
    }

    private void PreviousOrganizationPage() { if (CanGoPreviousOrganizations) _organizationPageIndex--; }
    private void NextOrganizationPage() { if (CanGoNextOrganizations) _organizationPageIndex++; }
    private void PreviousEventPage() { if (CanGoPreviousEvents) _eventPageIndex--; }
    private void NextEventPage() { if (CanGoNextEvents) _eventPageIndex++; }

    private void OpenMyOrganizations() => Navigation.NavigateTo("/user/organizations");
    private void OpenMyEvents() => Navigation.NavigateTo("/user/events");
    private void OpenOrganizationDetail(Guid id) => Navigation.NavigateTo($"/org-overview?orgId={id}");
    private void OpenEventDetail(Guid id) => Navigation.NavigateTo($"/events/{id}");

    private static int GetPageCount(int total) => total <= 0 ? 1 : (int)Math.Ceiling(total / (double)DiscoverPageSize);
    private static string BuildDescription(string? val, int max) => string.IsNullOrWhiteSpace(val) ? "Chưa có mô tả." : (val.Length <= max ? val : val[..max] + "...");
    private static string ResolveImage(string? url, string fallback) => string.IsNullOrWhiteSpace(url) ? fallback : url;
    private static string ResolveLocation(string? loc) => string.IsNullOrWhiteSpace(loc) ? "Đang cập nhật" : loc;
    private static string ResolveLocationShort(string? loc) => string.IsNullOrWhiteSpace(loc) ? "Đang cập nhật" : (loc.Length > 20 ? loc[..20] + "..." : loc);

    private static string BuildEventTypeLabel(string name)
    {
        var n = name?.ToLowerInvariant() ?? "";
        if (n.Contains("workshop")) return "WORKSHOP";
        if (n.Contains("summit") || n.Contains("conference") || n.Contains("hội thảo")) return "HỘI THẢO";
        return "SỰ KIỆN";
    }

    private static string FormatEventDate(DateOnly date) => date.ToString("'Thứ' (ddd), dd 'Tháng' MM, yyyy", new CultureInfo("vi-VN")).Replace("(T", "T");
    private static string FormatEventTimeOnly(DateOnly date) => "08:00"; 
    private static string FormatEventTimeRange(DateOnly start, DateOnly end) => "08:00 - 11:30"; 
    
    private static IReadOnlyList<string> BuildMemberBubbles(string? name, int count)
    {
        var initials = string.IsNullOrWhiteSpace(name) ? "CL" : string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(x => x[0])).ToUpper();
        initials = initials.Length > 2 ? initials[..2] : initials;
        return [initials, "", $"+{Math.Max(1, count)}"];
    }
}