@page "/home"
@inject NavigationManager Navigation

<PageTitle>Overview</PageTitle>

<div class="home-shell app-page">
    <section class="app-error">
        <h2>Tong quan live API chua san sang</h2>
        <p>Trang nay tam thoi duoc an khoi demo live de tranh loi runtime.</p>
        <button type="button" class="app-button app-button--primary" @onclick="GoToOrganizations">
            Mo to chuc cua toi
        </button>
    </section>
</div>

@code {
    private void GoToOrganizations()
        => Navigation.NavigateTo("/user/organizations");
}
