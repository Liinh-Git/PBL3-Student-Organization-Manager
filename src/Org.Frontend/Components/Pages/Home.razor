@page "/home"
@inject IUserDashboardService DashboardService
@inject NavigationManager Navigation
@using Org.Frontend.Services.Dashboard
@using Org.Frontend.ViewModels

<PageTitle>User dashboard</PageTitle>

<div class="home-shell">
    @if (_isLoading)
    {
        <section class="dashboard-state">
            <h1>Dang tai dashboard</h1>
            <p>Du lieu trang ca nhan dang duoc dong bo.</p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="dashboard-state error">
            <h1>Khong tai duoc dashboard</h1>
            <p>@_errorMessage</p>
            <button type="button" class="state-button" @onclick="ReloadAsync">Thu lai</button>
        </section>
    }
    else if (_dashboard is not null)
    {
        <section class="welcome-banner">
            <div class="welcome-copy">
                <p class="welcome-kicker">TRANG TONG QUAN NGUOI DUNG</p>
                <h1>Chao @_dashboard.DisplayName</h1>
                <p class="welcome-sub">
                    Theo doi cau lac bo ban dang tham gia, su kien ban da dang ky va cac goi y moi trong cung mot man hinh.
                </p>

                <div class="quick-actions">
                    <button type="button" class="quick-button primary" @onclick="OpenMyOrganizations">Cau lac bo cua toi</button>
                    <button type="button" class="quick-button" @onclick="OpenMyEvents">Su kien cua toi</button>
                    <button type="button" class="quick-button ghost" @onclick="OpenSettings">Cai dat</button>
                </div>
            </div>

            <div class="welcome-stats">
                <article class="stat-card">
                    <p>CLB da tham gia</p>
                    <strong>@OrganizationCount</strong>
                    <span>Cap nhat tu membership</span>
                </article>

                <article class="stat-card">
                    <p>Su kien da dang ky</p>
                    <strong>@RegisteredEventCount</strong>
                    <span>Lay tu attendee</span>
                </article>

                <article class="stat-card">
                    <p>Su kien sap toi</p>
                    <strong>@UpcomingEventCount</strong>
                    <span>@(_dashboard.Email ?? "Tai khoan da xac thuc")</span>
                </article>
            </div>
        </section>

        <section class="section-block">
            <header class="section-head">
                <div>
                    <h2>Hoat dong cua toi</h2>
                    <p>Xem nhanh nhung muc ban hay truy cap nhat.</p>
                </div>
                <div class="section-head-actions">
                    <button type="button" class="head-action" @onclick="OpenMyOrganizations">Trang CLB</button>
                    <button type="button" class="head-action" @onclick="OpenMyEvents">Trang su kien</button>
                </div>
            </header>

            <div class="activity-tabs" role="tablist" aria-label="My activities">
                <button type="button"
                        class="@GetMyTabClass(MyTabOrganizations)"
                        role="tab"
                        aria-selected="@(_selectedMyTab == MyTabOrganizations)"
                        @onclick="() => SelectMyTab(MyTabOrganizations)">
                    Cau lac bo cua toi (@OrganizationCount)
                </button>
                <button type="button"
                        class="@GetMyTabClass(MyTabEvents)"
                        role="tab"
                        aria-selected="@(_selectedMyTab == MyTabEvents)"
                        @onclick="() => SelectMyTab(MyTabEvents)">
                    Su kien cua toi (@RegisteredEventCount)
                </button>
            </div>

            @if (_selectedMyTab == MyTabOrganizations)
            {
                @if (MyOrganizationItems.Count == 0)
                {
                    <div class="empty-block">
                        <p>Ban chua tham gia cau lac bo nao. Hay kham pha de bat dau.</p>
                    </div>
                }
                else
                {
                    <div class="my-grid organizations-grid">
                        @foreach (var org in MyOrganizationItems)
                        {
                            <article class="my-card organization-card">
                                <div class="card-media">
                                    <img src="@ResolveImage(org.AvatarUrl, DefaultOrganizationImageUrl)" alt="@org.Name" />
                                </div>

                                <div class="card-body">
                                    <div class="card-top-row">
                                        <span class="soft-pill">@org.Role</span>
                                        <span class="meta-text">Tham gia @org.JoinedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <h3>@org.Name</h3>
                                    <p>@BuildDescription(org.Description, 120)</p>
                                    <button type="button" class="inline-link" @onclick="() => OpenOrganizationDetail(org.OrganizationId)">Mo chi tiet</button>
                                </div>
                            </article>
                        }
                    </div>
                }
            }
            else
            {
                @if (MyRegisteredEventItems.Count == 0)
                {
                    <div class="empty-block">
                        <p>Ban chua dang ky su kien nao.</p>
                    </div>
                }
                else
                {
                    <div class="my-grid events-grid">
                        @foreach (var item in MyRegisteredEventItems)
                        {
                            <article class="my-card event-card">
                                <div class="event-media">
                                    <img src="@ResolveImage(item.ImageUrl, DefaultEventImageUrl)" alt="@item.Name" />
                                    <span class="type-chip">@BuildEventTypeLabel(item.Name)</span>
                                </div>

                                <div class="card-body">
                                    <p class="event-org">@item.OrganizationName</p>
                                    <h3>@item.Name</h3>
                                    <p>@BuildDescription(item.Description, 120)</p>

                                    <div class="meta-row">
                                        <span>@ResolveLocation(item.Location)</span>
                                        <span>@FormatDateRange(item.StartDate, item.EndDate)</span>
                                    </div>

                                    <div class="badge-row">
                                        <span class="badge event-status @GetEventStatusClass(item.EventStatus)">@GetEventStatusLabel(item.EventStatus)</span>
                                        <span class="badge registration-status @GetRegistrationClass(item.RegistrationStatus)">@GetRegistrationLabel(item.RegistrationStatus)</span>
                                    </div>

                                    <button type="button" class="inline-link" @onclick="() => OpenEventDetail(item.EventId)">Xem chi tiet</button>
                                </div>
                            </article>
                        }
                    </div>
                }
            }
        </section>

        <section class="section-block discover-section">
            <header class="section-head">
                <div>
                    <h2>Kham pha</h2>
                    <p>Goi y cau lac bo va su kien co the phu hop voi ban.</p>
                </div>
            </header>

            <div class="discover-panel">
                <div class="discover-head">
                    <div>
                        <h3>Cau lac bo de xuat</h3>
                        <p>Lua chon cac CLB chua tham gia va dang hoat dong.</p>
                    </div>
                    <div class="pager" aria-label="Suggested organizations pager">
                        <button type="button" class="pager-button" @onclick="PreviousOrganizationPage" disabled="@(!CanGoPreviousOrganizations)">&#10094;</button>
                        <span>@OrganizationPageDisplay/@OrganizationPageCount</span>
                        <button type="button" class="pager-button" @onclick="NextOrganizationPage" disabled="@(!CanGoNextOrganizations)">&#10095;</button>
                    </div>
                </div>

                @if (OrganizationDiscoverItems.Count == 0)
                {
                    <div class="empty-block">
                        <p>Khong co CLB de xuat trong luc nay.</p>
                    </div>
                }
                else
                {
                    <div class="discover-grid">
                        @foreach (var organization in OrganizationDiscoverItems)
                        {
                            <article class="discover-card organization-discover-card">
                                <div class="discover-media">
                                    <img src="@ResolveImage(organization.ImageUrl, DefaultOrganizationImageUrl)" alt="@organization.Name" />
                                    <span class="state-pill @GetOrganizationStateClass(organization.IsActive)">@GetOrganizationStateLabel(organization.IsActive)</span>
                                </div>

                                <div class="discover-body">
                                    <p class="discover-kicker">Cau lac bo</p>
                                    <h4>@organization.Name</h4>
                                    <p>@BuildDescription(organization.Description, 105)</p>

                                    <div class="tiny-meta">
                                        <span>@ResolveLocation(organization.Location)</span>
                                        <span>@organization.MemberCount thanh vien</span>
                                    </div>

                                    <div class="discover-actions">
                                        <div class="member-bubbles" aria-hidden="true">
                                            @foreach (var bubble in BuildMemberBubbles(organization.Name, organization.MemberCount))
                                            {
                                                <span>@bubble</span>
                                            }
                                        </div>
                                        <button type="button" class="solid-action" @onclick="() => OpenOrganizationDetail(organization.OrganizationId)">Xem chi tiet</button>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>

            <div class="discover-panel">
                <div class="discover-head">
                    <div>
                        <h3>Su kien de xuat</h3>
                        <p>Nhung su kien sap toi ma ban chua dang ky.</p>
                    </div>
                    <div class="pager" aria-label="Suggested events pager">
                        <button type="button" class="pager-button" @onclick="PreviousEventPage" disabled="@(!CanGoPreviousEvents)">&#10094;</button>
                        <span>@EventPageDisplay/@EventPageCount</span>
                        <button type="button" class="pager-button" @onclick="NextEventPage" disabled="@(!CanGoNextEvents)">&#10095;</button>
                    </div>
                </div>

                @if (EventDiscoverItems.Count == 0)
                {
                    <div class="empty-block">
                        <p>Khong co su kien de xuat trong luc nay.</p>
                    </div>
                }
                else
                {
                    <div class="discover-grid">
                        @foreach (var item in EventDiscoverItems)
                        {
                            <article class="discover-card event-discover-card">
                                <div class="discover-media">
                                    <img src="@ResolveImage(item.ImageUrl, DefaultEventImageUrl)" alt="@item.Name" />
                                    <span class="countdown-pill">@BuildEventTypeLabel(item.Name)</span>
                                </div>

                                <div class="discover-body">
                                    <h4>@item.Name</h4>
                                    <p class="event-org">@item.OrganizationName</p>

                                    <div class="event-meta-list">
                                        <div class="event-meta-item">
                                            <span class="material-symbols-outlined">calendar_month</span>
                                            <span>@FormatEventDate(item.StartDate)</span>
                                        </div>
                                        <div class="event-meta-item">
                                            <span class="material-symbols-outlined">schedule</span>
                                            <span>@FormatEventTimeRange(item.StartDate, item.EndDate)</span>
                                        </div>
                                        <div class="event-meta-item">
                                            <span class="material-symbols-outlined">location_on</span>
                                            <span>@ResolveLocation(item.Location)</span>
                                        </div>
                                    </div>

                                    <div class="discover-actions">
                                        <span class="attendee-count">@item.RegisteredCount da dang ky</span>
                                        <button type="button" class="soft-action" @onclick="() => OpenEventDetail(item.EventId)">Xem chi tiet</button>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>

@* ---- Modal đăng ký tham gia CLB ---- *@
@if (_showJoinModal)
{
    <Org.Frontend.Components.Pages.Organizations.JoinOrganizationModal
        OrganizationId="@_joinModalOrgId"
        OrganizationName="@_joinModalOrgName"
        OnClose="CloseJoinModal"
        OnSubmitted="OnJoinSubmitted" />
}

@code {
    private const int DiscoverPageSize = 3;
    private const string MyTabOrganizations = "organizations";
    private const string MyTabEvents = "events";
    private const string DefaultOrganizationImageUrl = "/images/mockimages/Org1/Avt.jpg";
    private const string DefaultEventImageUrl = "/images/mockimages/Org1/Card1.jpg";

    private UserDashboardViewModel? _dashboard;
    private bool _isLoading = true;
    private string? _errorMessage;
    private string _selectedMyTab = MyTabOrganizations;
    private int _organizationPageIndex;
    private int _eventPageIndex;

    // ---- Join modal state ----
    private bool _showJoinModal;
    private Guid _joinModalOrgId;
    private string _joinModalOrgName = "";

    private int OrganizationCount => _dashboard?.Organizations.Count ?? 0;

    private int RegisteredEventCount => _dashboard?.RegisteredEvents.Count ?? 0;

    private int UpcomingEventCount => _dashboard?.RegisteredEvents.Count(x =>
        x.StartDate >= DateOnly.FromDateTime(DateTime.Today)
        && !string.Equals(x.EventStatus, "COMPLETED", StringComparison.OrdinalIgnoreCase)) ?? 0;

    private IReadOnlyList<UserOrganizationViewModel> MyOrganizationItems =>
        _dashboard is null
            ? Array.Empty<UserOrganizationViewModel>()
            : _dashboard.Organizations.Take(4).ToList();

    private IReadOnlyList<UserRegisteredEventViewModel> MyRegisteredEventItems =>
        _dashboard is null
            ? Array.Empty<UserRegisteredEventViewModel>()
            : _dashboard.RegisteredEvents.Take(4).ToList();

    private int OrganizationPageCount => GetPageCount(AvailableSuggestedOrganizations.Count);

    private int EventPageCount => GetPageCount(_dashboard?.SuggestedEvents.Count ?? 0);

    private int OrganizationPageDisplay => Math.Min(_organizationPageIndex + 1, OrganizationPageCount);

    private int EventPageDisplay => Math.Min(_eventPageIndex + 1, EventPageCount);

    private bool CanGoPreviousOrganizations => _organizationPageIndex > 0;

    private bool CanGoNextOrganizations => _organizationPageIndex < OrganizationPageCount - 1;

    private bool CanGoPreviousEvents => _eventPageIndex > 0;

    private bool CanGoNextEvents => _eventPageIndex < EventPageCount - 1;

    private IReadOnlyList<SuggestedOrganizationViewModel> OrganizationDiscoverItems
    {
        get
        {
            if (AvailableSuggestedOrganizations.Count == 0)
                return Array.Empty<SuggestedOrganizationViewModel>();

            return AvailableSuggestedOrganizations
                .Skip(_organizationPageIndex * DiscoverPageSize)
                .Take(DiscoverPageSize)
                .ToList();
        }
    }

    private IReadOnlyList<SuggestedOrganizationViewModel> AvailableSuggestedOrganizations
    {
        get
        {
            if (_dashboard is null || _dashboard.SuggestedOrganizations.Count == 0)
            {
                return Array.Empty<SuggestedOrganizationViewModel>();
            }

            var joinedOrganizationIds = _dashboard.Organizations
                .Select(x => x.OrganizationId)
                .ToHashSet();

            return _dashboard.SuggestedOrganizations
                .Where(x => !joinedOrganizationIds.Contains(x.OrganizationId))
                .ToList();
        }
    }

    private IReadOnlyList<SuggestedEventViewModel> EventDiscoverItems
    {
        get
        {
            if (_dashboard is null || _dashboard.SuggestedEvents.Count == 0)
                return Array.Empty<SuggestedEventViewModel>();

            return _dashboard.SuggestedEvents
                .Skip(_eventPageIndex * DiscoverPageSize)
                .Take(DiscoverPageSize)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _dashboard = await DashboardService.GetDashboardAsync();
            _selectedMyTab = MyTabOrganizations;
            _organizationPageIndex = 0;
            _eventPageIndex = 0;
        }
        catch
        {
            _dashboard = null;
            _errorMessage = "He thong tam thoi khong tai duoc du lieu dashboard. Vui long thu lai.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectMyTab(string tab)
    {
        _selectedMyTab = tab;
    }

    private void PreviousOrganizationPage()
    {
        if (!CanGoPreviousOrganizations)
            return;

        _organizationPageIndex--;
    }

    private void NextOrganizationPage()
    {
        if (!CanGoNextOrganizations)
            return;

        _organizationPageIndex++;
    }

    private void PreviousEventPage()
    {
        if (!CanGoPreviousEvents)
            return;

        _eventPageIndex--;
    }

    private void NextEventPage()
    {
        if (!CanGoNextEvents)
            return;

        _eventPageIndex++;
    }

    private void OpenMyOrganizations() => Navigation.NavigateTo("/user/organizations");

    private void OpenMyEvents() => Navigation.NavigateTo("/user/events");

    private void OpenSettings() => Navigation.NavigateTo("/user/settings");

    private void OpenOrganizationDetail(Guid organizationId)
        => Navigation.NavigateTo($"/org-overview?orgId={organizationId}");

    private void OpenEventDetail(Guid eventId)
        => Navigation.NavigateTo($"/events/{eventId}");

    private void OpenJoinModal(Guid orgId, string orgName)
    {
        _joinModalOrgId = orgId;
        _joinModalOrgName = orgName;
        _showJoinModal = true;
    }

    private void CloseJoinModal()
    {
        _showJoinModal = false;
    }

    private async Task OnJoinSubmitted()
    {
        // Reload dashboard để cập nhật suggested orgs
        await ReloadAsync();
    }

    private string GetMyTabClass(string tab)
        => _selectedMyTab == tab ? "tab-button active" : "tab-button";

    private static int GetPageCount(int totalItems)
    {
        if (totalItems <= 0)
            return 1;

        return (int)Math.Ceiling(totalItems / (double)DiscoverPageSize);
    }

    private static string BuildDescription(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Chua co mo ta.";

        var normalized = value.Trim();
        if (normalized.Length <= maxLength)
            return normalized;

        return normalized[..maxLength].TrimEnd() + "...";
    }

    private static string ResolveImage(string? imageUrl, string fallback)
        => string.IsNullOrWhiteSpace(imageUrl) ? fallback : imageUrl;

    private static string ResolveLocation(string? location)
        => string.IsNullOrWhiteSpace(location) ? "Dia diem se cap nhat" : location;

    private static string FormatDateRange(DateOnly startDate, DateOnly endDate)
        => $"{startDate:dd/MM} - {endDate:dd/MM/yyyy}";

    private static string BuildCountdownLabel(DateOnly startDate)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var days = startDate.DayNumber - today.DayNumber;

        if (days <= 0)
            return "Dang dien ra";

        if (days == 1)
            return "Con 1 ngay";

        if (days < 7)
            return $"Con {days} ngay";

        var weeks = (int)Math.Ceiling(days / 7d);
        return $"Con {weeks} tuan";
    }

    private static string BuildEventTypeLabel(string eventName)
    {
        if (string.IsNullOrWhiteSpace(eventName))
            return "Su kien";

        var normalized = eventName.Trim().ToLowerInvariant();

        if (normalized.Contains("workshop", StringComparison.Ordinal))
            return "Workshop";

        if (normalized.Contains("summit", StringComparison.Ordinal) || normalized.Contains("conference", StringComparison.Ordinal))
            return "Hoi thao";

        if (normalized.Contains("festival", StringComparison.Ordinal) || normalized.Contains("show", StringComparison.Ordinal))
            return "Festival";

        return "Su kien";
    }

    private static string FormatEventDate(DateOnly date)
        => date.ToDateTime(TimeOnly.MinValue).ToString("dddd, dd 'thang' MM, yyyy", new CultureInfo("vi-VN"));

    private static string FormatEventTimeRange(DateOnly startDate, DateOnly endDate)
        => startDate == endDate ? "08:00 - 18:00" : "Ca ngay";

    private static IReadOnlyList<string> BuildMemberBubbles(string? organizationName, int memberCount)
    {
        var first = string.IsNullOrWhiteSpace(organizationName) ? "CL" : BuildInitials(organizationName);
        var second = $"+{Math.Max(1, memberCount / 8)}";
        return [first, "..", second];
    }

    private static string BuildInitials(string input)
    {
        var parts = input.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
            return "CL";

        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpperInvariant();

        return string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }

    private static string GetOrganizationStateClass(bool isActive)
        => isActive ? "active" : "inactive";

    private static string GetOrganizationStateLabel(bool isActive)
        => isActive ? "Dang mo" : "Tam dung";

    private static string GetEventStatusClass(string status)
    {
        return status.Trim().ToUpperInvariant() switch
        {
            "ONGOING" => "ongoing",
            "COMPLETED" => "completed",
            "PLANNING" => "planning",
            _ => "draft"
        };
    }

    private static string GetEventStatusLabel(string status)
    {
        return status.Trim().ToUpperInvariant() switch
        {
            "ONGOING" => "Dang dien ra",
            "COMPLETED" => "Da ket thuc",
            "PLANNING" => "Dang len ke hoach",
            _ => "Ban nhap"
        };
    }

    private static string GetRegistrationClass(string status)
    {
        return status.Trim().ToUpperInvariant() switch
        {
            "ATTENDED" => "attended",
            "CANCELLED" => "cancelled",
            _ => "registered"
        };
    }

    private static string GetRegistrationLabel(string status)
    {
        return status.Trim().ToUpperInvariant() switch
        {
            "ATTENDED" => "Da tham du",
            "CANCELLED" => "Da huy",
            _ => "Da dang ky"
        };
    }
}
