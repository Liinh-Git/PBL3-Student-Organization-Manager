@using Org.Shared.Features.Tasks
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="model.Title" Label="Tên công việc" Required="true" RequiredError="Bắt buộc nhập!" Class="mb-3"/>
        <MudDatePicker @bind-Date="model.DueDate" Label="Deadline" Class="mb-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Tạo mới</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    private CreateTaskRequest model = new CreateTaskRequest();

    private void Submit() => MudDialog?.Close(DialogResult.Ok(model));
    private void Cancel() => MudDialog?.Cancel();
}