@page "/org/events/{EventId:guid}/tasks/board/{CategoryId:guid}"
@rendermode InteractiveServer
@using Org.Frontend.Services.Events
@using Org.Frontend.Services.Members
@using Org.Frontend.Services.Tasks
@using Org.Frontend.ViewModels
@using Org.Shared.Contracts
@inject ITaskService TaskService
@inject IEventCategoryService CategoryService
@inject IEventService EventService
@inject IMemberService MemberService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="page-bg pa-6">
    <div class="d-flex justify-space-between align-start mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="mb-2">Category Detail</MudText>
            <MudText Typo="Typo.body1">@(_category?.Name ?? "Loading...")</MudText>
            <MudText Typo="Typo.caption">Manager: @(string.IsNullOrWhiteSpace(_category?.LeadName) ? "Chua gan" : _category!.LeadName)</MudText>
        </div>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack">
            Quay lai
        </MudButton>
    </div>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1">Mo ta</MudText>
        <MudText Typo="Typo.body2" Class="mt-2">@(_category?.DetailedDescription ?? _category?.Description ?? "Chua co mo ta.")</MudText>
    </MudPaper>

    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h6">Nhiem vu</MudText>
        <div class="d-flex gap-3 align-center">
            <MudToggleGroup T="bool" @bind-Value="_isKanbanMode" Outline="true" Delimiters="true" Rounded="true" Size="Size.Small">
                <MudToggleItem Value="false">List</MudToggleItem>
                <MudToggleItem Value="true">Kanban</MudToggleItem>
            </MudToggleGroup>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_canManageTasks)" OnClick="OpenCreateDialog">
                Tao task
            </MudButton>
        </div>
    </div>

    @if (_isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    }
    else if (_tasks is null || _tasks.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Category nay chua co task.</MudAlert>
    }
    else if (!_isKanbanMode)
    {
        <MudTable Items="_tasks" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>Task</MudTh>
                <MudTh>Priority</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Assignees</MudTh>
                <MudTh>Deadline</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Title</MudTd>
                <MudTd>@(context.Priority ?? "MEDIUM")</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">@context.Status</MudChip>
                </MudTd>
                <MudTd>@BuildAssigneeText(context)</MudTd>
                <MudTd>@(context.DueDate?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Disabled="@(!CanCompleteTask(context))"
                               OnClick="@(() => MarkDoneAsync(context))">
                        Mark Completed
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudDropContainer T="TaskViewModel"
                          Items="_tasks"
                          ItemsSelector="@((item, zone) => item.Status == zone)"
                          ItemDropped="TaskUpdated"
                          Class="d-flex flex-nowrap gap-4"
                          Style="overflow-x:auto; padding-bottom:16px;">
            <ChildContent>
                <div class="pa-3" style="background:#f1f5f9;border-radius:10px;min-width:320px;">
                    <MudText Typo="Typo.subtitle2">TODO</MudText>
                    <MudDropZone T="TaskViewModel" Identifier="TODO" Style="min-height:260px;" />
                </div>
                <div class="pa-3" style="background:#f1f5f9;border-radius:10px;min-width:320px;">
                    <MudText Typo="Typo.subtitle2">IN_PROGRESS</MudText>
                    <MudDropZone T="TaskViewModel" Identifier="IN_PROGRESS" Style="min-height:260px;" />
                </div>
                <div class="pa-3" style="background:#f1f5f9;border-radius:10px;min-width:320px;">
                    <MudText Typo="Typo.subtitle2">DONE</MudText>
                    <MudDropZone T="TaskViewModel" Identifier="DONE" Style="min-height:260px;" />
                </div>
            </ChildContent>
            <ItemRenderer>
                <MudPaper Class="pa-3 mb-3">
                    <MudText Typo="Typo.subtitle2">@context.Title</MudText>
                    <MudText Typo="Typo.caption">@(context.Priority ?? "MEDIUM") • @(context.DueDate?.ToString("dd/MM") ?? "-")</MudText>
                    <MudText Typo="Typo.caption" Class="d-block">@(BuildAssigneeText(context))</MudText>
                </MudPaper>
            </ItemRenderer>
        </MudDropContainer>
    }
</div>

@code {
    [Parameter] public Guid CategoryId { get; set; }
    [Parameter] public Guid EventId { get; set; }

    private List<TaskViewModel>? _tasks;
    private EventCategoryViewModel? _category;
    private List<MemberDto> _orgMembers = [];
    private bool _isKanbanMode;
    private bool _canManageTasks;
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _safeReturnUrl;
    private Guid? _orgIdFromQuery;

    protected override async Task OnInitializedAsync()
    {
        ResolveNavigationContext();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var categoryTask = CategoryService.GetCategoryDetailAsync(CategoryId);
            var tasksTask = TaskService.GetTasksAsync(CategoryId);
            var canManageTask = TaskService.CanManageTasksAsync(CategoryId);
            var eventTask = EventService.GetEventDetailAsync(EventId);

            await Task.WhenAll(categoryTask, tasksTask, canManageTask, eventTask);

            _category = categoryTask.Result;
            _tasks = tasksTask.Result;
            _canManageTasks = canManageTask.Result;
            foreach (var task in _tasks)
            {
                task.Status = NormalizeTaskStatus(task.Status);
                task.CanMarkCompleted = _canManageTasks;
            }

            var eventDetail = eventTask.Result;
            if (eventDetail is not null)
            {
                _orgMembers = await MemberService.GetMembers(eventDetail.OrganizationId);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string BuildAssigneeText(TaskViewModel task)
    {
        var count = 0;
        if (task.AssigneeMemberId.HasValue)
            count++;
        count += task.CoAssigneeMemberIds.Count;

        return count <= 1
            ? (string.IsNullOrWhiteSpace(task.AssigneeName) ? "Unassigned" : task.AssigneeName)
            : $"{count} assignees";
    }

    private static Color GetStatusColor(string status)
    {
        return status switch
        {
            "DONE" => Color.Success,
            "IN_PROGRESS" => Color.Warning,
            _ => Color.Default
        };
    }

    private bool CanCompleteTask(TaskViewModel task)
        => !string.Equals(NormalizeTaskStatus(task.Status), "DONE", StringComparison.OrdinalIgnoreCase) && task.CanMarkCompleted;

    private async Task MarkDoneAsync(TaskViewModel task)
    {
        if (!CanCompleteTask(task))
        {
            Snackbar.Add("Ban khong co quyen complete task nay.", Severity.Warning);
            return;
        }

        await TaskService.UpdateTaskStatusAsync(task.Id, new UpdateTaskStatusViewModel { Status = "DONE" });
        await ReloadTasksAsync();
    }

    private async Task TaskUpdated(MudItemDropInfo<TaskViewModel> dropItem)
    {
        if (dropItem.Item is null || string.IsNullOrWhiteSpace(dropItem.DropzoneIdentifier))
            return;

        var nextStatus = NormalizeTaskStatus(dropItem.DropzoneIdentifier);
        var currentStatus = NormalizeTaskStatus(dropItem.Item.Status);

        if (!IsLegalTransition(currentStatus, nextStatus))
        {
            Snackbar.Add("Trang thai task khong hop le theo luong TODO -> IN_PROGRESS -> DONE.", Severity.Warning);
            await ReloadTasksAsync();
            return;
        }

        if (string.Equals(nextStatus, "DONE", StringComparison.OrdinalIgnoreCase) && !CanCompleteTask(dropItem.Item))
        {
            Snackbar.Add("Chi nguoi duoc giao task (hoac manager) moi duoc danh dau hoan thanh.", Severity.Warning);
            await ReloadTasksAsync();
            return;
        }

        try
        {
            await TaskService.UpdateTaskStatusAsync(dropItem.Item.Id, new UpdateTaskStatusViewModel { Status = nextStatus });
            await ReloadTasksAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await ReloadTasksAsync();
        }
    }

    private async Task ReloadTasksAsync()
    {
        _tasks = await TaskService.GetTasksAsync(CategoryId);
        foreach (var task in _tasks)
        {
            task.Status = NormalizeTaskStatus(task.Status);
            task.CanMarkCompleted = _canManageTasks;
        }

        StateHasChanged();
    }

    private async Task OpenCreateDialog()
    {
        if (!_canManageTasks)
        {
            Snackbar.Add("Ban khong co quyen tao task trong category nay.", Severity.Warning);
            return;
        }

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters
        {
            ["Members"] = _orgMembers
                .Select(m => new CreateTaskDialog.MemberOption(m.Id, m.DisplayName))
                .ToList()
        };

        var dialog = await DialogService.ShowAsync<CreateTaskDialog>("Them task moi", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not CreateTaskViewModel req)
            return;

        await TaskService.CreateTaskAsync(CategoryId, req);
        await ReloadTasksAsync();
        Snackbar.Add("Da them task moi.", Severity.Success);
    }

    private void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(_safeReturnUrl))
        {
            NavigationManager.NavigateTo(_safeReturnUrl);
            return;
        }

        var route = $"/org/events/{EventId:D}";
        if (_orgIdFromQuery.HasValue)
        {
            route = $"{route}?orgId={_orgIdFromQuery.Value:D}";
        }

        NavigationManager.NavigateTo(route);
    }

    private void ResolveNavigationContext()
    {
        _safeReturnUrl = null;
        _orgIdFromQuery = null;

        var currentUri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(currentUri.Query);

        if (query.TryGetValue("returnUrl", out var rawReturnUrl))
        {
            var candidate = rawReturnUrl.ToString();
            if (IsSafeReturnUrl(candidate))
            {
                _safeReturnUrl = candidate;
            }
        }

        if (query.TryGetValue("orgId", out var rawOrgId) && Guid.TryParse(rawOrgId, out var orgId))
        {
            _orgIdFromQuery = orgId;
        }
    }

    private static bool IsSafeReturnUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        if (!value.StartsWith("/", StringComparison.Ordinal))
            return false;

        if (value.StartsWith("//", StringComparison.Ordinal))
            return false;

        if (value.Contains("://", StringComparison.Ordinal))
            return false;

        return true;
    }

    private static string NormalizeTaskStatus(string? status)
    {
        return status?.Trim().ToUpperInvariant() switch
        {
            "IN_PROGRESS" => "IN_PROGRESS",
            "DONE" => "DONE",
            _ => "TODO"
        };
    }

    private static bool IsLegalTransition(string currentStatus, string nextStatus)
    {
        if (string.Equals(currentStatus, nextStatus, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return (currentStatus, nextStatus) switch
        {
            ("TODO", "IN_PROGRESS") => true,
            ("IN_PROGRESS", "DONE") => true,
            _ => false
        };
    }
}
