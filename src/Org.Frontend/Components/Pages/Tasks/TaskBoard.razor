@page "/org/events/{EventId:guid}/tasks/board/{CategoryId:guid}"
@rendermode InteractiveServer
@inject ITaskService TaskService
@inject IEventCategoryService CategoryService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="task-board-container">
    @if (categoryDetail == null || _tasks == null)
    {
        <div class="d-flex align-center justify-center" style="height: 50vh;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        <!-- Header Nav -->
        <nav class="breadcrumb-nav">
            <span style="cursor:pointer" @onclick='() => NavigationManager.NavigateTo("/org/events")'>Events</span>
            <span class="material-symbols-outlined" style="font-size: 1rem;">chevron_right</span>
            <span style="cursor:pointer" @onclick='() => NavigationManager.NavigateTo($"/org/events/{EventId}")'>SỰ KIỆN CHI TIẾT</span>
            <span class="material-symbols-outlined" style="font-size: 1rem;">chevron_right</span>
            <span class="breadcrumb-active">TASK DETAIL: @categoryDetail.Name.ToUpper()</span>
        </nav>

        <!-- Hero Section -->
        <section class="hero-grid">
            <div class="hero-main">
                <div class="badge-row">
                    <span class="prio-badge">Priority: Critical</span>
                    <span class="phase-tag-badge">Phase 01-03</span>
                </div>
                <h1 class="hero-title">@categoryDetail.Name</h1>
                <p class="hero-desc">@categoryDetail.Description</p>
                
                <div class="action-row">
                    <button class="btn-modern btn-add-task" @onclick="OpenCreateDialog">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">add</span> New Task
                    </button>
                    <button class="btn-modern btn-share-task">
                        <span class="material-symbols-outlined" style="font-size: 1rem; font-variation-settings: 'FILL' 1;">share</span> Share Task
                    </button>
                    <button class="btn-modern btn-export">Export PDF</button>
                </div>
            </div>

            <div class="hero-side">
                <div class="bento-card expert-assignment-card">
                    <p class="card-title">Expert Assignment</p>
                    <div class="expert-row">
                        <img class="expert-avatar" src="/images/mockimages/FB_IMG_1744842937168.jpg" />
                        <div class="expert-info">
                            <p class="expert-name">Sarah Jenkins</p>
                            <p class="expert-role">Systems Engineer</p>
                        </div>
                        <span class="ml-auto material-symbols-outlined" style="color: var(--secondary); font-variation-settings: 'FILL' 1;">verified</span>
                    </div>
                    <div class="expert-row">
                        <img class="expert-avatar" src="/images/mockimages/FB_IMG_1744842944134.jpg" />
                        <div class="expert-info">
                            <p class="expert-name">Marcus Wong</p>
                            <p class="expert-role">Network Specialist</p>
                        </div>
                        <span class="ml-auto material-symbols-outlined" style="color: var(--on-surface-variant);">mail</span>
                    </div>
                    <button class="w-full mt-6 py-2 text-[10px] font-black uppercase tracking-[0.2em] text-center" style="color: var(--secondary); border-top: 1px solid rgba(0,0,0,0.05); padding-top: 1.5rem;">View All Contributors</button>
                </div>
            </div>
        </section>

        <!-- Phase List -->
        <div class="phase-container">
            <div class="phase-header-vibrant">
                <div>
                    <p class="phase-meta">Planning & Infrastructure</p>
                    <h2 class="phase-title-vibrant">Phase 01: Lên kế hoạch & Chuẩn bị</h2>
                </div>
                <div class="completion-stat">
                    <p class="stat-label">Completion</p>
                    <p class="stat-val">@GetCompletionPercent()%</p>
                </div>
            </div>

            <div class="table-card">
                <div style="overflow-x: auto;">
                    <table class="premium-table">
                        <thead>
                            <tr>
                                <th style="padding-left: 2rem;">Task Description</th>
                                <th>Status</th>
                                <th>Deadline</th>
                                <th>Assignee</th>
                                <th>Files</th>
                                <th>Progress</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in _tasks)
                            {
                                <tr class="task-tr">
                                    <td style="padding-left: 2rem;">
                                        <p class="task-main-title">@task.Title</p>
                                        <p class="task-sub-info">Kiểm tra và cấu hình các thông số kỹ thuật tối ưu.</p>
                                    </td>
                                    <td>
                                        <span class='v-badge @(task.Status == "DONE" ? "badge-done-v" : (task.Status == "IN_PROGRESS" ? "badge-progress-v" : "badge-queued-v"))'>
                                            @task.Status.Replace("_", " ")
                                        </span>
                                    </td>
                                    <td><span class="deadline-v">@task.DueDate?.ToString("MMM dd")</span></td>
                                    <td>
                                        <div class="d-flex align-center justify-center text-white font-black" style="width: 2rem; height: 2rem; background-color: var(--primary); border-radius: 6px; font-size: 11px;">
                                            @task.AssigneeName?[..1]
                                        </div>
                                    </td>
                                    <td><span class="material-symbols-outlined" style="color: var(--on-surface-variant); font-size: 1.5rem;">description</span></td>
                                    <td>
                                        <div class="p-rail-v">
                                            <div class="p-fill-v" style='width: @(task.Status == "DONE" ? "100%" : (task.Status == "IN_PROGRESS" ? "65%" : "0%"))'></div>
                                        </div>
                                    </td>
                                    <td><span style="font-size: 11px; font-weight: 600; color: var(--on-surface-variant);">@(task.Status == "DONE" ? "Approved by Lead" : "In Review")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid CategoryId { get; set; }
    [Parameter] public Guid EventId { get; set; }
    private List<TaskViewModel>? _tasks;
    private EventCategoryViewModel? categoryDetail;

    protected override async Task OnInitializedAsync()
    {
        var categoryDetailTask = CategoryService.GetCategoryDetailAsync(CategoryId);
        var tasksTask = TaskService.GetTasksAsync(CategoryId);

        await Task.WhenAll(categoryDetailTask, tasksTask);

        categoryDetail = await categoryDetailTask;
        _tasks = await tasksTask;
    }

    private int GetCompletionPercent()
    {
        if (_tasks == null || _tasks.Count == 0) return 0;
        var done = _tasks.Count(t => t.Status == "DONE");
        return (int)((double)done / _tasks.Count * 100);
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateTaskDialog>("Thêm Công Việc Mới", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data != null)
        {
            var req = (CreateTaskViewModel)result.Data;
            await TaskService.CreateTaskAsync(CategoryId, req);
            _tasks = await TaskService.GetTasksAsync(CategoryId);
            Snackbar.Add("Đã thêm task!", Severity.Success);
            StateHasChanged();
        }
    }
}